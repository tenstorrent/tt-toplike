[18.503535, "o", "\u001b[7;124H \u001b[8;15H \u001b[106C\u001b[38;5;21m\u001b[1m\u2192\u001b[16C\u001b[38;5;226m\u2192\u001b(B\u001b[m \u001b[46C\u001b[38;5;51m\u001b[1m\u2192\u001b[C\u001b(B\u001b[m \u001b[9;17H\u001b[38;5;93m\u001b[1m\u2192\u001b[12;92H\u001b(B\u001b[m \u001b[13;33H \u001b[C\u001b[38;5;50m\u001b[1m\u2192\u001b[58C\u001b[38;5;46m\u2192\u001b[36C\u001b(B\u001b[m \u001b[14;41H \u001b[C\u001b[38;5;190m\u001b[1m\u2192\u001b[85C\u001b[38;5;226m\u2192\u001b[16;124H\u001b[38;5;199m\u2192\u001b(B\u001b[m\u001b[38;5;37m\u2591\u001b[18;106H\u2591\u001b[24C\u2591\u001b[19;107H\u001b[38;5;208m\u001b[1m\u2192\u001b[22C\u001b[38;5;21m\u2192\u001b[23;64H\u001b(B\u001b[m\u001b[38;5;37m\u2591\u001b[38;5;154m\u001b[1m\u2192\u001b[24;56H\u001b(B\u001b[m\u001b[38;5;37m\u2591\u001b[C\u001b[38;5;50m\u001b[1m\u2192\u001b[45C\u001b(B\u001b[m\u001b[38;5;37m\u2591\u001b[36C\u2591\u001b[25;102H\u001b[38;5;21m\u001b[1m\u2192\u001b[37C\u001b[38;5;199m\u2192\u001b[26;91H\u001b[38;5;208m\u2192\u001b(B\u001b[m\u001b[38;5;37m\u2591\u001b[27;68H\u2591\u001b[11C\u2591\u001b[42C\u2591\u001b[C\u001b[38;5;190m\u001b[1m\u2192\u001b[28;65H\u001b[38;5;21m\u2192\u001b[12C\u001b[38;5;47m\u2192\u001b[61C\u001b(B\u001b[m\u001b[38;5;37m\u2591\u001b[C\u001b[38;5;45m\u001b[1m\u2192\u001b[29;88H\u001b[38;5;47m\u2190\u001b(B\u001b[m\u001b[38;5;37m\u2591\u001b[2C\u2591\u001b[27C\u001b[38;5;48m\u001b[1m\u2190\u001b[2C\u001b[38;5;200m\u2190\u001b[9C\u001b(B\u001b[m\u001b[38;5;37m\u2591\u001b[30;89H\u001b[38;5;201m\u001b[1m\u2190\u001b[41C\u001b[38;5;47m\u2190\u001b[34;106H\u001b(B\u001b[m\u001b[38;5;37m\u2591\u001b[27C\u2591\u001b[38;5;129m\u001b[1m\u2190\u001b[35;108H\u001b[38;5;93m\u2190\u001b[36;137H\u001b(B\u001b[m\u001b[38;5;37m\u2591\u001b[37;87H\u2591\u001b[24C\u2591\u001b[38;5;57m\u001b[1m\u2190\u001b[5C\u001b(B\u001b[m\u001b[38;5;37m\u2591\u001b[18C\u001b[38;5;93m\u001b[1m\u2190\u001b[38;88H\u001b[38;5;21m\u2190\u001b[23C\u001b(B\u001b[m\u001b[38;5;37m\u2591\u001b[6C\u001b[38;5;190m\u001b[1m