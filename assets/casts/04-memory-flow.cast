[18.485522, "o", "\u001b[7;124H\u001b[38;5;21m\u001b[1m\u2192\u001b[17C\u001b(B\u001b[m \u001b[48C \u001b[8;13H \u001b[C\u001b[38;5;93m\u001b[1m\u2192\u001b[124C\u001b[38;5;226m\u2192\u001b[48C\u001b[38;5;51m\u2192\u001b[12;30H\u001b(B\u001b[m \u001b[60C \u001b[38;5;46m\u001b[1m\u2192\u001b[13;33H\u001b[38;5;50m\u2192\u001b[4C\u001b(B\u001b[m \u001b[92C\u001b[38;5;226m\u001b[1m\u2192\u001b[C\u001b(B\u001b[m \u001b[14;41H\u001b[38;5;190m\u001b[1m\u2192\u001b[15;127H\u001b(B\u001b[m \u001b[16;114H\u001b[38;5;37m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[38;5;199m\u001b[1m\u2192\u001b(B\u001b[m\u001b[38;5;37m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[17;105H\u2591\u001b[8C\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[18;102H\u2591\u2591\u2591\u2591\u001b[38;5;208m\u001b[1m\u2192\u001b(B\u001b[m\u001b[38;5;37m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[6C\u001b[38;5;21m\u001b[1m\u2192\u001b[19;91H\u001b(B\u001b[m\u001b[38;5;37m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[20;91H\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[21;80H\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[22;62H\u2591\u001b[17C\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[23;55H\u2591\u001b[8C\u001b[38;5;154m\u001b[1m\u2192\u001b[3C\u001b(B\u001b[m\u001b[38;5;37m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\