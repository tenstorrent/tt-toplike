[8.194265, "o", "\u001b[8;139H \u001b[9;35H \u001b[C\u001b[38;5;51m\u001b[1m\u2192\u001b[100C\u001b[38;5;48m\u2192\u001b[17C\u001b[38;5;198m\u2192\u001b(B\u001b[m \u001b[13;56H \u001b[14;59H\u001b[38;5;154m\u001b[1m\u2192\u001b[3C\u001b(B\u001b[m \u001b[C\u001b[38;5;196m\u001b[1m\u2192\u001b[26C\u001b(B\u001b[m \u001b[56C \u001b[15;91H\u001b[38;5;208m\u001b[1m\u2192\u001b[55C\u001b[38;5;198m\u2192\u001b[16;91H\u001b(B\u001b[m\u001b[38;5;142m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[18C\u001b[38;5;136m\u2591\u001b[4C\u001b[38;5;142m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[17;91H\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[15C\u001b[38;5;48m\u001b[1m\u2192\u001b[7C\u001b(B\u001b[m\u001b[38;5;142m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[18;80H\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[23C\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[38;5;21m\u001b[1m\u2192\u001b(B\u001b[m\u001b[38;5;142m\u2591\u2591\u2591\u001b[19;68H\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[22C\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b(B\u001b[m"]
