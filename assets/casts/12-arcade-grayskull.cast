[9.17868, "o", "\u001b[2;155H\u001b[38;5;231m3\u001b[6;19H\u001b[38;5;73m∘\u001b[8C\u001b[38;5;102m∘\u001b[5C\u001b[38;5;59m∘\u001b[25C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;109m∘\u001b[8C\u001b[38;5;102m∘\u001b[28C\u001b[38;5;73m∘\u001b[8C\u001b[38;5;102m∘\u001b[5C\u001b[38;5;59m∘\u001b[17C\u001b[38;5;16m∘\u001b[19C\u001b[38;5;73m∘\u001b[8C\u001b[38;5;102m∘\u001b[5C\u001b[38;5;59m○\u001b[7;25H∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[19C\u001b[38;5;16m∘\u001b[20C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[22C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[14C\u001b[38;5;102m∘\u001b[25C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m○\u001b[3C\u001b[38;5;59m·\u001b[8;19H\u001b[38;5;103m∘\u001b[2C\u001b[38;5;59m·\u001b[6C\u001b[38;5;96m·\u001b[27C\u001b[38;5;102m∘\u001b[11C\u001b[38;5;103m∘\u001b[2C\u001b[38;5;59m·\u001b[6C\u001b[38;5;96m·\u001b[27C\u001b[38;5;103m∘\u001b[14C\u001b[38;5;59m·\u001b[5C\u001b[38;5;103m∘\u001b[31C○\u001b[5C○\u001b[9;16H\u001b[38;5;205m∘\u001b[4C\u001b[39m \u001b[49C \u001b[32C\u001b[38;5;205m∘\u001b[17C∘\u001b[38;5;102m◇\u001b[4C\u001b[38;5;73m◇\u001b[28C\u001b[38;5;205m∘\u001b[13C\u001b[38;5;109m·\u001b[10;30H\u001b[38;5;169m·\u001b[12C\u001b[38;5;188m∘\u001b[36C\u001b[38;5;169m·\u001b[38;5;145m∘\u001b[14C\u001b[38;5;188m∘\u001b[19C\u001b[38;5;145m∘\u001b[2C∘\u001b[10C\u001b[38;5;169m·\u001b[38;5;188m∘\u001b[11C∘\u001b[40C∘\u001b[8C○\u001b[5C○\u001b[11;31H∘\u001b[34C\u001b[38;5;231m∘\u001b[17C\u001b[38;5;188m∘\u001b[19C\u001b[38;5;231m∘\u001b[14C\u001b[38;5;188m∘\u001b[37C\u001b[38;5;231m○\u001b[14C\u001b[38;5;188m∘\u001b[12;10H○\u001b[15C\u001b[38;5;73m─\u001b[4C\u001b[38;5;145m∘\u001b[9C\u001b[38;5;73m─\u001b[4C\u001b[38;5;145m∘\u001b[9C\u001b[38;5;73m─\u001b[3C\u001b[38;5;188m○\u001b[5C∘\u001b[43C\u001b[38;5;145m∘\u001b[15C\u001b[38;5;169m─\u001b[4C\u001b[38;5;145m○\u001b[9C\u001b[38;5;169m─\u001b[4C\u001b[38;5;145m∘\u001b[9C\u001b[38;5;169m─\u001b[6C\u001b[38;5;145m○\u001b