[13.002332, "o", "\u001b[6;16H\u001b[38;5;16m∘\u001b[20C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[37C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[4C\u001b[38;5;16m∘\u001b[23C\u001b[38;5;60m∘\u001b[28C\u001b[38;5;16m∘\u001b[17C\u001b[38;5;59m∘\u001b[7;16H\u001b[38;5;102m∘\u001b[6C·\u001b[49C·\u001b[3C\u001b[39m \u001b[38;5;73m·\u001b[2C\u001b[38;5;103m∘\u001b[22C\u001b[38;5;102m∘\u001b[11C\u001b[38;5;103m∘\u001b[40C\u001b[38;5;102m∘\u001b[11C\u001b[38;5;103m∘\u001b[7C\u001b[39m \u001b[38;5;73m·\u001b[8;22H\u001b[38;5;103m∘\u001b[5C\u001b[38;5;205m∘\u001b[39m \u001b[42C\u001b[38;5;103m∘\u001b[5C\u001b[38;5;205m∘\u001b[39m \u001b[86C\u001b[38;5;205m∘\u001b[6C\u001b[39m \u001b[38;5;96m◇\u001b[C\u001b[39m \u001b[38;5;169m◇\u001b[9;30H\u001b[38;5;16m·\u001b[9C\u001b[38;5;145m∘\u001b[30C\u001b[38;5;102m·\u001b[8C\u001b[38;5;59m·\u001b[47C\u001b[38;5;145m∘\u001b[C\u001b[38;5;16m·\u001b[40C\u001b[38;5;102m·\u001b[7C\u001b[39m \u001b[C\u001b[38;5;145m∘\u001b[10;7H\u001b[38;5;188m∘\u001b[35C∘\u001b[13C∘\u001b[2C∘\u001b[10C\u001b[39m \u001b[3C\u001b[38;5;188m∘\u001b[38;5;73m◆\u001b[16C\u001b[38;5;188m∘\u001b[19C\u001b[38;5;231m∘\u001b[14C○\u001b[37C∘\u001b[4C\u001b[39m \u001b[38;5;16m◇\u001b[6C\u001b[38;5;102m◇\u001b[11;31H\u001b[38;5;145m∘\u001b[42C\u001b[38;5;102m◆\u001b[2C\u001b[39m \u001b[6C\u001b[38;5;145m∘\u001b[34C∘\u001b[10C\u001b[39m \u001b[38;5;16m·\u001b[40C\u001b[38;5;145m○\u001b[7C\u001b[38;5;16m·\u001b[12;21H\u001b[38;5;102m·\u001b[4C\u001b[38;5;73m─\u001b[9C\u001b[39m \u001b[4C\u001b[38;5;73m─\u001b[9C\u001b[39m \u001b[4C\u001b[38;5;73m─\u001b[38;5;145m∘\u001b[8C∘\u001b[4C\u001b[38;5;73m─\u001b[2C\u001b[39m \u001b[2C\u001b[38;5;60m◆\u001b[9C\u001b[38;5;116m∘\u001b[33C\u001b[38;5;102m·\u001b[38;5;116m∘\u001b[2C○\u001b[38;5;169m─\u001b[9C\u001b[39m \u001b[4C\u001b[38;5;169m─\u001b[9C\u001b[39m \u001b[4C\u001b[38;5;169m─\u001b[9C\u001b[38;5;145m∘\u001b[4C\u001b[38;5;169m─\u001b[3C\u001b[38;5;116m∘\u001b[3C\u