[13.75477, "o", "\u001b[6;31H\u001b[38;5;205m∘\u001b[52C∘\u001b[34C∘\u001b[52C∘\u001b[7;96H\u001b[38;5;145m∘\u001b[49C\u001b[38;5;188m∘\u001b[37C\u001b[38;5;145m∘\u001b[14C\u001b[38;5;188m∘\u001b[8;10H∘\u001b[20C\u001b[38;5;231m∘\u001b[14C\u001b[38;5;188m∘\u001b[16C∘\u001b[35C∘\u001b[19C\u001b[38;5;231m∘\u001b[14C\u001b[38;5;188m∘\u001b[52C∘\u001b[9;37H\u001b[38;5;145m∘\u001b[87C∘\u001b[10;30H\u001b[38;5;96m·\u001b[9C\u001b[38;5;116m∘\u001b[52C∘\u001b[34C∘\u001b[C\u001b[38;5;96m·\u001b[50C\u001b[38;5;116m∘\u001b[11;40H\u001b[38;5;110m∘\u001b[8C\u001b[38;5;109m∘\u001b[43C\u001b[38;5;110m∘\u001b[34C∘\u001b[8C\u001b[38;5;109m∘\u001b[8C\u001b[38;5;102m∘\u001b[34C\u001b[38;5;110m○\u001b[8C\u001b[38;5;73m∘\u001b[8C\u001b[38;5;102m∘\u001b[12;10H∘\u001b[14C\u001b[38;5;59m∘\u001b[38;5;73m─\u001b[4C\u001b[38;5;59m∘\u001b[5C\u001b[38;5;16m∘\u001b[3C\u001b[38;5;73m─\u001b[4C\u001b[38;5;16m∘\u001b[7C\u001b[38;5;73m∘\u001b[C─\u001b[4C\u001b[39m \u001b[C\u001b[38;5;102m∘\u001b[5C\u001b[38;5;59m∘\u001b[20C\u001b[38;5;16m∘\u001b[34C∘\u001b[38;5;169m─\u001b[4C\u001b[38;5;16m∘\u001b[9C\u001b[38;5;169m─\u001b[4C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[6C\u001b[38;5;169m─\u001b[38;5;59m∘\u001b[3C\u001b[39m \u001b[16C\u001b[38;5;16m○\u001b[2C∘\u001b[14C\u001b[38;5;59m∘\u001b[13;13H\u001b[38;5;60m∘\u001b[23C\u001b[38;5;102m∘\u001b[11C\u001b[38;5;103m∘\u001b[10C\u001b[38;5;59m∘\u001b[64C\u001b[38;5;102m∘\u001b[11C\u001b[38;5;103m∘\u001b[52C∘\u001b[14;54H∘\u001b[44C\u001b[38;5;205m∘\u001b[87C∘\u001b[15;149H\u001b[38;5;145m∘\u001b[22C·\u001b[16;13H∘\u001b[11C·\u001b[2C\u001b[38;5;188m∘\u001b[17C\u001b[38;5;231m∘\u001b[19C\u001b[38;5;145m∘\u001b[8C·\u001b[23C\u001b[38;5;231m∘\u001b[16C\u001b[38;5;188m∘\u001b[7C\u001b[38;5;145m·\u001b[9C\u001b[38;5;231m∘\u001b[19C\u001b[38;5;145m∘\u001b[32C\u001b[38;5;231m∘\u001b[17;66H\u001b[38;5;188m∘\u001b[73C\u001b[38;5;145m∘\u001b[13C\u001b[38;5;188m∘\u001b[38C\u001b[38;5;145m∘\u001b[18;4H∘\u001b[52C∘\u001b[85C\u001b[38;5;116m∘\u001b[52C∘\u001b[19;