[13.809014, "o", "\u001b[6;25H\u001b[38;5;205m∘\u001b[52C∘\u001b[34C∘\u001b[52C∘\u001b[7;78H○\u001b[11C\u001b[38;5;145m∘\u001b[49C\u001b[38;5;188m∘\u001b[37C\u001b[38;5;145m∘\u001b[14C\u001b[38;5;188m∘\u001b[8;4H∘\u001b[35C∘\u001b[16C∘\u001b[35C∘\u001b[34C∘\u001b[34C\u001b[38;5;231m∘\u001b[11C∘\u001b[38;5;96m◇\u001b[4C\u001b[38;5;188m∘\u001b[9;81H\u001b[38;5;145m∘\u001b[87C∘\u001b[10;21H\u001b[38;5;73m·\u001b[3C\u001b[38;5;145m○\u001b[8C\u001b[38;5;116m∘\u001b[86C\u001b[38;5;73m·\u001b[38;5;116m∘\u001b[11;34H\u001b[38;5;110m∘\u001b[8C\u001b[38;5;73m∘\u001b[52C∘\u001b[34C∘\u001b[8C\u001b[38;5;102m∘\u001b[5C\u001b[38;5;59m∘\u001b[25C\u001b[38;5;73m◇\u001b[5C\u001b[38;5;110m○\u001b[39m \u001b[4C\u001b[38;5;73m∘\u001b[14C\u001b[38;5;59m∘\u001b[12;4H\u001b[38;5;102m∘\u001b[5C\u001b[38;5;59m∘\u001b[5C∘\u001b[9C\u001b[39m \u001b[4C\u001b[38;5;73m─\u001b[9C\u001b[39m \u001b[4C\u001b[38;5;73m─\u001b[2C\u001b[38;5;59m∘\u001b[6C\u001b[39m \u001b[4C \u001b[C\u001b[38;5;59m○\u001b[2C\u001b[38;5;73m─\u001b[52C\u001b[38;5;16m∘\u001b[6C\u001b[39m \u001b[4C\u001b[38;5;169m─\u001b[5C\u001b[38;5;59m∘\u001b[3C\u001b[39m \u001b[4C\u001b[38;5;169m─\u001b[9C\u001b[39m \u001b[4C \u001b[4C\u001b[38;5;169m─\u001b[5C\u001b[38;5;16m∘\u001b[6C\u001b[38;5;102m◇\u001b[10C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[13;43H\u001b[38;5;103m∘\u001b[10C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[29C\u001b[38;5;103m∘\u001b[34C○\u001b[22C\u001b[38;5;96m∘\u001b[29C\u001b[38;5;103m∘\u001b[14;13H∘\u001b[26C\u001b[38;5;205m∘\u001b[52C∘\u001b[2C○\u001b[31C∘\u001b[49C\u001b[38;5;102m◇\u001b[2C\u001b[38;5;205m∘\u001b[15;96H∘\u001b[46C\u001b[38;5;145m∘\u001b[31C\u001b[38;5;102m◇\u001b[39m \u001b[16;7H\u001b[38;5;145m∘\u001b[32C\u001b[38;5;231m∘\u001b[31C\u001b[38;5;188m∘\u001b[55C\u001b[38;5;231m○\u001b[14C\u001b[38;5;188m∘\u001b[16C∘\u001b[35C∘\u001b[17;7H∘\u001b[38C\u001b[38;5;145m∘\u001b[13C\u001b[38;5;188m∘\u001b[58C○\u001b[14C\u001b[38;5;145m∘\u001b[18;49H\u001b[38;5;116m∘\u