[13.020222, "o", "\u001b[6;34H\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[19C\u001b[38;5;16m∘\u001b[55C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[14C\u001b[38;5;102m∘\u001b[4C\u001b[38;5;16m∘\u001b[23C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[7;13H\u001b[38;5;102m∘\u001b[13C\u001b[39m \u001b[38;5;73m·\u001b[37C\u001b[38;5;102m∘\u001b[58C\u001b[38;5;103m∘\u001b[38;5;73m·\u001b[27C\u001b[38;5;102m∘\u001b[11C\u001b[38;5;103m∘\u001b[8;25H\u001b[38;5;205m∘\u001b[39m \u001b[38;5;102m◇\u001b[45C\u001b[39m \u001b[38;5;169m◇\u001b[38;5;205m∘\u001b[39m \u001b[38;5;102m◇\u001b[35C\u001b[38;5;205m∘\u001b[9;21H\u001b[38;5;102m·\u001b[57C\u001b[39m \u001b[38;5;16m·\u001b[9C\u001b[38;5;145m∘\u001b[34C∘\u001b[14C\u001b[38;5;188m∘\u001b[37C\u001b[38;5;145m∘\u001b[14C\u001b[38;5;188m∘\u001b[10;4H∘\u001b[16C\u001b[39m \u001b[38;5;96m◇\u001b[2C\u001b[38;5;231m∘\u001b[38;5;73m◆\u001b[13C\u001b[38;5;188m∘\u001b[31C\u001b[38;5;96m◇\u001b[2C\u001b[38;5;231m∘\u001b[3C\u001b[38;5;102m◇\u001b[30C\u001b[38;5;231m∘\u001b[17C\u001b[38;5;188m○\u001b[34C\u001b[38;5;231m∘\u001b[17C\u001b(B\u001b[m\u001b[38;5;188m∘\u001b[11;22H∘\u001b[C\u001b[38;5;102m◆\u001b[2C\u001b[39m \u001b[44C\u001b[38;5;188m∘\u001b[8C\u001b[38;5;145m∘\u001b[11C○\u001b[22C∘\u001b[4C\u001b[38;5;102m·\u001b[9C\u001b[38;5;145m∘\u001b[37C∘\u001b[12;24H\u001b[39m \u001b[C \u001b[38;5;60m◆\u001b[C\u001b[39m \u001b[4C\u001b[38;5;116m∘\u001b[C\u001b[38;5;73m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;73m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;73m─\u001b[12C\u001b[39m \u001b[4C\u001b[38;5;116m∘\u001b[36C\u001b[39m \u001b[4C \u001b[C\u001b[38;5;116m∘\u001b[C\u001b[38;5;16m·\u001b[5C\u001b[38;5;169m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;169m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;169m─\u001b[5C\u001b[38;5;116m∘\u001b[13;25H\u001b[38;5;169m◆\u001b[39m \u001b[2C\u001b[38;5;102m◇\u001b[39m \u001b[3C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;73m∘\u001b[28C\u001b[38;5;16m◇\u001b