[1.428381, "o", "\u001b[2;46H \u001b[38;5;231m\u001b[1m⚔\u001b[6;54H\u001b(B\u001b[m\u001b[38;5;145m∘\u001b[138C\u001b[38;5;116m∘\u001b[7;57H∘\u001b[67C\u001b[38;5;102m·\u001b[5C\u001b[38;5;116m○\u001b[61C\u001b[38;5;110m∘\u001b[2C∘\u001b[8;7H∘\u001b[8C\u001b[38;5;73m∘\u001b[8C\u001b[38;5;102m∘\u001b[5C\u001b[38;5;59m∘\u001b[25C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;109m∘\u001b[8C\u001b[38;5;102m∘\u001b[8C\u001b[38;5;59m∘\u001b[19C\u001b[38;5;73m∘\u001b[14C\u001b[38;5;59m∘\u001b[34C\u001b[38;5;109m∘\u001b[8C\u001b[38;5;102m∘\u001b[26C\u001b[38;5;16m∘\u001b[9;4H∘\u001b[17C\u001b[38;5;59m∘\u001b[11C\u001b[38;5;96m∘\u001b[19C\u001b[38;5;16m∘\u001b[23C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[22C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[40C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m○\u001b[14C\u001b[38;5;102m∘\u001b[10;16H\u001b[38;5;103m∘\u001b[37C\u001b[38;5;102m∘\u001b[11C\u001b[38;5;103m∘\u001b[37C∘\u001b[44C\u001b[38;5;205m∘\u001b[22C\u001b[38;5;103m○\u001b[11;13H\u001b[38;5;205m∘\u001b[105C∘\u001b[34C∘\u001b[24C\u001b[38;5;73m◇\u001b[4C\u001b[38;5;205m∘\u001b[12;26H\u001b[39m \u001b[C\u001b[38;5;145m○\u001b[7C\u001b[38;5;73m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;73m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;73m─\u001b[11C\u001b[38;5;145m○\u001b[14C\u001b[38;5;188m∘\u001b[32C\u001b[39m \u001b[C\u001b[38;5;188m∘\u001b[7C\u001b[38;5;169m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;169m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;169m─\u001b[5C◇\u001b[8C\u001b[38;5;188m○\u001b[17C\u001b[38;5;231m∘\u001b[13;13H∘\u001b[8C\u001b[38;5;169m◇\u001b[5C\u001b[38;5;188m∘\u001b[34C\u001b[38;5;231m∘\u001b[8C\u001b[38;5;169m◇\u001b[8C\u001b[38;5;188m∘\u001b[34C○\u001b[5C\u001b[38;5;169m◇\u001b[46C\u001b[38;5;188m○\u001b[11C∘\u001b[14;19H\u001b[38;5;145m∘\u001b[49C∘\u001b[79C○\u001b[7C∘\u001b[14C∘\u001b[15;22H\u001b[38;5;116m∘\u001b[49C∘\u001b[37C∘\u001b[16;22H\u001b[38;5;110m∘\u001b[8C\u001b[38;5;109m∘\u001b[8C\u001b[38;5;102m