[11.658687, "o", "\u001b[38;5;59m░\u001b[3C░\u001b[4C░\u001b[2C░\u001b[3C░\u001b[3C░\u001b[13C\u001b[38;5;30m\u001b[1m◇\u001b[41C\u001b[38;5;59m◇\u001b[18C\u001b(B\u001b[m\u001b[38;5;60m░░░░░░░\u001b[35;1H\u001b[38;5;188m\u001b[1m╔══[ \u001b[14C ]═════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════▓▒\u001b[38;52H\u001b(B\u001b[m \u001b[2C\u001b[38;5;145m\u001b[1m→\u001b[18C\u001b(B\u001b[m \u001b[19C\u001b[38;5;145m\u001b[1m→\u001b[9C\u001b[38;5;205m→\u001b[2C\u001b(B\u001b[m \u001b[58C\u001b[38;5;96m\u001b[1m→\u001b[2C\u001b(B\u001b[m \u001b[39;63H \u001b[3C\u001b[38;5;103m\u001b[1m→\u001b[6C\u001b(B\u001b[m \u001b[3C\u001b[38;5;103m\u001b[1m→\u001b[5C\u001b(B\u001b[m \u001b[9C\u001b[38;5;188m\u001b[1m→\u001b[2C\u001b(B\u001b[m \u001b[38;5;16m\u001b[1m→\u001b[C\u001b(B\u001b[m \u001b[5C \u001b[2C\u001b[38;5;188m\u001b[1m→\u001b[4C\u001b[38;5;16m→\u001b[C\u001b(B\u001b[m \u001b[9C\u001b[38;5;205m\u001b[1m→\u001b[4C\u001b(B\u001b[m  \u001b[13C\u001b[38;5;205m\u001b[1m→\u001b[4C\u001b(B\u001b[m \u001b[2C\u001b[38;5;116m\u001b[1m→\u001b[2C\u001b(B\u001b[m \u001b[40;78H\u001b[38;5;145m\u001b[1m→\u001b[9C\u001b[38;5;73m→\u001b[18C\u001b[38;5;145m→\u001b[4C\u001b(B\u001b[m\u001b[38;5;132m·\u001b[14C\u001b[38;5;145m\u001b[1m→\u001b[C\u001b[38;5;96m→\u001b[4C\u001b(B\u001b[m\u001b[38;5;132m·\u001b[41;61H·\u001b[2C·\u001b[38;5;102m\u001b[1m→\u001b[C\u001b[38;5;103m→\u001b[38;5;205m→→\u001b(B\u001b[m\u001b[38;5;132m·\u001b[C\u001b[38;5;145m\u001b[1m→\u001b[2C\u001b[38;5;205m→\u001b[38;5;59m→\u001b[38;5;16m→\u001b(B\u001b[m\u001b[38;5;132m·\u001b[2C·\u001b[C·\u001b[3C··\u001b[C\u001b[38;5;145m\u001b[1m→\u001b[3C\u001b[38;5;96m→\u001b[C\u001b[38;5;116m→\u001b[2C\u001b[38;5;145m→\u001b[C\u001b(B\u001b[m\u001b[38;5;132m·\u001b[C···\u001b[3C\u001b[38;5;205m\u001b[1m→\u001b[38;5;102m→\u001b[38;5;60m→\u001b[38;5;116m→\u001b[2C\u001b[38;5;145m→\u001b(B\u001b[m\