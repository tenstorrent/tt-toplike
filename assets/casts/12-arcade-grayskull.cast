[2.621742, "o", "\u001b[6;13H\u001b[38;5;16m∘\u001b[23C\u001b[38;5;60m∘\u001b[28C\u001b[38;5;16m∘\u001b[17C\u001b[38;5;59m∘\u001b[37C∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[14C\u001b[38;5;102m∘\u001b[4C\u001b[38;5;16m∘\u001b[17C○\u001b[7;13H\u001b[38;5;102m∘\u001b[11C\u001b[38;5;103m∘\u001b[128C\u001b[38;5;102m∘\u001b[11C\u001b[38;5;103m○\u001b[8;24H\u001b[39m \u001b[38;5;102m◇\u001b[C\u001b[39m \u001b[38;5;102m◇\u001b[45C\u001b[39m \u001b[38;5;102m◇\u001b[C\u001b[39m \u001b[38;5;102m◇\u001b[34C\u001b[38;5;205m∘\u001b[17C○\u001b[2C∘\u001b[28C○\u001b[35C○\u001b[9;22H\u001b[38;5;169m◇\u001b[11C\u001b[38;5;205m○\u001b[2C\u001b[38;5;145m∘\u001b[34C\u001b[38;5;169m◇\u001b[11C\u001b[38;5;205m○\u001b[5C\u001b[38;5;145m∘\u001b[34C∘\u001b[14C\u001b[38;5;188m∘\u001b[37C\u001b[38;5;145m○\u001b[10;22H\u001b[38;5;231m∘\u001b[6C\u001b[39m \u001b[42C\u001b[38;5;188m∘\u001b[6C\u001b[39m \u001b[10C\u001b[38;5;188m∘\u001b[19C\u001b[38;5;231m∘\u001b[17C\u001b[38;5;188m○\u001b[C\u001b[38;5;16m·\u001b[32C\u001b[38;5;231m○\u001b[11;28H\u001b[38;5;145m∘\u001b[38;5;102m◇\u001b[49C◇\u001b[C\u001b[38;5;145m○\u001b[34C∘\u001b[4C\u001b[38;5;102m·\u001b[38;5;145m∘\u001b[34C\u001b[38;5;188m○\u001b[11C\u001b[38;5;145m○\u001b[23C○\u001b[12;22H\u001b[38;5;96m◇\u001b[3C\u001b[39m \u001b[4C\u001b[38;5;116m○\u001b[4C\u001b[38;5;73m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;73m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;73m─\u001b[5C\u001b[38;5;96m◇\u001b[11C\u001b[38;5;116m∘\u001b[41C\u001b[39m \u001b[C\u001b[38;5;116m∘\u001b[C\u001b[38;5;60m·\u001b[5C\u001b[38;5;169m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;169m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;169m─\u001b[5C\u001b[38;5;116m∘\u001b[2C○\u001b[C\u001b[38;5;96m◆\u001b[6C\u001b[38;5;116m○\u001b[13;22H○\u001b[6C\u001b[39m \u001b[C\u001b[38;5;110m∘\u001b[11C\u001b[38;5;73m∘\u001b[5C\u001b[38;5;102m∘\u001b[22C\u001b[38;5;116m○\u001b[6C\u001b[39m \u001b[4C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;109m∘\u001b[37C\u001b[38;5;73m∘\u001b[8C\u0