[3.979723, "o", "\u001b[3;1H\u001b[38;5;205m\u001b[1m╔══[ \u001b[11C ]═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════▓▒░\u001b[6;31H\u001b(B\u001b[m\u001b[38;5;188m∘\u001b[37C\u001b[38;5;145m∘\u001b[49C\u001b[38;5;188m∘\u001b[37C\u001b[38;5;145m∘\u001b[14C\u001b[38;5;188m∘\u001b[17C\u001b[38;5;231m∘\u001b[7;4H∘\u001b[14C\u001b[38;5;188m∘\u001b[5C∘\u001b[38;5;60m·\u001b[27C\u001b[38;5;231m∘\u001b[20C\u001b[38;5;188m∘\u001b[38;5;60m·\u001b[30C\u001b[38;5;188m∘\u001b[88C\u001b[38;5;145m∘\u001b[8;10H∘\u001b[49C∘\u001b[138C\u001b[38;5;116m∘\u001b[9;13H∘\u001b[49C∘\u001b[10;13H\u001b[38;5;110m∘\u001b[17C\u001b[38;5;102m∘\u001b[31C\u001b[38;5;110m∘\u001b[17C\u001b[38;5;102m∘\u001b[8C\u001b[38;5;59m∘\u001b[19C\u001b[38;5;73m∘\u001b[14C\u001b[38;5;59m∘\u001b[37C\u001b[38;5;73m∘\u001b[14C\u001b[38;5;59m∘\u001b[11;10H\u001b[38;5;16m∘\u001b[10C\u001b[38;5;73m·\u001b[8C\u001b[39m \u001b[3C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[16C\u001b[38;5;16m∘\u001b[10C\u001b[38;5;73m·\u001b[8C\u001b[39m \u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[22C\u001b[38;5;59m∘\u001b[52C∘\u001b[11C\u001b[38;5;96m○\u001b[14C\u001b[38;5;102m∘\u001b[12;10H∘\u001b[10C\u001b[39m \u001b[38;5;103m○\u001b[3C\u001b[38;5;73m─\u001b[3C\u001b[38;5;169m·\u001b[38;5;103m∘\u001b[9C\u001b[38;5;73m─\u001b[4C\u001b[38;5;103m∘\u001b[13C\u001b[38;5;102m∘\u001b[38;5;73m─\u001b[4C\u001b[38;5;102m∘\u001b[4C\u001b[39m \u001b[8C\u001b[38;5;169m·\u001b[29C\u001b[38;5;103m∘\u001b[15C\u001b[38;5;169m─\u001b[4C\u001b[38;5;103m∘\u001b[9C\u001b[38;5;169m─\u001b[4C\u001b[38;5;103m∘\u001b[14C\u001b[38;5;169m─\u001b[4C\u001b[38;5;103m∘\u001b[13;107H\u001b[38;5;205m∘\u001b[35C○\u001b[16C∘\u001b[14;34H\u001b(B\u001b[m"]
