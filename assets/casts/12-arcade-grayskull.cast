[1.171177, "o", "\u001b[4C \u001b[9C\u001b[38;5;73m─\u001b[4C\u001b[38;5;205m∘\u001b[59C\u001b[38;5;169m─\u001b[3C\u001b[39m \u001b[38;5;205m○\u001b[14C\u001b[38;5;169m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;169m─\u001b[4C\u001b[38;5;205m∘\u001b[29C\u001b[38;5;145m∘\u001b[13;10H∘\u001b[14C\u001b[38;5;188m∘\u001b[17C\u001b[38;5;231m∘\u001b[16C\u001b[38;5;145m∘\u001b[14C\u001b[38;5;188m∘\u001b[17C\u001b[38;5;231m∘\u001b[25C\u001b[38;5;188m○\u001b[5C○\u001b[4C\u001b[38;5;73m·\u001b[38;5;231m∘\u001b[31C\u001b[38;5;188m∘\u001b[17C\u001b[38;5;231m○\u001b[17C\u001b[38;5;188m∘\u001b[14;49H\u001b[38;5;145m∘\u001b[13C\u001b[38;5;188m∘\u001b[55C∘\u001b[17C\u001b[38;5;145m∘\u001b[15;140H\u001b[38;5;116m∘\u001b[16;4H∘\u001b[119C\u001b[38;5;16m·\u001b[38;5;116m∘\u001b[14C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;109m∘\u001b[19C\u001b[38;5;116m○\u001b[23C\u001b[38;5;110m∘\u001b[17;4H∘\u001b[11C\u001b[38;5;73m∘\u001b[5C\u001b[38;5;102m∘\u001b[8C\u001b[38;5;59m∘\u001b[17C\u001b[38;5;16m∘\u001b[7C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;73m∘\u001b[8C\u001b[38;5;102m∘\u001b[5C\u001b[38;5;59m∘\u001b[28C\u001b[38;5;102m∘\u001b[8C\u001b[38;5;59m∘\u001b[17C\u001b[38;5;16m∘\u001b[16C\u001b[38;5;73m∘\u001b[8C\u001b[38;5;102m∘\u001b[5C\u001b[38;5;59m○\u001b[18;22H∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[14C\u001b[38;5;102m∘\u001b[22C\u001b[38;5;59m∘\u001b[11C\u001b[38;5;96m∘\u001b[25C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[14C\u001b[38;5;102m∘\u001b[22C\u001b[38;5;59m∘\u001b[11C\u001b[38;5;96m∘\u001b[19;66H\u001b[38;5;103m∘\u001b[82C\u001b[38;5;205m∘\u001b[4C\u001b[38;5;103m∘\u001b[11C∘\u001b[32C\u001b[38;5;205m∘\u001b[26;7H\u001b[38;5;59m═\u001b[24C\u001b[38;5;16m·\u001b[1m◇\u001b[35C\u001b(B\u001b[m\u001b[38;5;30m·\u001b[1m◇\u001b[27;34H□\u001b[30C\u001b(B\u001b[m\u001b[38;5;73m║\u001b[3C\u001b[38;5;59m·\u001b[6C\u001b[1m□\u001b[29C\u001b(B\u001b[m\u001b[38;5;16m·\u001b[39m \u001b[28;34H\u001b[38;5;30m·\u001b[41C\u001b[38;5;53m·\u001b[29;14H\u00