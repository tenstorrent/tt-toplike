[9.343726, "o", "\u001b[6;7H\u001b[38;5;102m∘\u001b[5C\u001b[38;5;59m∘\u001b[20C\u001b[38;5;16m∘\u001b[31C\u001b[38;5;59m∘\u001b[55C\u001b[38;5;16m∘\u001b[23C\u001b[38;5;60m∘\u001b[7C\u001b[38;5;59m∘\u001b[20C\u001b[38;5;16m○\u001b[17C\u001b[38;5;59m∘\u001b[7;4H∘\u001b[41C\u001b[38;5;103m∘\u001b[10C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[29C\u001b[38;5;103m∘\u001b[7C\u001b[38;5;96m∘\u001b[14C\u001b[38;5;102m∘\u001b[38;5;16m·\u001b[3C\u001b[39m \u001b[38;5;96m·\u001b[5C\u001b[38;5;103m∘\u001b[22C\u001b[38;5;60m○\u001b[14C\u001b[38;5;96m∘\u001b[2C\u001b[38;5;102m○\u001b[11C\u001b[38;5;103m∘\u001b[5C○\u001b[8;23H\u001b[38;5;102m◇\u001b[5C\u001b[38;5;60m·\u001b[13C\u001b[38;5;205m∘\u001b[29C\u001b[38;5;102m◇\u001b[5C\u001b[38;5;60m·\u001b[16C\u001b[38;5;205m∘\u001b[25C\u001b[38;5;103m∘\u001b[6C\u001b[39m \u001b[48C\u001b[38;5;103m∘\u001b[5C\u001b[38;5;205m○\u001b[9;23H\u001b[39m \u001b[4C\u001b[38;5;205m∘\u001b[38;5;73m◇\u001b[43C\u001b[39m \u001b[4C\u001b[38;5;205m∘\u001b[38;5;73m◇\u001b[41C·\u001b[8C\u001b[38;5;96m·\u001b[38;5;205m○\u001b[14C\u001b[38;5;145m∘\u001b[25C\u001b[38;5;205m∘\u001b[38;5;145m◇\u001b[4C\u001b[38;5;73m◇\u001b[20C\u001b[38;5;145m○\u001b[10;10H∘\u001b[14C\u001b[38;5;188m∘\u001b[38;5;102m◆\u001b[16C\u001b[38;5;231m∘\u001b[31C\u001b[38;5;188m∘\u001b[38;5;102m◆\u001b[36C\u001b[38;5;188m∘\u001b[7C\u001b[39m \u001b[9C\u001b[38;5;231m○\u001b[17C\u001b[38;5;188m∘\u001b[22C○\u001b[C\u001b[39m \u001b[38;5;169m◆\u001b[C\u001b[39m \u001b[6C\u001b[38;5;231m○\u001b[11;10H\u001b[38;5;188m∘\u001b[13C\u001b[38;5;169m◆\u001b[2C\u001b[39m \u001b[21C\u001b[38;5;145m∘\u001b[13C\u001b[38;5;188m∘\u001b[10C\u001b[38;5;169m◆\u001b[2C\u001b[39m \u001b[59C\u001b[38;5;145m∘\u001b[39C\u001b[38;5;102m◆\u001b[12C\u001b[38;5;145m○\u001b[12;24H\u001b[39m \u001b[2C\u001b[38;5;73m◆\u001b[3C\u001b[38;5;145m∘\u001b[4C\u001b[38;5;73m─\u001b[9C\u001b[38;5;145m∘\u001b[4C\u001b[38;5;73m─\u001b[9C\u001b[39m \u001b[9C\u001b[38;5;73m─\u001b[2C\u001b[39m \u