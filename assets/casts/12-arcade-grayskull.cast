[3.406979, "o", "\u001b[2;49H \u001b[38;5;231m\u001b[1m⚔\u001b[6;25H\u001b(B\u001b[m\u001b[38;5;205m∘\u001b[49C∘\u001b[37C∘\u001b[7;90H\u001b[38;5;145m∘\u001b[49C\u001b[38;5;188m∘\u001b[37C\u001b[38;5;145m○\u001b[14C\u001b[38;5;188m∘\u001b[8;4H∘\u001b[18C\u001b[39m \u001b[38;5;169m◇\u001b[C\u001b[39m \u001b[38;5;102m◇\u001b[12C\u001b[38;5;188m∘\u001b[13C∘\u001b[18C\u001b[39m \u001b[38;5;169m◇\u001b[38;5;231m∘\u001b[39m \u001b[38;5;102m◇\u001b[12C\u001b[38;5;188m∘\u001b[19C\u001b[38;5;231m∘\u001b[17C\u001b[38;5;188m∘\u001b[34C\u001b[38;5;231m∘\u001b[8C\u001b[38;5;73m·\u001b[2C\u001b[38;5;231m○\u001b[38;5;169m◇\u001b[9;21H\u001b[38;5;73m·\u001b[7C\u001b[39m \u001b[41C\u001b[38;5;73m·\u001b[7C\u001b[39m \u001b[C\u001b[38;5;145m∘\u001b[39C\u001b[38;5;73m·\u001b[47C\u001b[38;5;145m∘\u001b[10;22H\u001b[38;5;96m◇\u001b[6C\u001b[38;5;102m◇\u001b[4C\u001b[38;5;116m∘\u001b[37C\u001b[38;5;96m◇\u001b[6C\u001b[38;5;102m◇\u001b[4C\u001b[38;5;116m∘\u001b[87C○\u001b[11;22H∘\u001b[11C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;73m∘\u001b[28C\u001b[38;5;116m∘\u001b[11C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;109m∘\u001b[28C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;73m∘\u001b[8C\u001b[38;5;102m∘\u001b[5C\u001b[38;5;59m∘\u001b[25C\u001b[38;5;16m◇\u001b[6C\u001b[39m \u001b[4C\u001b[38;5;73m∘\u001b[5C\u001b[38;5;102m∘\u001b[8C\u001b[38;5;59m∘\u001b[12;4H\u001b[38;5;102m∘\u001b[5C\u001b[38;5;59m∘\u001b[15C\u001b[39m \u001b[2C \u001b[C\u001b[38;5;73m─\u001b[5C\u001b[38;5;16m○\u001b[3C\u001b[39m \u001b[4C\u001b[38;5;73m─\u001b[2C\u001b[38;5;59m∘\u001b[4C\u001b[38;5;102m∘\u001b[C\u001b[39m \u001b[4C \u001b[4C\u001b[38;5;73m─\u001b[12C\u001b[39m \u001b[C\u001b[38;5;16m∘\u001b[5C○\u001b[38C\u001b[39m \u001b[4C\u001b[38;5;169m─\u001b[5C\u001b[38;5;59m∘\u001b[3C\u001b[39m \u001b[4C\u001b[38;5;169m─\u001b[2C\u001b[38;5;96m∘\u001b[6C\u001b[39m \u001b[4C \u001b[4C\u001b[38;5;169m─\u001b[2C\u001b[38;5;16m∘\u001b[2C∘\u001b[6C\u001b[38;5;145m◇\u001b[10C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[13;22H\u001b[3