[3.885903, "o", "\u001b[14;19H\u001b[38;5;205m○\u001b[2C∘\u001b[23C\u001b[38;5;145m∘\u001b[22C\u001b[38;5;205m○\u001b[2C∘\u001b[23C\u001b[38;5;145m∘\u001b[34C∘\u001b[11C○\u001b[2C\u001b[38;5;188m∘\u001b[37C\u001b[38;5;145m∘\u001b[14C\u001b[38;5;188m∘\u001b[15;10H∘\u001b[8C∘\u001b[4C\u001b[38;5;73m◇\u001b[38;5;188m∘\u001b[C\u001b[38;5;102m◇\u001b[38;5;188m∘\u001b[2C\u001b[38;5;231m∘\u001b[14C\u001b[38;5;188m∘\u001b[22C∘\u001b[4C\u001b[38;5;73m◇\u001b[38;5;188m∘\u001b[C\u001b[38;5;102m◇\u001b[38;5;188m∘\u001b[2C\u001b[38;5;231m∘\u001b[34C∘\u001b[17C\u001b[38;5;188m∘\u001b[34C\u001b[38;5;231m∘\u001b[5C\u001b[38;5;102m◇\u001b[39m \u001b[10C\u001b[38;5;188m∘\u001b[16;37H\u001b[38;5;145m∘\u001b[49C∘\u001b[34C∘\u001b[52C∘\u001b[17;40H\u001b[38;5;116m∘\u001b[49C∘\u001b[87C∘\u001b[18;40H\u001b[38;5;110m∘\u001b[8C\u001b[38;5;109m∘\u001b[40C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;109m∘\u001b[28C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;73m∘\u001b[8C\u001b[38;5;102m∘\u001b[43C\u001b[38;5;73m∘\u001b[19;10H\u001b[38;5;102m∘\u001b[26C\u001b[38;5;16m∘\u001b[22C\u001b[38;5;102m∘\u001b[8C\u001b[38;5;59m∘\u001b[17C\u001b[38;5;16m∘\u001b[16C\u001b[38;5;59m∘\u001b[23C\u001b[38;5;16m○\u001b[14C\u001b[38;5;59m∘\u001b[13C∘\u001b[17C\u001b[38;5;16m∘\u001b[20C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[26;23H\u001b[38;5;66m═\u001b[16C\u001b[38;5;16m\u001b[1m◌\u001b[24C\u001b(B\u001b[m\u001b[38;5;16m·\u001b[16C\u001b[1m◌\u001b(B\u001b[m\u001b[38;5;16m·\u001b[3C\u001b[38;5;59m\u001b[1m◌\u001b(B\u001b[m\u001b[38;5;59m·\u001b[18C\u001b[38;5;89m·\u001b[6C\u001b[38;5;59m░\u001b[38;5;102m▒\u001b[20C\u001b[38;5;59m░\u001b[38;5;102m▒\u001b[20C\u001b[38;5;59m░\u001b[38;5;102m▒\u001b[38;5;59m░\u001b[19C░\u001b[38;5;102m▒\u001b[27;6H\u001b[38;5;16m\u001b[1m◌\u001b[41C\u001b[38;5;30m◌\u001b[28;5H\u001b(B\u001b[m\u001b[38;5;16m·\u001b[8C\u001b[1m∘\u001b[12C\u001b(B\u001b[m \u001b[19C\u001b[38;5;30m·\u001b[8C\u001b[1m∘\u001b[29;14H\u001b(B\u001b[m\u001b[38;5;16m·\u001b[39m \u001b[40C\u001b[38;5;30m·\u001b[38