[13.973694, "o", "\u001b[2C\u001b[38;5;103m∘\u001b[3C\u001b[38;5;102m◇\u001b[83C\u001b[38;5;103m○\u001b[14;21H\u001b[38;5;102m·\u001b[8C\u001b[38;5;169m·\u001b[41C\u001b[38;5;205m∘\u001b[37C∘\u001b[49C∘\u001b[14C∘\u001b[15;22H∘\u001b[6C\u001b[39m \u001b[4C\u001b[38;5;145m∘\u001b[14C\u001b[38;5;188m∘\u001b[24C\u001b[38;5;73m◇\u001b[38;5;205m∘\u001b[C\u001b[38;5;102m◇\u001b[38;5;205m∘\u001b[20C\u001b[38;5;188m∘\u001b[22C\u001b[38;5;145m∘\u001b[14C\u001b[38;5;188m∘\u001b[39C\u001b[38;5;102m◇\u001b[9C\u001b[38;5;188m∘\u001b[16;19H\u001b[38;5;231m∘\u001b[3C\u001b[38;5;102m·\u001b[39m \u001b[C\u001b[38;5;145m·\u001b[C\u001b[38;5;169m·\u001b[8C\u001b[38;5;188m∘\u001b[38C\u001b[38;5;145m·\u001b[10C\u001b[38;5;188m∘\u001b[19C\u001b[38;5;231m∘\u001b[17C\u001b[38;5;145m·\u001b[39m \u001b[33C\u001b[38;5;231m○\u001b[14C\u001b[38;5;188m∘\u001b[38;5;102m·\u001b[17;25H\u001b[38;5;145m∘\u001b[8C∘\u001b[46C○\u001b[31C∘\u001b[52C∘\u001b[18;28H\u001b[38;5;116m∘\u001b[2C○\u001b[49C○\u001b[75C\u001b[38;5;145m○\u001b[2C∘\u001b[8C\u001b[38;5;116m∘\u001b[19;40H\u001b[38;5;73m∘\u001b[40C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;73m∘\u001b[8C\u001b[38;5;102m∘\u001b[28C\u001b[38;5;73m∘\u001b[14C\u001b[38;5;59m∘\u001b[13C\u001b[38;5;116m∘\u001b[11C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;109m∘\u001b[8C\u001b[38;5;102m∘\u001b[26;4H\u001b[38;5;59m═\u001b[2C═════\u001b[2C═\u001b[C══\u001b[4C═\u001b[C═══\u001b[C══\u001b[C═\u001b[C\u001b[38;5;16m·\u001b[1m◇\u001b(B\u001b[m\u001b[38;5;59m════\u001b[4C═\u001b[2C═\u001b[2C═══\u001b[C═\u001b[3C═\u001b[2C═════\u001b[2C══\u001b[C\u001b[38;5;16m·\u001b[1m◇\u001b(B\u001b[m\u001b[38;5;59m═══\u001b[3C═══\u001b[C═\u001b[2C═\u001b[C═══\u001b[C═\u001b[3C════\u001b[4C═══\u001b[C═\u001b[C══\u001b[27;119H\u001b[38;5;73m▒░▒░\u001b[18C▓░\u001b[38;5;109m▒\u001b[38;5;73m░\u001b[18C▒░▒░\u001b[18C\u001b[38;5;66m░\u001b[38;5;73m░\u001b[38;5;109m▒\u001b[38;5;73m░\u001b[28;24H\u001b[38;5;16m\u001b[1m◇\u001b[52C\u001b(B\u001b[m \u001b[29;24H\u001b[38;5;16m·\u001b[30;3H\u001b[1m◌\u0