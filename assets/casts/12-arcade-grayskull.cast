[6.63805, "o", "\u001b[38;5;145m\u001b[1m→\u001b[C\u001b[38;5;116m→\u001b[2C\u001b[38;5;60m→\u001b[38;5;116m←\u001b(B\u001b[m\u001b[38;5;132m·\u001b[38;5;231m\u001b[1m→\u001b[C\u001b[38;5;145m←\u001b(B\u001b[m\u001b[38;5;132m·\u001b[C··\u001b[4C\u001b[38;5;96m\u001b[1m→\u001b(B\u001b[m\u001b[38;5;132m·\u001b[38;5;145m\u001b[1m→\u001b[C\u001b(B\u001b[m\u001b[38;5;132m·\u001b[2C·\u001b[43;57H\u001b[38;5;103m\u001b[1m←\u001b[34C\u001b[38;5;145m←\u001b[24C\u001b(B\u001b[m\u001b[38;5;132m·\u001b[3C\u001b[38;5;116m\u001b[1m←\u001b[19C\u001b(B\u001b[m\u001b[38;5;132m·\u001b[3C\u001b[38;5;116m\u001b[1m←\u001b[45;28H\u001b[38;5;145m←\u001b[14C\u001b(B\u001b[m \u001b[16C\u001b[38;5;116m\u001b[1m←\u001b[15C\u001b(B\u001b[m \u001b[14C\u001b[38;5;145m\u001b[1m←\u001b[38;5;188m←\u001b[38;5;102m←\u001b[15C\u001b(B\u001b[m \u001b[15C \u001b[14C  \u001b[38;5;96m\u001b[1m←\u001b[15C\u001b(B\u001b[m \u001b[14C\u001b[38;5;145m\u001b[1m←\u001b[38;5;102m←\u001b[48;21H\u001b(B\u001b[m\u001b[38;5;188m\u001b[2m6\u001b[50;146H\u001b(B\u001b[m\u001b[38;5;188m\u001b[48;5;16m2\u001b(B\u001b[m"]
