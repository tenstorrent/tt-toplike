[5.740806, "o", "\u001b[6;4H\u001b[38;5;110m∘\u001b[11C\u001b[38;5;73m∘\u001b[5C\u001b[38;5;102m∘\u001b[8C\u001b[38;5;59m∘\u001b[17C\u001b[38;5;16m∘\u001b[16C\u001b[38;5;73m∘\u001b[14C\u001b[38;5;59m∘\u001b[22C\u001b[38;5;73m∘\u001b[5C\u001b[38;5;102m∘\u001b[8C\u001b[38;5;59m∘\u001b[17C\u001b[38;5;16m∘\u001b[16C\u001b[38;5;73m∘\u001b[8C\u001b[38;5;102m∘\u001b[26C\u001b[38;5;16m∘\u001b[7;22H\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[14C\u001b[38;5;102m∘\u001b[22C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[14C\u001b[38;5;102m∘\u001b[10C\u001b[38;5;59m∘\u001b[2C\u001b[38;5;60m∘\u001b[8C\u001b[38;5;96m∘\u001b[14C\u001b[38;5;102m∘\u001b[28C\u001b[38;5;60m∘\u001b[23C\u001b[38;5;102m∘\u001b[8;66H\u001b[38;5;103m∘\u001b[56C\u001b[38;5;16m◇\u001b[25C\u001b[38;5;205m∘\u001b[4C\u001b[38;5;103m∘\u001b[44C\u001b[38;5;205m∘\u001b[9;13H∘\u001b[49C∘\u001b[59C\u001b[39m \u001b[4C\u001b[38;5;205m∘\u001b[38;5;60m◇\u001b[4C\u001b[38;5;205m○\u001b[10;25H\u001b[38;5;145m∘\u001b[14C\u001b[38;5;188m∘\u001b[49C∘\u001b[22C\u001b[38;5;145m∘\u001b[14C\u001b[38;5;188m∘\u001b[17C\u001b[38;5;231m∘\u001b[19C\u001b[38;5;145m∘\u001b[32C\u001b[38;5;231m∘\u001b[11;10H∘\u001b[17C\u001b[38;5;188m∘\u001b[49C∘\u001b[37C∘\u001b[12;16H\u001b[38;5;145m∘\u001b[9C\u001b[38;5;73m─\u001b[4C\u001b[38;5;145m∘\u001b[9C\u001b[38;5;73m─\u001b[4C\u001b[38;5;145m∘\u001b[14C\u001b[38;5;73m─\u001b[4C\u001b[38;5;188m∘\u001b[37C\u001b[38;5;145m∘\u001b[21C\u001b[38;5;169m─\u001b[4C\u001b[38;5;145m○\u001b[9C\u001b[38;5;169m─\u001b[4C\u001b[38;5;145m∘\u001b[10C∘\u001b[3C\u001b[38;5;169m─\u001b[4C\u001b[38;5;145m∘\u001b[2C∘\u001b[13;43H\u001b[38;5;116m∘\u001b[28C∘\u001b[20C∘\u001b[66C∘\u001b[14;31H\u001b[38;5;73m∘\u001b[14C\u001b[38;5;59m∘\u001b[25C\u001b[38;5;110m∘\u001b[8C\u001b[38;5;73m∘\u001b[8C\u001b[38;5;102m∘\u001b[28C\u001b[38;5;73m○\u001b[2C\u001b[38;5;102m◇\u001b[39m \u001b[4C\u001b[38;5;102m○\u001b[5C\u001b[38;5;59m∘\u001b[25C\u001b[38;5;110m∘\u001b[11C\u001