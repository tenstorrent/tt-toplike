[6.265306, "o", "\u001b(B\u001b[m\u001b[38;5;54m········\u001b[42;43H\u001b[38;5;39m\u001b[1m←\u001b(B\u001b[m\u001b[38;5;54m·\u001b[20C\u001b[38;5;208m\u001b[1m←\u001b(B\u001b[m\u001b[38;5;54m·············\u001b[38;5;53m·················\u001b[38;5;214m\u001b[1m←\u001b(B\u001b[m\u001b[38;5;53m···\u001b[38;5;208m\u001b[1m←\u001b(B\u001b[m\u001b[38;5;53m············\u001b[38;5;54m·····\u001b[38;5;165m\u001b[1m←\u001b(B\u001b[m\u001b[38;5;54m····························\u001b[43;22H···········\u001b[38;5;53m··············\u001b[38;5;129m\u001b[1m←\u001b(B\u001b[m\u001b[38;5;53m···················\u001b[38;5;54m················\u001b[38;5;46m\u001b[1m←\u001b(B\u001b[m\u001b[38;5;54m·················\u001b[49C·\u001b[38;5;129m\u001b[1m←\u001b[C\u001b(B\u001b[m\u001b[38;5;54m·\u001b[C\u001b[38;5;196m\u001b[1m←\u001b[44;27H\u001b(B\u001b[m \u001b[5C\u001b[38;5;82m\u001b[1m←\u001b(B\u001b[m \u001b[22C\u001b[38;5;46m\u001b[1m←\u001b(B\u001b[m \u001b[114C\u001b[38;5;102m\u001b[48;5;16ma\u001b[C\u001b[1me\u001b[47;21H\u001b(B\u001b[m\u001b[38;5;189m\u001b[2m8\u001b(B\u001b[m"]
