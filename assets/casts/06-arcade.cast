[27.811465, "o", "\u001b[6;10H\u001b[38;5;21m◉\u001b[32C\u001b[38;5;93m◉\u001b[22C\u001b[38;5;21m∘\u001b[23C\u001b[38;5;57m∘\u001b[13C\u001b[38;5;27m∘\u001b[32C\u001b[38;5;57m∘\u001b[11C\u001b[38;5;93m∘\u001b[34C\u001b[38;5;57m∘\u001b[11C\u001b[38;5;93m∘\u001b[7;7H\u001b[38;5;129m◉\u001b[11C\u001b[38;5;165m◉\u001b[3C\u001b[39m \u001b[38;5;165m█\u001b[3C◉\u001b[34C\u001b[38;5;129m∘\u001b[23C\u001b[38;5;201m∘\u001b[22C\u001b[38;5;129m∘\u001b[11C\u001b[38;5;165m∘\u001b[11C\u001b[38;5;201m∘\u001b[34C\u001b[38;5;165m∘\u001b[11C\u001b[38;5;201m∘\u001b[8;13H\u001b[38;5;199m◉\u001b[8C\u001b[38;5;57m█\u001b[6C\u001b[38;5;197m█\u001b[7C◉\u001b[5C✦\u001b[16C\u001b[38;5;200m∘\u001b[20C\u001b[38;5;198m∘\u001b[11C\u001b[38;5;197m∘\u001b[13C\u001b[38;5;200m∘\u001b[11C\u001b[38;5;199m∘\u001b[20C\u001b[38;5;197m∘\u001b[13C\u001b[38;5;200m∘\u001b[11C\u001b[38;5;199m∘\u001b[8C∘\u001b[38;5;124m◇\u001b[10C\u001b[38;5;197m∘\u001b[11C\u001b[38;5;196m∘\u001b[9;4H◉\u001b[16C\u001b[39m \u001b[8C \u001b[3C\u001b[38;5;208m◉\u001b[22C\u001b[38;5;196m∘\u001b[20C\u001b[38;5;202m○\u001b[11C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;196m∘\u001b[32C\u001b[38;5;208m∘\u001b(B\u001b[m\u001b[11C\u001b[38;5;214m∘\u001b[34C\u001b[38;5;208m∘\u001b[11C\u001b[38;5;214m∘\u001b[10;7H\u001b[38;5;220m◉\u001b[11C\u001b[38;5;226m◉\u001b[10C\u001b[38;5;202m█\u001b[9C\u001b[38;5;190m◉\u001b[13C\u001b[38;5;214m∘\u001b[20C\u001b[38;5;226m∘\u001b[20C\u001b[38;5;190m∘\u001b[25C\u001b[38;5;226m○\u001b[46C∘\u001b[17C○\u001b[11;4H\u001b[38;5;154m◉\u001b[20C\u001b[38;5;82m◉\u001b[11C\u001b[38;5;46m◉\u001b[11C✦\u001b[10C\u001b[38;5;154m∘\u001b[32C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;154m∘\u001b[11C\u001b[38;5;118m∘\u001b[20C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;154m∘\u001b[11C\u001b[38;5;118m∘\u001b[5C\u001b[38;5;91m◇\u001b[5C\u001b[38;5;82m∘\u001b[39m \u001b[7C\u001b[38;5;82m∘\u001b[12;10H\u001b[38;5;46m◉\u001b[11C\u001b[38;5;199m◇\u001b[3C\u001b[38;5;31m─\u001b[3C\u001b[38;5;220m█\u001b[3C\u001b[38;5;49m◉\u001b[C\u001b[39m \u