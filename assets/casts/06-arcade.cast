[24.719613, "o", "\u001b[38;5;197m○\u001b[8C○\u001b[2C\u001b[38;5;196m◉\u001b[2C○\u001b[5C○\u001b[5C○\u001b[19C\u001b[38;5;197m∘\u001b[11C\u001b[38;5;196m∘\u001b[9;19H\u001b[38;5;214m○\u001b[C\u001b[38;5;148m░\u001b[38;5;214m○\u001b[5C○\u001b[C\u001b[38;5;38m░\u001b[38;5;220m○\u001b[2C○\u001b[8C\u001b[38;5;226m○\u001b[10C\u001b[38;5;202m∘\u001b[11C\u001b[38;5;208m∘\u001b[4C\u001b[39m \u001b[8C \u001b[18C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;208m○\u001b[2C○\u001b[4C\u001b[38;5;76m░\u001b[38;5;208m○\u001b[5C\u001b[38;5;214m○\u001b[C\u001b[38;5;26m░\u001b[6C\u001b[38;5;220m○\u001b[5C○\u001b[2C\u001b[38;5;226m○\u001b[13C\u001b[38;5;208m∘\u001b[11C\u001b[38;5;214m∘\u001b[20C\u001b[38;5;226m∘\u001b[10;7H○\u001b[5C○\u001b[2C\u001b[38;5;190m◉\u001b[2C○\u001b[5C\u001b[38;5;112m◆\u001b[2C\u001b[38;5;154m○\u001b[5C○\u001b[8C\u001b[38;5;118m○\u001b[5C\u001b[38;5;82m○\u001b[22C\u001b[38;5;190m∘\u001b[6C\u001b[39m \u001b[38;5;91m·\u001b[3C\u001b[38;5;154m∘\u001b[31C\u001b[38;5;226m○\u001b[2C○\u001b[4C\u001b[38;5;112m◆\u001b[2C\u001b[38;5;44m◆\u001b[38;5;190m○\u001b[2C\u001b[38;5;154m◉\u001b[2C○\u001b[5C○\u001b[2C\u001b[38;5;118m○\u001b[34C\u001b[38;5;154m∘\u001b[11C\u001b[38;5;118m∘\u001b[11;7H\u001b[38;5;82m○\u001b[2C○\u001b[2C\u001b[38;5;46m◉\u001b[5C○\u001b[2C○\u001b[2C○\u001b[4C\u001b[38;5;26m░\u001b[38;5;46m○\u001b[2C\u001b[38;5;47m○\u001b[5C○\u001b[2C○\u001b[2C\u001b[38;5;48m○\u001b[22C\u001b[38;5;46m∘\u001b[9C\u001b[38;5;34m◇\u001b[33C\u001b[38;5;82m○\u001b[2C○\u001b[2C\u001b[38;5;46m○\u001b[C\u001b[38;5;148m░\u001b[12C\u001b[38;5;46m○\u001b[5C\u001b[38;5;47m○\u001b[8C○\u001b[13C\u001b[38;5;46m∘\u001b[7C\u001b[38;5;31m·\u001b[38;5;46m○\u001b[14C\u001b[38;5;47m∘\u001b[12;4H\u001b[38;5;48m○\u001b[2C○\u001b[2C\u001b[38;5;49m○\u001b[5C○\u001b[2C○\u001b[C\u001b[38;5;178m░\u001b[38;5;50m○\u001b[3C\u001b[38;5;164m═\u001b[4C\u001b[38;5;162m═\u001b[4C\u001b[39m \u001b[4C \u001b[C\u001b[38;5;51m○\u001b[2C\u001b[38;5;31m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;31m─\u001b[4C\u001b[3