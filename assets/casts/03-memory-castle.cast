[12.825555, "o", "\u001b[23;21H\u001b[38;5;17m\u001b[1m\u25c7\u001b[41C\u25c7\u001b[41C\u001b[38;5;52m\u25c7\u001b[24;21H\u001b(B\u001b[m\u001b[38;5;16m\u00b7\u001b[41C\u00b7\u001b[41C\u00b7\u001b[26;44H\u001b[38;5;23m\u001b[1m\u25cc\u001b[41C\u001b[38;5;17m\u25cc\u001b[29C\u001b(B\u001b[m\u001b[38;5;30m\u25c7\u001b[27;44H\u001b[38;5;16m\u00b7\u001b[41C\u00b7\u001b[28C\u001b[38;5;30m\u25c7\u001b[15C\u25c7\u001b[28;8H\u001b[38;5;36m\u25c7\u001b[105C\u001b[38;5;30m\u25c7\u001b[15C\u25c7\u001b[15C\u25c7\u001b[29;23H\u001b[38;5;36m\u25c7\u001b[89C\u001b[38;5;30m\u25c7\u001b[15C\u25c7\u001b[15C\u25c7\u001b[30;21H\u001b[39m \u001b[16C\u001b[38;5;36m\u25c7\u001b[24C\u001b[38;5;30m\u25c7\u001b[41C\u001b[39m \u001b[6C\u001b[38;5;30m\u25c7\u001b[15C\u25c7\u001b[15C\u25c7\u001b[31;9H\u001b[38;5;17m\u001b[1m\u25cc\u001b[35C\u001b[38;5;52m\u2218\u001b[41C\u001b[38;5;22m\u2218\u001b[23C\u001b(B\u001b[m\u001b[38;5;30m\u25c7\u001b[15C\u25c7\u001b[15C\u25c7\u001b[32;9H\u001b[38;5;16m\u00b7\u001b[12C\u001b[38;5;17m\u001b[1m\u25c7\u001b[21C\u001b(B\u001b[m\u001b[38;5;36m\u25c7\u001b[38;5;16m\u00b7\u001b[18C\u001b[38;5;52m\u001b[1m\u25c7\u001b[21C\u001b(B\u001b[m \u001b[38;5;16m\u00b7\u001b[18C\u001b[38;5;22m\u001b[1m\u25c7\u001b[3C\u001b(B\u001b[m\u001b[38;5;30m\u25c7\u001b[15C\u25c7\u001b[15C\u25c7\u001b[33;22H\u001b[38;5;16m\u00b7\u001b[21C\u001b[38;5;17m\u001b[1m\u25cc\u001b[19C\u001b(B\u001b[m\u001b[38;5;16m\u00b7\u001b[16C\u001b[38;5;52m\u001b[1m\u25cc\u001b(B\u001b[m"]
