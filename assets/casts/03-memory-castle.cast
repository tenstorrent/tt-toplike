[1.244279, "o", "\u001b[38;5;52m\u001b[1m∘\u001b[7C\u001b(B\u001b[m\u001b[38;5;148m░░\u001b[3C\u001b[38;5;106m░\u001b[11C░\u001b[4C░\u001b[7C░\u001b[6C░\u001b[4C░\u001b[7C\u001b[38;5;112m░\u001b[42;4H\u001b[38;5;142m░\u001b[45C\u001b[38;5;16m·\u001b[38;5;142m░\u001b[24C\u001b[38;5;148m░\u001b[11C░\u001b[3C\u001b[38;5;16m·\u001b[7C\u001b[38;5;148m░░\u001b[27C\u001b[38;5;106m░\u001b[11C\u001b[38;5;112m░\u001b[38;5;106m░\u001b[6C░\u001b[43;15H\u001b[39m \u001b[41C \u001b[44;20H\u001b[38;5;148m░\u001b[39C░░\u001b[11C░\u001b[11C░\u001b[24C░\u001b[11C\u001b[38;5;106m░\u001b[45;36H\u001b[38;5;142m░\u001b[23C\u001b[38;5;148m░░\u001b[10C░░\u001b[11C░\u001b[11C░\u001b[2C\u001b[38;5;142m░\u001b[8C\u001b[38;5;106m░\u001b[4C░\u001b[6C░\u001b[4C\u001b[38;5;112m░\u001b[7C\u001b[38;5;106m░\u001b[11C░\u001b[46;37H\u001b[39m \u001b[7C\u001b[38;5;52m\u001b[1m◌\u001b[33C\u001b(B\u001b[m \u001b[7C\u001b[38;5;22m\u001b[1m◌\u001b[28C\u001b(B\u001b[m \u001b[47;12H\u001b[38;5;52m\u001b[1m∘\u001b[14C\u001b(B\u001b[m\u001b[38;5;142m░\u001b[17C\u001b[38;5;16m·\u001b[C\u001b[38;5;142m░\u001b[6C\u001b[38;5;22m\u001b[1m∘\u001b[14C\u001b(B\u001b[m\u001b[38;5;148m░\u001b[2C░\u001b[11C░\u001b[2C\u001b[38;5;16m·\u001b[8C\u001b[38;5;148m░░\u001b[8C\u001b[38;5;106m░\u001b[6C░\u001b[11C░\u001b[11C\u001b[38;5;112m░\u001b[38;5;106m░\u001b[6C░\u001b[4C░\u001b[48;12H\u001b[38;5;16m·\u001b[41C·\u001b[2C\u001b[38;5;148m░\u001b[2C\u001b[38;5;142m░\u001b[7C\u001b[38;5;148m░\u001b[15C░\u001b[38;5;142m░\u001b[10C\u001b[38;5;148m░\u001b[4C\u001b[38;5;142m░\u001b[4C\u001b[38;5;106m░\u001b[30C░\u001b[11C░\u001b[49;23H\u001b[38;5;52m\u001b[1m◇\u001b[41C\u001b[38;5;22m◇\u001b[41C\u001b[38;5;17m◇\u001b(B\u001b[m"]
[1.268816, "o", "\u001b[6;31H\u001b[38;5;203m\u001b[1m7\u001b[47C\u001b[38;5;155m9\u001b[90C\u001b[38;5;135m7\u001b[20;34H\u001b(B\u001b[m\u001b[38;5;30m│\u001b[36C\u001b[38;5;24m─\u001b[41C─\u001b[21;34H\u001b[38;5;30m│\u001b[36C\u001b[39m \u001b[41C \u001b[22;4H\u001b[38;5;30m│\u001b[28C│\u001b[36C\u001b[39m \u001b[41C \u001b[23;4H \u001b[28C \u001b[36C \u001b[41C \u001b[24;4H\u001b[38;5;30m│\u001b[28C│\u001b[36C\u001b[38;5;24m─\u001b[6C\u001b[38;5;17m\u001b[1m◌\u001b(B\u001b[m\u001b[38;5;16m·\u001b[33C\u001b[38;5;24m─\u001b[25;4H\u001b[38;5;30m│\u001b[28C│\u001b[36C\u001b[39m \u001b[41C \u001b[26;4H\u001b[38;5;88m│\u001b[9C│\u001b[9C│\u001b[8C\u001b[39m \u001b[10C\u001b[38;5;88m│\u001b[10C│\u001b[9C│\u001b[4C\u001b[39m \u001b[14C\u001b[38;5;88m│\u001b[9C│\u001b[10C│\u001b[5C\u001b[39m \u001b[13C\u001b[38;5;88m│\u001b[9C│\u001b[9C│\u001b[20C│\u001b[9C│\u001b[3C\u001b[38;5;89m◇\u001b[5C\u001b[38;5;88m│\u001b[27;4H│\u001b[9C│\u001b[9C│\u001b[7C\u001b[39m \u001b[C\u001b[38;5;88m│\u001b[9C│\u001b[10C│\u001b[9C│\u001b[3C\u001b[39m \u001b[5C\u001b[38;5;88m│\u001b[9C│\u001b[9C│\u001b[10C│\u001b[4C\u001b[39m \u001b[4C\u001b[38;5;88m│\u001b[9C│\u001b[9C│\u001b[9C│\u001b[10C│\u001b[9C│\u001b[9C│\u001b[9C│\u001b[8C\u001b[38;5;89m◇\u001b[38;5;88m│\u001b[28;4H│\u001b[9C│\u001b[19C│\u001b[9C│\u001b[10C│\u001b[19C│\u001b[9C│\u001b[9C│\u001b[20C│\u001b[9C│\u001b[9C│\u001b[20C│\u001b[9C│\u001b[9C│\u001b[19C│\u001b[29;14H│\u001b[9C│\u001b[2C\u001b[38;5;17m\u001b[1m◇\u001b[6C\u001b(B\u001b[m\u001b[38;5;88m│\u001b[9C│\u001b[10C│\u001b[9C│\u001b[3C\u001b[38;5;52m\u001b[1m◇\u001b[5C\u001b(B\u001b[m\u001b[38;5;88m│\u001b[9C│\u001b[9C│\u001b[10C│\u001b[4C\u001b[38;5;22m\u001b[1m◇\u001b[4C\u001b(B\u001b[m\u001b[38;5;88m│\u001b[9C│\u001b[9C│\u001b[9C│\u001b[10C│\u001b[9C│\u001b[9C│\u001b[9C│\u001b[9C│\u001b[30;24H│\u001b[2C\u001b[38;5;16m·\u001b[6C\u001b[38;5;88m│\u001b[9C│\u001b[20C│\u001b[3C\u001b[38;5;16m·\u001b[5C\u001b[38;5;88m│\u001b[9C│\u001b[20C│\u001b[4C\u001b[38;5;16m·\u001b[4C\u