[3.698646, "o", "\u001b[6;25H\u001b[38;5;57m∘\u001b[11C\u001b[38;5;93m∘\u001b[8C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;21m∘\u001b[32C\u001b[38;5;93m∘\u001b[11C\u001b[38;5;129m∘\u001b[13C\u001b[38;5;57m∘\u001b[11C\u001b[38;5;93m∘\u001b[20C\u001b[38;5;165m∘\u001b[19C\u001b[38;5;57m∘\u001b[20C\u001b[38;5;129m∘\u001b[11C\u001b[38;5;165m∘\u001b[7;10H∘\u001b[11C\u001b[38;5;201m∘\u001b[5C∘\u001b[14C\u001b[38;5;200m∘\u001b[28C\u001b[38;5;201m∘\u001b[5C∘\u001b[31C∘\u001b[17C∘\u001b[2C\u001b[38;5;200m∘\u001b[11C\u001b[38;5;199m∘\u001b[40C\u001b[38;5;200m∘\u001b[8;7H\u001b[38;5;199m∘\u001b[14C\u001b[38;5;34m·\u001b[6C\u001b[38;5;31m·\u001b[10C\u001b[38;5;196m∘\u001b[16C\u001b[38;5;199m∘\u001b[11C\u001b[38;5;198m∘\u001b[2C\u001b[38;5;34m·\u001b[6C\u001b[38;5;31m·\u001b[C\u001b[38;5;197m∘\u001b[25C\u001b[38;5;198m∘\u001b[8C\u001b[38;5;197m∘\u001b[5C\u001b[38;5;34m·\u001b[6C\u001b[38;5;31m·\u001b[27C\u001b[38;5;198m∘\u001b[11C\u001b[38;5;197m∘\u001b[8C∘\u001b[9;13H\u001b[38;5;202m∘\u001b[7C\u001b[39m \u001b[3C\u001b[38;5;208m∘\u001b[11C\u001b[38;5;214m∘\u001b[28C\u001b[38;5;202m∘\u001b[4C\u001b[39m \u001b[6C\u001b[38;5;208m∘\u001b[8C\u001b(B\u001b[m"]
[3.698799, "o", "\u001b[38;5;214m∘\u001b[11C\u001b[38;5;220m∘\u001b[13C\u001b[38;5;208m∘\u001b[7C\u001b[39m \u001b[3C\u001b[38;5;214m∘\u001b[11C\u001b[38;5;220m∘\u001b[16C\u001b[38;5;202m∘\u001b[11C\u001b[38;5;208m∘\u001b[2C∘\u001b[2C∘\u001b[38;5;124m◇\u001b[4C\u001b[38;5;106m◇\u001b[8C\u001b[38;5;220m∘\u001b[11C\u001b[38;5;226m∘\u001b[10;10H∘\u001b[23C\u001b[38;5;190m∘\u001b[8C\u001b[38;5;154m∘\u001b[19C\u001b[38;5;226m∘\u001b[20C\u001b[38;5;190m∘\u001b[11C\u001b[38;5;154m∘\u001b[34C∘\u001b[2C∘\u001b[8C\u001b[38;5;118m∘\u001b[28C\u001b[38;5;190m∘\u001b[11C\u001b[38;5;154m∘\u001b[11C\u001b[38;5;118m∘\u001b[11;7H∘\u001b[20C\u001b[38;5;46m∘\u001b[40C\u001b[38;5;82m∘\u001b[11C\u001b[38;5;46m○\u001b[25C\u001b[38;5;82m∘\u001b[32C\u001b[38;5;47m∘\u001b[16C\u001b[38;5;82m∘\u001b[11C\u001b[38;5;46m∘\u001b[12;4H\u001b[38;5;47m∘\u001b[20C\u001b[38;5;49m∘\u001b[39m \u001b[9C\u001b[38;5;31m─\u001b[38;5;50m∘\u001b[3C\u001b[39m \u001b[7C\u001b[38;5;51m∘\u001b[C\u001b[38;5;31m─\u001b[2C\u001b[38;5;47m∘\u001b[C\u001b[39m \u001b[9C\u001b[38;5;48m∘\u001b[4C\u001b[38;5;31m─\u001b[6C\u001b[38;5;49m∘\u001b[20C\u001b[38;5;51m∘\u001b[4C\u001b[38;5;48m∘\u001b[20C\u001b[38;5;50m∘\u001b[39m \u001b[9C\u001b[38;5;130m─\u001b[38;5;51m∘\u001b[3C\u001b[39m \u001b[9C\u001b[38;5;130m─\u001b[2C\u001b[38;5;48m∘\u001b[C\u001b[39m \u001b[9C\u001b[38;5;49m∘\u001b[4C\u001b[38;5;130m─\u001b[6C\u001b[38;5;50m∘\u001b[13;19H\u001b[38;5;51m○\u001b[2C\u001b[38;5;45m∘\u001b[3C\u001b[38;5;130m◆\u001b[16C\u001b[38;5;33m∘\u001b[25C\u001b[38;5;51m○\u001b[6C\u001b[38;5;130m◆\u001b[7C\u001b[38;5;39m∘\u001b[11C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;45m∘\u001b[8C○\u001b[2C\u001b[38;5;39m∘\u001b[3C\u001b[38;5;130m◆\u001b[16C\u001b[38;5;27m∘\u001b[28C\u001b[38;5;39m∘\u001b[2C\u001b[38;5;130m◆\u001b[8C\u001b[38;5;33m∘\u001b[11C\u001b[38;5;27m∘\u001b[14;7H∘\u001b[11C\u001b[38;5;21m○\u001b[10C\u001b[39m \u001b[9C\u001b[38;5;57m∘\u001b[28C\u001b[38;5;21m○\u001b[10C\u001b[39m \u001b[12C\u001b[38;5;57m∘\u001b[13C\u001b[38;5;21m