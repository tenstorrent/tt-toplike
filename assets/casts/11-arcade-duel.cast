[11.054285, "o", "\u001b[6;7H\u001b[38;5;165m∘\u001b[41C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;165m∘\u001b[11C\u001b[38;5;201m∘\u001b[20C\u001b[38;5;200m∘\u001b[13C\u001b[38;5;201m∘\u001b[20C\u001b[38;5;200m∘\u001b[11C\u001b[38;5;199m∘\u001b[11C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;201m○\u001b[20C\u001b[38;5;200m∘\u001b[11C\u001b[38;5;199m○\u001b[7;13H\u001b[38;5;198m∘\u001b[40C\u001b[38;5;199m∘\u001b[32C\u001b[38;5;196m∘\u001b[34C∘\u001b[23C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;198m○\u001b[8C\u001b[38;5;197m○\u001b[5C∘\u001b[11C\u001b[38;5;196m○\u001b[8;10H\u001b[38;5;202m∘\u001b[11C\u001b[38;5;208m∘\u001b[20C\u001b[38;5;220m∘\u001b[16C\u001b[38;5;202m∘\u001b[11C\u001b[38;5;208m∘\u001b[11C\u001b[38;5;214m∘\u001b[34C∘\u001b[11C\u001b[38;5;220m∘\u001b[28C\u001b[38;5;208m○\u001b[11C\u001b[38;5;214m○\u001b[39m \u001b[38;5;160m◇\u001b[C\u001b[39m \u001b[38;5;178m◇\u001b[6C\u001b[38;5;220m○\u001b[9;7H\u001b[38;5;226m∘\u001b[20C\u001b[38;5;190m∘\u001b[11C\u001b[38;5;154m∘\u001b[16C\u001b[38;5;226m∘\u001b[32C\u001b[38;5;154m∘\u001b[25C\u001b[38;5;190m∘\u001b[20C\u001b[38;5;118m∘\u001b[11C\u001b[38;5;82m∘\u001b[28C\u001b[38;5;154m○\u001b[39m \u001b[10C\u001b[38;5;118m○\u001b[10;13H\u001b[38;5;82m∘\u001b[11C\u001b[38;5;46m∘\u001b[28C\u001b[38;5;118m∘\u001b[20C\u001b[38;5;46m∘\u001b[23C\u001b[38;5;47m∘\u001b[34C∘\u001b[11C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;82m○\u001b[17C\u001b[38;5;162m◇\u001b[6C\u001b[38;5;76m◇\u001b[7C\u001b[38;5;47m○\u001b[11C\u001b[38;5;48m○\u001b[11;10H∘\u001b[11C\u001b[38;5;49m∘\u001b[20C\u001b[38;5;51m∘\u001b[28C\u001b[38;5;49m∘\u001b[11C\u001b[38;5;50m∘\u001b[11C\u001b[38;5;51m∘\u001b[22C\u001b[38;5;50m∘\u001b[11C\u001b[38;5;51m∘\u001b[40C\u001b[38;5;50m○\u001b[11C\u001b[38;5;51m○\u001b[12;19H\u001b[38;5;45m∘\u001b[8C\u001b[38;5;39m∘\u001b[2C\u001b[38;5;31m─\u001b[4C\u001b[39m \u001b[3C\u001b[38;5;33m∘\u001b[10C\u001b[38;5;31m─\u001b[4C\u001b[39m \u001b[9C\u001b[38;5;31m─\u001b[2C\u001b[38;5;45m∘\u001b[C\u001b[38;5;19m·\u001b[18C\u001b[38;5;33m∘\u001