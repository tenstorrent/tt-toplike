[13.812687, "o", "\u001b[6;7H\u001b[38;5;39m∘\u001b[11C\u001b[38;5;33m∘\u001b[11C\u001b[38;5;27m∘\u001b[28C\u001b[38;5;39m∘\u001b[20C\u001b[38;5;27m∘\u001b[11C\u001b[38;5;21m∘\u001b[13C\u001b[38;5;33m∘\u001b[20C\u001b[38;5;21m∘\u001b[31C\u001b[38;5;33m∘\u001b[20C\u001b[38;5;21m∘\u001b[7;16H\u001b[38;5;57m∘\u001b[6C\u001b[39m \u001b[38;5;34m·\u001b[3C\u001b[38;5;93m∘\u001b[20C\u001b[38;5;165m∘\u001b[16C\u001b[38;5;57m∘\u001b[6C\u001b[39m \u001b[38;5;34m·\u001b[3C\u001b[38;5;93m∘\u001b[11C\u001b[38;5;129m∘\u001b[13C\u001b[38;5;57m∘\u001b[18C\u001b[39m \u001b[38;5;34m·\u001b[38;5;129m∘\u001b[2C∘\u001b[8C\u001b[38;5;165m∘\u001b[11C\u001b[38;5;201m∘\u001b[7C\u001b[38;5;57m∘\u001b[16C\u001b[39m \u001b[38;5;142m·\u001b[2C\u001b[38;5;129m∘\u001b[11C\u001b[38;5;165m∘\u001b[8;13H\u001b[38;5;201m∘\u001b[8C\u001b[38;5;70m·\u001b[6C\u001b[38;5;37m·\u001b[4C\u001b[38;5;200m∘\u001b[11C\u001b[38;5;199m∘\u001b[16C\u001b[38;5;201m∘\u001b[8C\u001b[38;5;70m·\u001b[6C\u001b[38;5;37m·\u001b[16C\u001b[38;5;199m∘\u001b[25C\u001b[38;5;70m·\u001b[6C\u001b[38;5;37m·\u001b[13C\u001b[38;5;198m∘\u001b[31C\u001b[38;5;200m○\u001b[20C\u001b[38;5;198m∘\u001b[9;19H\u001b(B\u001b[m"]
