[9.00597, "o", "\u001b[3;5H\u001b[38;5;37m\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;35m\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[21C\u2593\u001b[4;5H\u001b[38;5;37m\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;35m\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[21C\u2593\u001b[5;5H\u001b[38;5;37m\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;35m\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[21C\u2593\u001b[6;5H\u001b[38;5;37m\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;35m\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[21C\u2593\u001b[7;5H\u001b[38;5;37m\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;35m\u2588\u001b[2C\u2593\u001b[18C\u001b[38;5;34m\u2593\u001b[2C\u2588\u001b[21C\u2593\u001b[8;5H\u001b[38;5;37m\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;34m\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[21C\u2593\u001b[9;5H\u001b[38;5;37m\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;34m\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[21C\u2593\u001b[10;5H\u001b[38;5;36m\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;37m\u2588\u001b[2C\u001b(B\u001b[m"]
