[13.975626, "o", "\u001b[18C\u001b[38;5;70m\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[38;12H\u001b[38;5;35m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;106m\u2588\u001b[2C\u2593\u001b[18C\u001b[38;5;70m\u2593\u001b[2C\u2588\u001b[C\u001b[38;5;64m\u00b7\u001b[16C\u001b[38;5;70m\u2588\u001b[2C\u2593\u001b[39;12H\u001b[38;5;35m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;106m\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u2588\u001b[17C\u2588\u001b[2C\u2593\u001b[40;12H\u001b[38;5;35m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;106m\u2588\u001b[2C\u2593\u001b[16C\u001b[38;5;64m\u00b7\u001b[C\u001b[38;5;106m\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[41;12H\u001b[38;5;35m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;106m\u2588\u001b[2C\u2593\u001b[15C\u2588\u001b[2C\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[42;12H\u001b[38;5;35m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;106m\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[43;12H\u001b[38;5;35m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;106m\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[44;12H\u001b[38;5;35m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;106m\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[45;12H\u001b[38;5;35m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[18C\u001b[38;5;106m\u2588\u001b[2C\u2593\u001b[18C\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[46;12H\u001b[38;5;35m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[40C\u001b[38;5;106m\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[47;12H\u001b[38;5;35m\u2593\u001b[21C\u2588\u001b[21C\u2593\u00