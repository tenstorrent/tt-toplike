[3.933634, "o", "\u001b[21C\u001b[38;5;70m\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[21;5H\u001b[38;5;36m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[21C\u001b[38;5;70m\u2588\u001b[14C\u2588\u001b[6C\u2593\u001b[2C\u2588\u001b[10C\u001b[38;5;119m\u2593\u001b[7C\u001b[38;5;70m\u2588\u001b[2C\u2593\u001b[22;5H\u001b[38;5;36m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[21C\u001b[38;5;70m\u2588\u001b[15C\u001b[38;5;64m\u00b7\u001b[5C\u001b[38;5;70m\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[23;5H\u001b[38;5;36m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[21C\u001b[38;5;70m\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[10C\u2593\u001b[7C\u2588\u001b[2C\u2593\u001b[24;5H\u001b[38;5;36m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[21C\u001b[38;5;70m\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[25;5H\u001b[38;5;36m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[21C\u001b[38;5;70m\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[26;5H\u001b[38;5;36m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[21C\u001b[38;5;70m\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[27;5H\u001b[38;5;36m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[21C\u001b[38;5;70m\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[28;5H\u001b[38;5;36m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[21C\u001b[38;5;70m\u2588\u001b[16C\u2593\u001b[4C\u2593\u001b[2C\u2588\u001b[10C\u001b[38;5;112m\u2593\u001b[7C\u001b[38;5;70m\u2588\u001b[2C\u2593\u001b[29;5H\u001b[38;5;36m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[21C\u001b[38;5;70m\u2588\u001b[17C\u001b[38;5;64m\u00b7\u001b[3C\u001b[38;5;70m\u2593\u001b[2C\u2588\u001b[18C\u2588\u001b[2C\u2593\u001b[30;5H\u001b[38;5;36m\u2593\u001b[21C\u2588\u001b[21C\u2593\u001b[21C\u001b[38;5;70m\u2588\u001b[21C\u2593\u001b[2C\u2588\u001b[10C\u2593\u001b[7C\u2588\u001b[2C\u2593\u001b[31;5H\u001b[38;5;36m\u2593\u001b[21C\u2588\u001b[21C\u2593\u0