[2.095171, "o", "\u001b(B\u001b[m\u001b[38;5;163m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;145m\u2593\r\n\u001b[38;5;163m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;127m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[24C\u001b[38;5;163m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u001b[38;5;126m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;127m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;163m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[3C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;126m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[3C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;127m\u2593\u001b[C\u001b[38;5;163m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[8C\u2593\u2593\u2593\u2593\u2593\u2593\u001b[3C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;145m\u2593\r\n\u001b[38;5;163m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;127m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[24C\u001b[38;5;163m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u001b[38;5;126m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;127m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;163m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[3C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;126m\u2593\u2593\u2593\u2593\u2593\u2593\u00