[2.130083, "o", "\u001b[5;13H\u001b[38;5;28m\u2591\u001b[C\u2591\u001b[35C\u001b[38;5;71m0 \u001b[8C\u001b[38;5;76m\u2593\u2593\u001b[3C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[26C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u001b[38;5;28m\u2591\u001b[C\u2591\u001b[47C\u2591\u001b[C\u2591\u001b[6;11H\u2591\u001b[C\u2591\u001b[45C\u001b[38;5;76m\u2593\u2593\u001b[3C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[26C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u001b[38;5;28m\u2591\u001b[C\u2591\u001b[35C\u001b[38;5;76m\u2593\u001b[11C\u001b[38;5;28m\u2591\u001b[C\u2591\u001b[7;11H\u2591\u001b[C\u2591\u001b[45C\u001b[38;5;76m\u2593\u2593\u001b[3C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[26C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u001b[38;5;28m\u2591\u001b[C\u2591\u001b[35C\u001b[38;5;76m\u2593\u001b[11C\u001b[38;5;28m\u2591\u001b[C\u2591\u001b[8;11H\u2591\u001b[C\u2591\u001b[45C\u001b[38;5;76m\u2593\u2593\u001b[3C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[26C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u001b[38;5;28m\u2591\u001b[C\u2591\u001b[35C\u001b[38;5;76m\u2593\u001b[11C\u001b[38;5;28m\u2591\u001b[C\u2591\u001b[9;11H\u2591\u001b[C\u2591\u001b[45C\u001b[38;5;76m\u2593\u2593\u001b[3C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[26C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u001b[38;5;28m\u2591\u001b[C\u2591\u001b[35C\u001b[38;5;76m\u2593\u001b[11C\u001b[38;5;28m\u2591\u001b[C\u2591\u001b[10;69H\u001b[38;5;151m\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[73C\u001b[38;5;188m\u2593\u2593\u2593\u001b[11;67H\u001b[38;5;151m\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[70C\u001b[38;5;188m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[12;67H\u001b[38;5;151m\u2593\u2593\u001b[2C\u