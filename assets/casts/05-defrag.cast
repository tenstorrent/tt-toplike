[2.111862, "o", "\u001b[5;3H\u001b[38;5;188m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[16C\u001b[38;5;76m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u001b[4C\u2593\u2593\u001b[8C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u001b[38;5;28m\u2591\u001b[C\u2591\u001b[11C\u001b[38;5;76m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u001b[4C\u2593\u2593\u001b[38C\u2593\u2593\u001b[4C\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u001b[33C\u2593\u2593\u001b[4C\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\r\n\u001b[38;5;188m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[16C\u001b[38;5;76m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u001b[4C\u2593\u2593\u001b[6C\u001b[38;5;188m\u2593\u001b[C\u001b[38;5;76m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u001b[38;5;28m\u2591\u001b[C\u2591\u001b[11C\u001b[38;5;76m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u001b[4C\u2593\u2593\u001b[6C\u2593\u001b[31C\u2593\u2593\u001b[4C\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u2593\u001b[32C\u2593\u2593\u001b[4C\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u2593\r\n\u001b[38;5;188m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[16C\u001b[38;5;76m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u001b[4C\u2593\u2593\u001b[6C\u001b[38;5;188m\u2593\u001b[C\u001b[38;5;76m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u001b[38;5;28m\u2591\u001b[C\u2591\u001b[11C\u001b[38;5;76m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u001b[4C\u2593\u2593\u001b[6C\u2593\u001b[31C\u2593\u2593\u001b[4C\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u2593\u001b[32C\u2593\u2593\u001b[4C\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u2593\r\n\u001b[38;5;188m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u0