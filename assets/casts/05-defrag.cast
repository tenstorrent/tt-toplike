[13.596744, "o", "\u001b[10;39H\u001b[38;5;28m\u2592\u2592\u2592\u2592\u001b[5C\u2592\u2592\u001b[11;37H\u2592\u2592\u2592\u2592\u001b[3C\u2592\u2592\u2592\u2592\u2592\u2592\u001b[12;37H\u2592\u2592\u2592\u2592\u001b[3C\u2592\u2592\u2592\u2592\u2592\u2592\u001b[13;37H\u2592\u2592\u2592\u2592\u001b[3C\u2592\u2592\u2592\u2592\u2592\u2592\u001b[14;37H\u2592\u2592\u2592\u2592\u001b[3C\u2592\u2592\u2592\u2592\u2592\u2592\u001b[40;3H\u001b[38;5;53m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[50C\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\r\n\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[50C\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[80C\u2591\r\n\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[50C\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[80C\u2591\r\n\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[50C\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[80C\u2591\r\n\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[50C\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[80C\u2591\u001b(B\u001b[m"]
[13.614653, "o", "\u001b[10;3H\u001b[38;5;29m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[24C\u001b[38;5;109m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;28m\u2591\u2591\u2591\u2591\u001b[38;5;109m\u2593\u2593\u001b[3C\u001b[38;5;28m\u2591\u2591\u001b[9C\u001b[38;5;29m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[2C\u2591\u2591\u001b[10C\u2591\u2591\u2591\u2591\u2591\u2591\u001b[4C\u2591\u2591\u001b[24C\u001b[38;5;28m\u2591\u2591\u001b[2C\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\r\n\u001b[38;5;29m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[24C\u001b[38;5;109m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;28m\u2591\u2591\u2591\u2591\u001b[3C\u2591\u2591\u2591\u2591\u2591\u2591\u001b[7C\u001b[38;5;29m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[2C\u2591\u2591\u001b[10C\u2591\u2591\u2591\u2591\u2591\u2591\u001b[30C\u001b[38;5;28m\u2591\u2591\u001b[2C\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\r\n\u001b[38;5;29m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[24C\u001b[38;5;109m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;28m\u2591\u2591\u2591\u2591\u001b[3C\u2591\u2591\u2591\u2591\u2591\u2591\u001b[7C\u001b[38;5;29m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[2C\u2591\u2591\u001b[10C\u2591\u2591\u2591\u2591\u2591\u2591\u001b[30C\u001b[38;5;28m\u2591\u2591\u001b[2C\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\r\n\u001b[38;5;29m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[24C\u001b[38;5;109m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;28m\u2591\u2591\u2591\u2591\u001b[3C\u2591\u2591\u2591\u2591\u2591\u001b(B\u001b[m\u001b[38;5;28m\u2591\u001b[7C\u001b[38;5;29m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[2C\u2591\u2591\u001b[10C\u2591\u2591\u2591\u2591\u2591\u2591\u001b[30C\u001b[38;5;28m\u2591\u2591\u001b[2C\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\r\n\u001b[38;5;29m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[24C\u001b