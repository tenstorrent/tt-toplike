[2.112512, "o", "\u001b[38;5;41m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u001b[10C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[6C\u001b[38;5;152m\u2593\u2593\u2593\u001b[30C\u001b[38;5;41m\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u001b[11;101H\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u001b[10C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[3C\u001b[38;5;152m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[30C\u001b[38;5;41m\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u001b[12;101H\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u001b[10C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[3C\u001b[38;5;152m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[30C\u001b[38;5;41m\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u001b[13;101H\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u001b[10C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[3C\u001b[38;5;152m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[30C\u001b[38;5;41m\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u001b[14;101H\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u001b[10C\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[3C\u001b[38;5;152m\u2593\u2593\u2593\u2593\u2593\u2593\u001b[30C\u001b[38;5;41m\u2593\u2593\u2593\u2593\u001b[2C\u2593\u2593\u2593\u2593\u2593\u001b[15;15H\u001b[38;5;188m\u2593\u2593\u2593\u2593\u2593\u259