[12.992456, "o", "\u001b[31;159H\u001b[38;5;183m\u001b[48;5;16m\u001b[1m\u2554\u2550 EXPLAIN \u001b(B\u001b[m\u001b[38;5;23m\u001b[48;5;16m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[32;159H\u2551 \u001b[38;5;188mModel-Loading Defrag Display\u001b[38;5;59m\u2591\u2591\u001b[38;5;17m\u2591\u2591\u001b[38;5;59m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m \u001b[33;159H\u001b[38;5;23m\u2551 \u001b[38;5;54m\u2591\u001b[38;5;53m\u2591\u2591\u2591\u2591\u2591\u001b[38;5;55m\u2593\u2593\u001b[38;5;53m\u2591\u2591\u001b[38;5;55m\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u001b[38;5;17m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[38;5;59m\u2591\u2591\u2591\u2591\u001b[38;5;17m\u2591\u2591\u001b[38;5;59m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[39m \u001b[34;159H\u001b[38;5;23m\u2551 \u001b[38;5;188mInspired by classic disk defragmenters.\u001b[39m \u001b[35;159H\u001b[38;5;23m\u2551 \u001b[38;5;188mEach row represents one GDDR channel.\u001b[38;5;53m\u2591\u2591\u001b[39m \u001b[36;159H\u001b[38;5;23m\u2551 \u001b[38;5;188mCells fill left-to-right as model weight\u001b[37;159H\u001b[38;5;23m\u2551 \u001b[38;5;188mare tran\u001b(B\u001b[m\u001b[38;5;188m\u001b[48;5;16msferred into device memory.\u001b[38;5;90m\u2591\u001b[38;5;53m\u2591\u2591\u2591\u001b[39m \u001b[38;159H\u001b[38;5;23m\u2551 \u001b[38;5;53m\u2591\u2591\u001b[38;5;90m\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u001b[38;5;53m\u2591\u001b[38;5;90m\u2591\u001b[38;5;127m\u2592\u001b[38;5;90m\u2591\u001b[38;5;53m\u2591\u2591\u2591\u001b[39m \u001b[39;159H\u001b[38;5;23m\u2551 \u001b[38;5;188m\u2591 empty     \u2592 loading    \u2593\u2588 resident\u001b[38;5;53m\u2591\u2591\u2591\u001b[39m \u001b[40;159H\u001b[38;5;23m\u2551 \u001b[38;5;126m\u2593\u2593\u001b[38;5;89m\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[38;5;126m\u2592\u001b[38;5;89m\u2591\u2591\u2591\u2591\u2591\u001b[39m \u001b[41;159H\u001b[38;5;23m\u2551 \u001b[38;5;188mEVICT flashes when the runtime unloads\u001b[38;5;59m\u2591\u001b[39m \u001b[42;159H\u001b[38;5;23m\u2551 \u001b[38;5;188ma model \u2014 triggered when inference power\u001b[43;159H\u001b[38;5;23m\u2551 \u001b[38;5;188msurges above the rolling baseline.\u001b[38;5;89m\u2591\u2591\u2591\u2591\u001b[38;5;59m\u2591\u001b[39m \u001b[44;159H\u001b[38;5;23m\u2551 \u001b[38;5;89m\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[38;5;126m\u2592\u001b[38;5;89m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[38;5;59m\u2591\u001b[39m \u001b[45;159H\u001b[38;5;23m\u2551 \u001b[38;5;188mBlock character intensity (\u2591\u2592\u2593\u2588) encodes\u001b[46;159H\u001b[38;5;23m\u2551 \u001b[38;5;188mrelative activity within each cell.\u001b[39m     \u001b[47;159H\u001b[38;5;23m\u2551 \u001b[38;5;188mColor encodes channel temperature.\u001b[39m      \u001b[48;159H\u001b[38;5;23m\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b(B\u001b[m"]
