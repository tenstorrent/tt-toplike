[12.399407, "o", "\u001b[7C\u001b[38;5;48m∘\u001b[28C∘\u001b[38;5;34m◆\u001b[6C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[26C\u001b[38;5;47m∘\u001b[6C\u001b[39m \u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m○\u001b[C\u001b[38;5;25m◆\u001b[22;69H\u001b[39m \u001b[48C \u001b[23;61H\u001b[38;5;34m·\u001b[48C·\u001b[48C·\u001b[24;11H\u001b[38;5;50m∘\u001b[4C\u001b[38;5;55m◇\u001b[16C\u001b[38;5;45m○\u001b[27C\u001b[39m \u001b[8C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m○\u001b[5C\u001b[38;5;70m◇\u001b[25C\u001b[39m \u001b[22C\u001b[38;5;70m◇\u001b[3C\u001b[38;5;33m∘\u001b[20C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[C○\u001b[5C\u001b[38;5;39m∘\u001b[C\u001b[38;5;70m◇\u001b[5C\u001b[38;5;33m∘\u001b[25;16H\u001b[39m \u001b[26;35H \u001b[27;15H\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m○\u001b[3C\u001b[38;5;70m◇\u001b[24C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[5C∘\u001b[C\u001b[38;5;21m∘\u001b[22C\u001b[38;5;27m∘\u001b[21C\u001b[38;5;57m∘\u001b[C∘\u001b[32C\u001b[38;5;21m∘\u001b[15C\u001b[38;5;57m∘\u001b[28;88H\u001b[38;5;91m·\u001b[48C·\u001b[29;80H\u001b[39m \u001b[48C \u001b[30;13H\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m∘\u001b[44C\u001b[38;5;127m◆\u001b[7C\u001b[38;5;129m∘\u001b[22C\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m○\u001b[3C\u001b[38;5;127m◆\u001b[3C\u001b[38;5;201m∘\u001b[33C\u001b[38;5;130m◆\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[C∘\u001b[31;61H\u001b[38;5;106m·\u001b[39m \u001b[7C\u001b[38;5;130m◆\u001b[39m \u001b[38C\u001b[38;5;106m·\u001b[39m \u001b[7C\u001b[38;5;130m◆\u001b[39m \u001b[47C \u001b[8C\u001b[38;5;127m◆\u001b[3C\u001b[39m \u001b[32;180H\u001b[38;5;34m◇\u001b[33;11H\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[22C\u001b[38;5;165m∘\u001b[50C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[13C\u001b[38;5;197m∘\u001b[28C\u001b[38;5;25m◇\u001b[13C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b