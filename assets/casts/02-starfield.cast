[3.597501, "o", "\u001b[7C\u001b[38;5;196m∘\u001b[36C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m○\u001b[13C\u001b[38;5;196m∘\u001b[22C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[13C\u001b[38;5;202m∘\u001b[28C\u001b[38;5;197m∘\u001b[5C\u001b[38;5;124m◆\u001b[8C\u001b[38;5;55m◆\u001b[38;5;196m∘\u001b[5C\u001b[38;5;202m∘\u001b[31;12H\u001b[38;5;34m·\u001b[39m \u001b[146C\u001b[38;5;34m·\u001b[7C\u001b[39m \u001b[32;160H \u001b[33;19H\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[13C\u001b[38;5;226m∘\u001b[30C\u001b[38;5;202m∘\u001b[36C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[13C\u001b[38;5;226m∘\u001b[28C\u001b[38;5;208m∘\u001b[5C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[34;36H\u001b[38;5;124m·\u001b[39m \u001b[35;27H\u001b[38;5;37m◇\u001b[49C◇\u001b[39m \u001b[47C\u001b[38;5;37m◇\u001b[39m \u001b[47C\u001b[38;5;37m◇\u001b[39m \u001b[36;17H\u001b[38;5;106m·\u001b[13C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[22C\u001b[38;5;220m∘\u001b[21C\u001b[38;5;190m∘\u001b[28C∘\u001b[7C\u001b[38;5;154m○\u001b[7C\u001b[38;5;118m∘\u001b[34C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[37;17H\u001b[39m \u001b[38;31H \u001b[146C\u001b[38;5;130m·\u001b[39m \u001b[39;21H\u001b[38;5;46m∘\u001b[C\u001b[38;5;142m·\u001b[39m \u001b[6C\u001b[38;5;130m·\u001b[5C\u001b[38;5;47m∘\u001b[28C\u001b[38;5;118m∘\u001b[6C\u001b[38;5;142m·\u001b[38;5;82m∘\u001b[36C\u001b[38;5;46m∘\u001b[10C\u001b[38;5;142m·\u001b[38;5;46m∘\u001b[3C\u001b[38;5;47m∘\u001b[34C\u001b[38;5;46m∘\u001b[8C\u001b[38;5;142m·\u001b[38;5;46m∘\u001b[11C\u001b[38;5;48m∘\u001b[42;19H\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[28C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[13C\u001b[38;5;50m∘\u001b[22C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[21C\u001b[38;5;45m∘\u001b[20C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[45;17H\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[22C\u001b[38