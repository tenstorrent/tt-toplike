[3.682449, "o", "\u001b[38;5;208m∘\u001b[42C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[31;61H\u001b[39m \u001b[16C\u001b[38;5;91m◆\u001b[39m \u001b[3C \u001b[26C \u001b[16C\u001b[38;5;91m◆\u001b[39m \u001b[3C \u001b[43C \u001b[4C \u001b[32;82H\u001b[38;5;34m◇\u001b[48C◇\u001b[44C\u001b[38;5;91m◆\u001b[3C\u001b[38;5;34m◇\u001b[33;27H\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[28C\u001b[38;5;202m∘\u001b[3C\u001b[38;5;25m◇\u001b[9C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[22C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;25m◇\u001b[5C\u001b[38;5;226m∘\u001b[42C\u001b[38;5;25m◇\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[34;69H\u001b[39m \u001b[48C \u001b[48C \u001b[15C \u001b[35;16H\u001b[38;5;70m·\u001b[18C\u001b[38;5;124m·\u001b[39m \u001b[146C\u001b[38;5;124m·\u001b[36;16H\u001b[39m \u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[22C\u001b[38;5;226m∘\u001b[9C∘\u001b[3C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[28C∘\u001b[7C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[33C\u001b[38;5;70m·\u001b[38;5;154m∘\u001b[5C∘\u001b[7C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[39;15H∘\u001b[13C\u001b[38;5;136m·\u001b[7C\u001b[38;5;48m∘\u001b[28C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[4C\u001b[38;5;136m·\u001b[38;5;46m∘\u001b[7C\u001b[38;5;47m∘\u001b[30C∘\u001b[7C\u001b[38;5;48m∘\u001b[38;5;136m·\u001b[38;5;48m∘\u001b[3C\u001b[38;5;49m∘\u001b[42C\u001b[38;5;48m∘\u001b[38;5;136m·\u001b[6C\u001b[38;5;49m∘\u001b[42;13H∘\u001b[13C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[22C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[22C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[48C∘\u001b[45;17H∘\u001b[7C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[28C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[36C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[34C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b(B\u0