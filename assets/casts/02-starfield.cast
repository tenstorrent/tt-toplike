[13.630153, "o", "\u001b[6;13H\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[30C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[50C\u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[20C\u001b[38;5;226m∘\u001b[21C\u001b[38;5;154m∘\u001b[9;11H∘\u001b[13C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[36C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[28C∘\u001b[21C\u001b[38;5;47m∘\u001b[20C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[21C\u001b[38;5;47m∘\u001b[12;15H∘\u001b[4C\u001b[38;5;19m·\u001b[2C\u001b[38;5;48m∘\u001b[3C∘\u001b[38;5;91m·\u001b[2C\u001b[38;5;49m∘\u001b[41C\u001b[39m \u001b[38;5;91m·\u001b[C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[28C∘\u001b[8C\u001b[39m \u001b[38;5;91m·\u001b[3C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[34C\u001b[38;5;49m∘\u001b[C\u001b[38;5;91m·\u001b[5C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[13;20H\u001b[39m \u001b[59C \u001b[38;5;127m·\u001b[47C\u001b[39m \u001b[38;5;127m·\u001b[14;34H\u001b[39m \u001b[31C \u001b[38;5;19m·\u001b[47C\u001b[39m \u001b[38;5;19m·\u001b[15;13H\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[6C\u001b[38;5;127m·\u001b[38;5;39m○\u001b[30C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[28C∘\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[5C\u001b[38;5;27m∘\u001b[28C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[16;23H\u001b[39m \u001b[38;5;127m◇\u001b[143C◇\u001b[6C\u001b[39m \u001b[38;5;125m◇\u001b[17;14H\u001b[39m \u001b[38;5;25m·\u001b[70C\u001b[39m \u001b[48C \u001b[32C \u001b[18;11H\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[7C○\u001b[C∘\u001b[5C\u001b[38;5;57m∘\u001b[22C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;125m·\u001b[28C\u001b[38;5;21m∘\u001b[19C\u001b[38;5;125m·\u001b[C\u001b[38;5;93m∘\u001b[20C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[13C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[19;62H\u001b[38;5;25m·\u001b[48C·\u001b[20;38H\u001b[39m \u