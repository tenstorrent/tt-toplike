[3.393902, "o", "\u001b[6;13H\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[36C\u001b[38;5;200m∘\u001b[13C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[22C\u001b[38;5;198m∘\u001b[13C\u001b[38;5;196m∘\u001b[34C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[9;19H\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[5C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[36C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[22C\u001b[38;5;202m∘\u001b[13C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[18C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[12;17H∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[28C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[44C\u001b[38;5;118m∘\u001b[41C\u001b[39m \u001b[38;5;19m·\u001b[7C\u001b[38;5;118m∘\u001b[14;17H\u001b[39m \u001b[38;5;37m·\u001b[15;21H\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[3C○\u001b[31C\u001b[39m \u001b[38;5;37m·\u001b[7C\u001b[38;5;118m∘\u001b[5C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[22C\u001b[38;5;82m∘\u001b[2C\u001b[39m \u001b[38;5;37m·\u001b[3C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[29C\u001b[39m \u001b[38;5;37m·\u001b[3C\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m∘\u001b[16;85H\u001b[39m \u001b[48C \u001b[48C \u001b[17;20H \u001b[38;5;125m◇\u001b[15C\u001b[39m \u001b[31C\u001b[38;5;125m◇\u001b[15C\u001b[38;5;55m·\u001b[32C\u001b[38;5;125m◇\u001b[15C\u001b[38;5;55m·\u001b[32C\u001b[38;5;125m◇\u001b[15C\u001b[38;5;55m·\u001b[18;19H\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[9C\u001b[38;5;55m·\u001b[3C\u001b[38;5;51m∘\u001b[26C\u001b[38;5;46m∘\u001b[9C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[22C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[34C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[19;82H\u001b[39m \u001b[48C \u001b[48C \u001b[20;34H \u001b[48C\u001b[38;5;142m◇\u001b[48C