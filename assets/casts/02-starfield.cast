[13.714144, "o", "\u001b[6;13H\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[30C\u001b[38;5;220m∘\u001b[21C\u001b[38;5;190m∘\u001b[28C∘\u001b[7C\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[28C\u001b[38;5;190m∘\u001b[9;11H\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m∘\u001b[28C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[36C\u001b[38;5;46m∘\u001b[21C\u001b[38;5;48m∘\u001b[20C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[12;22H\u001b[38;5;55m·\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[36C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[13C\u001b[38;5;50m∘\u001b[22C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[42C\u001b[38;5;49m∘\u001b[8C\u001b[39m \u001b[38;5;91m·\u001b[3C\u001b[38;5;51m○\u001b[13;68H\u001b[38;5;55m·\u001b[13C\u001b[39m \u001b[34C\u001b[38;5;55m·\u001b[13C\u001b[39m \u001b[34C \u001b[38;5;55m·\u001b[14;82H\u001b[38;5;126m·\u001b[48C·\u001b[15;21H\u001b[38;5;45m∘\u001b[11C\u001b[38;5;39m○\u001b[C\u001b[38;5;33m∘\u001b[30C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b(B\u001b[m\u001b[28C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[26C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[16;15H\u001b[39m \u001b[38;5;19m·\u001b[18C\u001b[38;5;126m·\u001b[133C\u001b[39m \u001b[38;5;127m◇\u001b[18;11H\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[13C\u001b[38;5;57m○\u001b[7C\u001b[38;5;93m∘\u001b[20C\u001b[38;5;39m∘\u001b[38;5;19m·\u001b[38;5;33m∘\u001b[5C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[32C∘\u001b[38;5;19m·\u001b[10C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[5C\u001b[38;5;129m∘\u001b[20C\u001b[38;5;21m∘\u001b[15C\u001b[38;5;57m∘\u001b[3C∘\u001b[9C\u001b[38;5;129m∘\u001b[19;26H\u001b[39m \u001b[38;5;142m◆\u001b[43C\u001b[39m \u001b[38;5;142m◆\u001b[47C\u001b[39m \u001b[38;5;142m◆\u001b[63C\u001b[39m \u001b[20;185H\u001b[38;5;124m·\u001b[21;23H\u