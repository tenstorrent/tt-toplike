[9.953832, "o", "\u001b[38;5;201m∘\u001b[28C\u001b[38;5;93m∘\u001b[C\u001b[38;5;91m◆\u001b[19C\u001b[38;5;201m∘\u001b[25;88H\u001b[38;5;70m·\u001b[48C·\u001b[28C\u001b[39m \u001b[26;68H\u001b[38;5;91m◆\u001b[48C◆\u001b[61C\u001b[39m \u001b[6C\u001b[38;5;70m·\u001b[27;15H\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[30C\u001b[38;5;129m∘\u001b[13C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[36C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[34C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[2C\u001b[38;5;70m◆\u001b[4C\u001b[38;5;198m∘\u001b[28;32H\u001b[39m \u001b[6C\u001b[38;5;70m·\u001b[29;32H◆\u001b[130C\u001b[38;5;124m◇\u001b[30;11H\u001b[38;5;198m∘\u001b[38;5;19m·\u001b[38;5;198m∘\u001b[5C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[13C\u001b[38;5;202m∘\u001b[22C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[9C\u001b[38;5;197m∘\u001b[3C\u001b[38;5;196m∘\u001b[22C\u001b[38;5;197m∘\u001b[21C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[23C\u001b[39m \u001b[2C\u001b[38;5;196m∘\u001b[15C\u001b[38;5;202m∘\u001b[31;12H\u001b[39m \u001b[32;22H\u001b[38;5;37m◆\u001b[39m \u001b[147C\u001b[38;5;37m◆\u001b[39m \u001b[33;17H\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[30C\u001b[38;5;202m∘\u001b[13C\u001b[38;5;214m∘\u001b[28C∘\u001b[7C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m○\u001b[34C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m○\u001b[11C\u001b[38;5;34m·\u001b[39m \u001b[35;176H\u001b[38;5;55m◇\u001b[39m \u001b[36;17H\u001b[38;5;25m·\u001b[3C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[22C\u001b[38;5;220m∘\u001b[19C\u001b[38;5;226m∘\u001b[C\u001b[38;5;190m∘\u001b[28C∘\u001b[7C\u001b[38;5;154m∘\u001b[9C\u001b[38;5;118m∘\u001b[3C\u001b[38;5;82m∘\u001b[28C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m○\u001b[5C\u001b[38;5;118m○\u001b[7C\u001b[38;5;82m∘\u001b[37;165H\u001b[38;5;25m·\u001b[38;68H·\u001b[48C·\u001b[47C\u001b[39m \u001b[39;19H\u001b[38;5;46m∘\u001b[7C○\u001b[2C\u001b[38;5;35m·\u00