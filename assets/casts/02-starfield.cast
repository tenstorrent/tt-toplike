[13.242222, "o", "\u001b[6;17H\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[44C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[28C∘\u001b[13C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[20C\u001b[38;5;202m∘\u001b[13C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[9;15H∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[22C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[28C∘\u001b[7C\u001b[38;5;154m∘\u001b[42C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[12;13H\u001b[38;5;118m∘\u001b[8C\u001b[39m \u001b[38;5;19m·\u001b[3C\u001b[38;5;46m∘\u001b[38C\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[20C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[21C\u001b[38;5;48m∘\u001b[20C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[13;68H\u001b[39m \u001b[38;5;19m·\u001b[47C\u001b[39m \u001b[38;5;19m·\u001b[14;82H\u001b[39m \u001b[38;5;91m·\u001b[47C\u001b[39m \u001b[38;5;91m·\u001b[48C\u001b[38;5;127m·\u001b[15;11H\u001b[38;5;47m∘\u001b[9C\u001b(B\u001b[m\u001b[38;5;48m∘\u001b[3C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[28C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[28C∘\u001b[13C\u001b[38;5;51m∘\u001b[28C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[16;36H\u001b[38;5;127m·\u001b[17;63H\u001b[38;5;31m·\u001b[15C\u001b[39m \u001b[38;5;124m◇\u001b[31C\u001b[38;5;31m·\u001b[15C\u001b[39m \u001b[38;5;124m◇\u001b[18;23H\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[25C\u001b[39m \u001b[4C\u001b[38;5;51m∘\u001b[21C\u001b[38;5;39m∘\u001b[21C\u001b[39m \u001b[6C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[26C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[19;29H\u001b[39m \u001b[57C \u001b[48C \u001b[36C \u001b[38;5;34m◆\u001b[20;29H◆\u001b[36C\u001b[38;5;55m◇\u00