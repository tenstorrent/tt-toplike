[4.021054, "o", "\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m○\u001b[13C\u001b[38;5;200m∘\u001b[28C∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[34C\u001b[38;5;200m∘\u001b[13C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[27;16H\u001b[38;5;19m◇\u001b[38;5;197m∘\u001b[44C\u001b[38;5;199m∘\u001b[13C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[28C∘\u001b[15C\u001b[38;5;202m∘\u001b[34C\u001b[38;5;196m∘\u001b[13C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[28;16H\u001b[39m \u001b[162C \u001b[29;31H \u001b[147C\u001b[38;5;25m◆\u001b[30;15H\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m○\u001b[C\u001b[38;5;25m◆\u001b[5C\u001b[38;5;226m∘\u001b[28C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[38;5;34m◇\u001b[38;5;214m∘\u001b[26C∘\u001b[7C\u001b[38;5;220m∘\u001b[12C\u001b[38;5;34m◇\u001b[38;5;226m∘\u001b[34C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[4C\u001b[38;5;34m◇\u001b[38;5;226m∘\u001b[31;21H\u001b[38;5;127m◆\u001b[39m \u001b[32;169H\u001b[38;5;127m◆\u001b[39m \u001b[33;19H\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[22C\u001b[38;5;226m∘\u001b[44C\u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[26C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[34;70H\u001b[38;5;31m◇\u001b[48C◇\u001b[48C◇\u001b[35;27H\u001b[38;5;35m◇\u001b[39m \u001b[41C \u001b[48C \u001b[48C \u001b[36;17H\u001b[38;5;46m∘\u001b[21C\u001b[38;5;48m∘\u001b[22C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[44C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[42C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[39;15H∘\u001b[13C\u001b[38;5;51m∘\u001b[30C\u001b[38;5;47m∘\u001b[21C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[20C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[28C\u001b[38;5;50m∘\u001b[21C\u001b[38;5;45m∘\u001b[42;19H\u001b[38;5;39m∘\u001b[5C○\u001b[C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[30