[12.074309, "o", "\u001b[6;31H\u001b[38;5;57m∘\u001b[30C\u001b[38;5;33m∘\u001b[5C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[44C\u001b[38;5;57m∘\u001b[13C\u001b[38;5;129m∘\u001b[34C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[9;13H∘\u001b[7C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[36C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[28C∘\u001b[7C\u001b[38;5;201m∘\u001b[3C∘\u001b[9C\u001b[38;5;200m∘\u001b[34C\u001b[38;5;201m∘\u001b[12;11H\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[13C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[44C\u001b[38;5;198m∘\u001b[28C∘\u001b[7C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[26C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[13C\u001b[38;5;196m∘\u001b[15;23H\u001b[38;5;202m∘\u001b[C○\u001b[5C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[22C\u001b[38;5;197m∘\u001b[2C\u001b[38;5;34m·\u001b[18C\u001b[38;5;202m∘\u001b[28C∘\u001b[38;5;34m·\u001b[6C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[28C\u001b[38;5;202m∘\u001b[13C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[16;28H\u001b[39m \u001b[38;5;130m◇\u001b[35C\u001b[39m \u001b[18C \u001b[38;5;25m·\u001b[28C\u001b[39m \u001b[18C \u001b[38;5;25m·\u001b[48C·\u001b[18;19H\u001b[38;5;220m○\u001b[C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[C\u001b[38;5;25m·\u001b[22C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[28C∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[28C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[19;13H\u001b[38;5;70m·\u001b[157C\u001b[39m \u001b[38;5;37m◆\u001b[21;11H\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m○\u001b[13C\u001b[38;5;46m∘\u001b[30C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[22C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m∘\u001b[18C\u001b[38;5;118m∘\u001b[38;5;70m·\u001b[6C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[22;16H\u001