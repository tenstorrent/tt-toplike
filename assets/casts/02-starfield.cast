[2.278773, "o", "\u001b[38;5;35m◇\u001b[27;13H\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[C∘\u001b[11C\u001b[38;5;51m∘\u001b[30C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m○\u001b[7C\u001b[38;5;50m∘\u001b[22C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[20C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[30;17H\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[30C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[36C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[20C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[32;33H\u001b[39m \u001b[33;15H\u001b[38;5;21m∘\u001b[2C\u001b[38;5;91m◇\u001b[38;5;21m∘\u001b[C∘\u001b[9C\u001b[38;5;57m∘\u001b[C\u001b[38;5;37m◇\u001b[26C\u001b[38;5;33m∘\u001b[15C\u001b[38;5;21m∘\u001b[13C\u001b[38;5;57m∘\u001b[30C∘\u001b[13C\u001b[38;5;129m∘\u001b[34C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[34;85H\u001b[39m \u001b[48C \u001b[35;16H\u001b[38;5;124m·\u001b[8C\u001b[38;5;19m◇\u001b[39m \u001b[8C\u001b[38;5;55m·\u001b[39m \u001b[48C\u001b[38;5;55m·\u001b[48C·\u001b[36;13H\u001b[38;5;129m∘\u001b[2C\u001b[39m \u001b[4C\u001b[38;5;165m∘\u001b[43C\u001b[38;5;124m·\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[22C\u001b[38;5;165m∘\u001b[2C\u001b[38;5;124m·\u001b[38;5;165m∘\u001b[17C\u001b[38;5;200m∘\u001b[34C\u001b[38;5;201m∘\u001b[39;11H\u001b[38;5;200m∘\u001b[13C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[28C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[28C∘\u001b[7C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[26C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[13C\u001b[38;5;196m∘\u001b[42;23H\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[36C\u001b[38;5;196m∘\u001b[15C\u001b[38;5;202m∘\u001b[28C∘\u001b[7C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[28C\u001b[