[9.81705, "o", "\u001b[6;13H\u001b[38;5;198m∘\u001b[13C\u001b[38;5;196m∘\u001b[38C\u001b[38;5;199m∘\u001b[5C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[20C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[15C\u001b[38;5;202m∘\u001b[5C\u001b[38;5;208m∘\u001b[20C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[13C\u001b[38;5;202m∘\u001b[9;11H∘\u001b[13C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[28C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[28C∘\u001b[7C\u001b[38;5;220m∘\u001b[5C\u001b[38;5;226m∘\u001b[28C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[C∘\u001b[5C\u001b[38;5;226m∘\u001b[12;23H\u001b[38;5;190m∘\u001b[C○\u001b[38;5;125m·\u001b[2C\u001b[38;5;190m○\u001b[7C\u001b[38;5;118m∘\u001b[22C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[22C\u001b[38;5;190m∘\u001b[5C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[26C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[38;5;125m·\u001b[5C\u001b[39m \u001b[38;5;118m∘\u001b[5C\u001b[38;5;82m∘\u001b[13;18H\u001b[39m \u001b[38;5;127m·\u001b[12C\u001b[39m \u001b[38;5;124m·\u001b[144C·\u001b[14;164H\u001b[38;5;127m·\u001b[15;13H\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[3C∘\u001b[9C\u001b[38;5;47m∘\u001b[30C\u001b[38;5;118m∘\u001b[5C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[28C∘\u001b[C∘\u001b[13C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[5C\u001b[38;5;49m∘\u001b[20C\u001b[38;5;46m∘\u001b[3C∘\u001b[17C\u001b[38;5;48m∘\u001b[16;21H\u001b[39m \u001b[38;5;106m◇\u001b[17;167H◇\u001b[15C\u001b[39m \u001b[38;5;136m·\u001b[18;11H\u001b[38;5;48m∘\u001b[C\u001b[38;5;91m·\u001b[5C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[4C\u001b[39m \u001b[25C\u001b[38;5;47m∘\u001b[5C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[28C∘\u001b[7C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[20C\u001b[38;5;49m∘\u001b[5C○\