[13.94851, "o", "\u001b[6;15H\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[30C\u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[20C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[34C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[9;27H\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[44C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[20C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[20C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[C○\u001b[5C\u001b[38;5;50m∘\u001b[12;17H\u001b[38;5;51m∘\u001b[7C∘\u001b[38;5;127m·\u001b[12C\u001b[38;5;39m∘\u001b[30C\u001b[38;5;50m∘\u001b[39m \u001b[38;5;127m·\u001b[5C\u001b[38;5;51m∘\u001b[41C\u001b[39m \u001b[38;5;127m·\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[20C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[4C\u001b[39m \u001b[38;5;126m·\u001b[7C\u001b[38;5;33m∘\u001b[13;18H\u001b[39m \u001b[38;5;55m·\u001b[12C\u001b[39m \n\u001b[38;5;126m·\u001b[15;15H\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[36C\u001b[38;5;45m∘\u001b(B\u001b[m"]
[13.948644, "o", "\u001b[7C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[28C∘\u001b[15C\u001b[38;5;57m∘\u001b[26C\u001b[38;5;27m∘\u001b[39m \u001b[38;5;55m·\u001b[5C\u001b[38;5;21m○\u001b[5C∘\u001b[7C\u001b[38;5;57m∘\u001b[16;21H\u001b[39m \u001b[38;5;55m◇\u001b[150C\u001b[39m \u001b[38;5;127m◇\u001b[8C\u001b[39m \u001b[17;183H\u001b[38;5;124m·\u001b[18;13H\u001b[38;5;57m∘\u001b[38;5;19m·\u001b[6C\u001b[38;5;93m∘\u001b[5C\u001b[38;5;129m∘\u001b[3C∘\u001b[3C\u001b[38;5;165m∘\u001b[2C\u001b[39m \u001b[41C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[36C\u001b[38;5;165m∘\u001b[34C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m○\u001b[13C\u001b[38;5;201m∘\u001b[19;13H\u001b[39m \u001b[24C\u001b[38;5;124m·\u001b[20;159H\u001b[38;5;19m·\u001b[21;11H\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m○\u001b[7C\u001b[38;5;199m∘\u001b[C∘\u001b[28C\u001b[38;5;165m∘\u001b[50C\u001b[38;5;200m∘\u001b[13C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[21C\u001b[39m \u001b[4C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[22;35H\u001b[38;5;124m◇\u001b[52C\u001b[39m \u001b[48C \u001b[23;88H\u001b[38;5;130m·\u001b[48C·\u001b[24;15H\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m○\u001b[13C\u001b[38;5;202m∘\u001b[22C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;124m◆\u001b[7C\u001b[38;5;197m∘\u001b[36C\u001b[38;5;196m∘\u001b[3C\u001b[38;5;124m◆\u001b[7C\u001b[38;5;196m∘\u001b[C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[26C\u001b[38;5;196m∘\u001b[38;5;25m◇\u001b[14C\u001b[38;5;202m∘\u001b[25;12H\u001b[38;5;31m·\u001b[26C\u001b[39m \u001b[123C \u001b[26;12H \u001b[26C\u001b[38;5;130m·\u001b[142C\u001b[39m \u001b[27;13H\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m○\u001b[13C\u001b[38;5;226m∘\u001b[30C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[5C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[28C∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[20C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[13C\u001b[38;5;136m◇\u001b[28;61H\u