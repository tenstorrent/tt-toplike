[7.897512, "o", "\u001b[6;11H\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[22C\u001b[38;5;82m∘\u001b[21C\u001b[38;5;47m∘\u001b[28C∘\u001b[7C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[34C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[13C\u001b[38;5;50m∘\u001b[9;17H∘\u001b[7C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[22C\u001b[38;5;48m∘\u001b[5C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[28C∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[28C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[12;21H\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[28C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[22C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[36C\u001b[38;5;33m∘\u001b[5C\u001b[38;5;27m∘\u001b[14;17H\u001b[38;5;36m·\u001b[15;19H\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m∘\u001b[22C\u001b[38;5;21m∘\u001b[19C\u001b[38;5;57m∘\u001b[C\u001b[38;5;93m∘\u001b[22C\u001b[38;5;57m∘\u001b[13C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[C∘\u001b[29C\u001b[38;5;36m·\u001b[2C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[16;27H\u001b[38;5;31m◇\u001b[36C\u001b[39m \u001b[38;5;36m·\u001b[8C\u001b[39m \u001b[38;5;31m◇\u001b[8C\u001b[38;5;19m·\u001b[28C\u001b[39m \u001b[38;5;36m·\u001b[8C\u001b[39m \u001b[38;5;31m◇\u001b[8C\u001b[38;5;19m·\u001b[29C\u001b[39m \u001b[8C \u001b[38;5;31m◇\u001b[8C\u001b[39m \u001b[38;5;19m·\u001b[18;17H\u001b[38;5;201m∘\u001b[5C○\u001b[7C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[22C\u001b[38;5;129m∘\u001b[4C\u001b[38;5;35m◇\u001b[8C\u001b[38;5;201m∘\u001b[4C\u001b[39m \u001b[38;5;19m◇\u001b[33C\u001b[38;5;35m◇\u001b[4C\u001b[38;5;200m∘\u001b[8C\u001b[39m \u001b[38;5;19m◇\u001b[3C\u001b[38;5;198m∘\u001b[29C\u001b[38;5;35m◇\u001b[12C\u001b[38;5;199m∘\u001b[39m \u001b[38;5;19m◇\u001b[3C\u001b[38;5;199m∘\u001b[C\u001b[38;5;198m∘\u001b[19;67H\