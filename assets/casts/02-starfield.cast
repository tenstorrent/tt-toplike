[9.936737, "o", "\u001b[6;17H\u001b[38;5;196m∘\u001b[21C\u001b[38;5;208m∘\u001b[22C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[50C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[34C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[9;15H\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[C∘\u001b[34C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[28C∘\u001b[13C\u001b[38;5;190m∘\u001b[28C\u001b[38;5;220m∘\u001b[3C○\u001b[3C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[12;13H∘\u001b[6C\u001b[38;5;126m·\u001b[6C\u001b[38;5;118m∘\u001b[38;5;124m·\u001b[6C\u001b[38;5;82m∘\u001b[36C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[20C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[28C\u001b[38;5;154m∘\u001b[5C∘\u001b[5C\u001b[38;5;118m∘\u001b[38;5;124m·\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[13;20H\u001b[39m \u001b[145C\u001b[38;5;126m·\u001b[12C\u001b[39m \u001b[38;5;130m·\u001b[14;34H\u001b[39m \u001b[130C \u001b[15;25H\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[38;5;130m·\u001b[27C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[44C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[26C\u001b[38;5;46m○\u001b[7C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[16;23H\u001b[39m \u001b[38;5;106m◇\u001b[45C◇\u001b[48C◇\u001b[17;14H\u001b[39m \u001b[38;5;127m·\u001b[54C\u001b[39m \u001b[48C \u001b[18;15H\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[22C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[36C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[32C\u001b[38;5;127m·\u001b[3C\u001b[38;5;51m∘\u001b[19C\u001b[38;5;39m∘\u001b[19;160H\u001b[39m \u001b[24C\u001b[38;5;142m·\u001b[20;38H\u001b[39m \u001b[38;5;142m·\u001b[21;13H\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[36C\u001b[38;5;39m∘\u001b[7C\