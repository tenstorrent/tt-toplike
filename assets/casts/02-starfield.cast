[10.857115, "o", "\u001b[6;11H\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[21C\u001b[38;5;47m∘\u001b[22C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[28C∘\u001b[15C\u001b[38;5;47m∘\u001b[26C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[21C\u001b[38;5;48m∘\u001b[9;17H∘\u001b[13C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[30C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[28C∘\u001b[7C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[34C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[12;28H\u001b[38;5;106m·\u001b[38;5;39m∘\u001b[30C\u001b[38;5;50m∘\u001b[13C\u001b[38;5;106m·\u001b[7C\u001b[38;5;45m∘\u001b[28C∘\u001b[7C\u001b[38;5;39m∘\u001b[3C\u001b[38;5;106m·\u001b[9C\u001b[38;5;27m∘\u001b[34C\u001b[38;5;39m∘\u001b[4C\u001b[38;5;106m·\u001b[2C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[13;67H\u001b[38;5;136m·\u001b[48C·\u001b[14;67H\u001b[39m \u001b[48C \u001b[15;11H\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[14C\u001b[39m \u001b[38;5;70m·\u001b[5C\u001b[38;5;93m∘\u001b[22C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[36C\u001b[38;5;21m∘\u001b[13C\u001b[38;5;57m∘\u001b(B\u001b[m"]
