[3.580537, "o", "\u001b[27;11H\u001b[38;5;165m∘\u001b[4C\u001b[38;5;55m◇\u001b[4C\u001b[38;5;201m○\u001b[C∘\u001b[9C\u001b[38;5;200m∘\u001b[36C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[50C\u001b[38;5;199m○\u001b[7C\u001b[38;5;198m∘\u001b[20C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[28;16H\u001b[39m \u001b[30;15H\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[36C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[13C\u001b[38;5;197m∘\u001b[38;5;34m◇\u001b[38;5;197m∘\u001b[5C\u001b[38;5;196m∘\u001b[22C\u001b[38;5;197m∘\u001b[18C\u001b[38;5;34m◇\u001b[38;5;196m∘\u001b[C\u001b[38;5;202m∘\u001b[34C\u001b[38;5;196m∘\u001b[10C\u001b[38;5;34m◇\u001b[38;5;196m∘\u001b[3C\u001b[38;5;202m∘\u001b[33;13H∘\u001b[7C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[44C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[22C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[34C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[34;70H\u001b[38;5;25m◇\u001b[48C◇\u001b[48C◇\u001b[35;27H\u001b[38;5;36m◇\u001b[39m \u001b[41C \u001b[48C \u001b[48C \u001b[36;11H\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[28C\u001b[38;5;226m∘\u001b[44C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[28C\u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[39;15H∘\u001b[7C\u001b[38;5;46m∘\u001b[36C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[3C∘\u001b[9C\u001b[38;5;46m∘\u001b[30C∘\u001b[7C∘\u001b[13C\u001b[38;5;48m∘\u001b[34C\u001b[38;5;46m∘\u001b[7C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[42;13H∘\u001b[7C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[36C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[22C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[42C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[45;25H\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\