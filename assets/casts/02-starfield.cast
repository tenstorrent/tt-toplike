[12.787926, "o", "\u001b[6;13H\u001b[38;5;200m∘\u001b[13C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[44C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[28C∘\u001b[7C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[26C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[9;11H\u001b[38;5;196m∘\u001b[13C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[36C\u001b[38;5;196m∘\u001b[15C\u001b[38;5;202m∘\u001b[28C∘\u001b[7C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[28C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[12;15H∘\u001b[6C\u001b[38;5;31m·\u001b[38;5;226m∘\u001b[5C∘\u001b[38;5;25m·\u001b[6C\u001b[38;5;190m∘\u001b[30C\u001b[38;5;214m∘\u001b[6C\u001b[39m \u001b[38;5;25m·\u001b[7C\u001b[38;5;226m∘\u001b[28C∘\u001b[10C\u001b[39m \u001b[38;5;25m·\u001b[C\u001b[38;5;190m○\u001b[7C\u001b[38;5;154m∘\u001b[28C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[15;13H∘\u001b[2C\u001b[38;5;36m·\u001b[4C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[30C\u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[22C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[42C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[16;16H\u001b[39m \u001b[8C \u001b[38;5;125m◇\u001b[8C\u001b[39m \u001b[38;5;19m·\u001b[18;19H\u001b[38;5;127m◇\u001b[11C\u001b[38;5;48m∘\u001b[39m \u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[22C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[22C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[34C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[19;18H\u001b[39m \u001b[14C\u001b[38;5;130m◇\u001b[20;30H\u001b[39m \u001b[21;12H\u001b[38;5;34m·\u001b[7C\u001b[39m \u001b[38;5;142m◆\u001b[8C\u001b[38;5;36m◆\u001b[38;5;45m∘\u001b[30C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m○\u001b[13C\u001b[38;5;45m∘\u001b[30C∘\u001b[13C\u001b[38;5;33m∘\u001b[42C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\