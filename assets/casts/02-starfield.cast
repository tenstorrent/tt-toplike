[8.624001, "o", "\u001b[6;21H\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[28C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[28C∘\u001b[7C\u001b[38;5;27m∘\u001b[42C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[9;19H\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[28C\u001b[38;5;21m∘\u001b[15C\u001b[38;5;57m∘\u001b[28C∘\u001b[7C\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[20C\u001b[38;5;57m∘\u001b[13C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[12;17H\u001b[38;5;201m∘\u001b[10C\u001b[39m \u001b[38;5;55m·\u001b[C\u001b[38;5;200m○\u001b[7C\u001b[38;5;199m∘\u001b[22C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[4C\u001b[39m \u001b[38;5;55m·\u001b[44C\u001b[38;5;200m∘\u001b[2C\u001b[39m \u001b[38;5;55m·\u001b[3C\u001b[38;5;199m∘\u001b[28C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m○\u001b[13C\u001b[38;5;198m∘\u001b[13;166H\u001b[39m \u001b[38;5;19m·\u001b[14;82H\u001b[38;5;127m·\u001b[48C·\u001b[48C\u001b[39m \u001b[38;5;127m·\u001b[15;15H\u001b[38;5;198m∘\u001b[13C\u001b[38;5;196m○\u001b[30C\u001b[38;5;200m∘\u001b[13C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[28C∘\u001b[7C\u001b[38;5;196m∘\u001b[42C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m○\u001b[C∘\u001b[11C\u001b[38;5;202m∘\u001b[16;71H\u001b[39m \u001b[38;5;35m◇\u001b[47C\u001b[39m \u001b[38;5;35m◇\u001b[17;161H\u001b[38;5;31m·\u001b[18;13H\u001b[38;5;202m∘\u001b[13C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[36C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[28C∘\u001b[7C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[34C\u001b[38;5;208m∘\u001b[39m \u001b[2C\u001b[38;5;208m○\u001b[3C\u001b[38;5;214m∘\u001b[13C\u001b[38;5;226m∘\u001b[19;185H\u001b[39m \u001b[20;70H \u001b[38;5;106m◆\u001b[47C\u001b[39m \u001b[38;5;106m◆\u001b[64C\u001b[38;5;126m·\u001b[21;25H\u001b[38;5;190m∘\u001b[36C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[9C∘\u001b[3C\u001b[38;5;190m∘\u001b[36C\u001b[38