[13.275884, "o", "\u001b[6;15H\u001b[38;5;202m∘\u001b[13C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[22C\u001b[38;5;196m·\u001b[21C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[20C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[34C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[13C\u001b[38;5;226m∘\u001b[9;13H∘\u001b[7C○\u001b[5C\u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[30C\u001b[38;5;226m∘\u001b[50C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[34C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[12;17H\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[22C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[58C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[26C\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m∘\u001b[15;15H\u001b[38;5;48m∘\u001b[39m \u001b[38;5;31m·\u001b[5C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[30C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[20C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[34C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b(B\u001b[m\u001b[7C\u001b[38;5;51m∘\u001b[2C\u001b[39m \u001b[38;5;127m·\u001b[16;26H\u001b[39m \u001b[38;5;126m◇\u001b[8C\u001b[39m \u001b[35C \u001b[38;5;126m◇\u001b[47C\u001b[39m \u001b[38;5;126m◇\u001b[39C\u001b[38;5;31m·\u001b[17;36H\u001b[38;5;127m·\u001b[125C\u001b[39m \u001b[18;19H\u001b[38;5;91m◇\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[30C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[20C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[20C\u001b[38;5;45m∘\u001b[21C\u001b[38;5;27m∘\u001b[19;174H\u001b[39m \u001b[38;5;34m◆\u001b[20;66H\u001b[38;5;91m◇\u001b[48C◇\u001b[48C◇\u001b[21;17H\u001b[38;5;21m∘\u001b[15C\u001b[38;5;57m∘\u001b[36C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[50C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[20C\u001b[38;5;21m∘\u001b[13C\