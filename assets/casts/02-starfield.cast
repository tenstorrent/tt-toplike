[2.91813, "o", "\u001b[6;11H\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[28C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[36C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[20C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[21C\u001b[38;5;200m∘\u001b[9;15H∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[5C\u001b[38;5;197m∘\u001b[22C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[22C\u001b[38;5;199m∘\u001b[13C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[34C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[12;13H\u001b[38;5;196m∘\u001b[21C\u001b[38;5;208m∘\u001b[35C\u001b[39m \u001b[38;5;36m·\u001b[15C\u001b[38;5;202m∘\u001b[31C\u001b[39m \u001b[38;5;36m·\u001b[3C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[34C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[15;11H\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[50C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m○\u001b[7C\u001b[38;5;226m∘\u001b[28C∘\u001b[21C\u001b[38;5;154m∘\u001b[20C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[16;27H\u001b[39m \u001b[38;5;136m◇\u001b[18;15H\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[50C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[22C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[48C∘\u001b[7C\u001b[38;5;46m∘\u001b[21;21H\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[36C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[22C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[5C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[34C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[22;88H\u001b[39m \u001b[48C \u001b[23;16H\u001b[38;5;126m◇\u001b[71C\u001b[38;5;19m·\u001b[48C·\u001b[24;11H\u001b[38;5;50m∘\u001b[4C\u001b[39m \u001b[2C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[28C\u001b[38;5;