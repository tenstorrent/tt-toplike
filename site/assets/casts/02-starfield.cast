[10.98228, "o", "\u001b[27;159H    \u001b[38;5;36m◇\u001b[39m                                    \u001b[38;5;117m\u001b[1m│\u001b[28;159H\u001b(B\u001b[m \u001b[38;5;57m∘\u001b[39m \u001b[38;5;93m∘\u001b[39m \u001b[38;5;93m∘\u001b[39m \u001b[38;5;93m∘\u001b[39m \u001b[38;5;93m∘\u001b[39m \u001b[38;5;129m∘\u001b[39m \u001b[38;5;129m∘\u001b[39m \u001b[38;5;129m∘\u001b[39m \u001b[38;5;165m∘\u001b[39m \u001b[38;5;165m∘\u001b[39m \u001b[38;5;165m∘\u001b[39m \u001b[38;5;165m∘\u001b[39m \u001b[38;5;201m∘\u001b[39m \u001b[38;5;201m∘\u001b[39m \u001b[38;5;201m∘\u001b[39m           \u001b[38;5;117m\u001b[1m│\u001b[29;159H\u001b(B\u001b[m         \u001b[38;5;31m◆\u001b[39m        \u001b[38;5;70m◆\u001b[39m                      \u001b[38;5;117m\u001b[1m│\u001b[30;159H\u001b(B\u001b[m \u001b[38;5;201m∘\u001b[38;5;91m·\u001b[38;5;201m∘\u001b[39m \u001b[38;5;201m∘\u001b[39m \u001b[38;5;200m∘\u001b[39m \u001b[38;5;200m∘\u001b[39m \u001b[38;5;200m∘\u001b[39m \u001b[38;5;200m∘\u001b[39m \u001b[38;5;199m∘\u001b[39m \u001b[38;5;199m∘\u001b[39m \u001b[38;5;199m∘\u001b[39m \u001b[38;5;199m∘\u001b[38;5;130m◇\u001b[38;5;198m∘\u001b[39m "]
[10.982437, "o", "\u001b[38;5;198m∘\u001b[39m \u001b[38;5;198m∘\u001b[39m \u001b[38;5;198m∘\u001b[39m           \u001b[38;5;117m\u001b[1m│\u001b[31;159H\u001b(B\u001b[m                                         \u001b[38;5;117m\u001b[1m│\u001b[32;159H\u001b(B\u001b[m \u001b[38;5;197m∘\u001b[39m \u001b[38;5;197m∘\u001b[39m \u001b[38;5;196m∘\u001b[39m \u001b[38;5;196m∘\u001b[39m \u001b[38;5;196m∘\u001b[39m \u001b[38;5;196m∘\u001b[39m \u001b[38;5;196m∘\u001b[39m \u001b[38;5;196m∘\u001b[39m \u001b[38;5;196m∘\u001b[39m \u001b[38;5;196m∘\u001b[39m \u001b[38;5;202m∘\u001b[39m \u001b[38;5;202m∘\u001b[38;5;36m·\u001b[38;5;202m∘\u001b[39m \u001b[38;5;202m∘\u001b[39m \u001b[38;5;208m∘\u001b[39m           \u001b[38;5;117m\u001b[1m│\u001b[33;159H\u001b(B\u001b[m        \u001b[38;5;34m◇\u001b[39m                                \u001b[38;5;117m\u001b[1m│\u001b[34;159H\u001b(B\u001b[m \u001b[38;5;208m∘\u001b[39m \u001b[38;5;214m∘\u001b[39m \u001b[38;5;214m∘\u001b[39m \u001b[38;5;214m∘\u001b[39m \u001b[38;5;214m∘\u001b[39m \u001b[38;5;220m∘\u001b[39m \u001b[38;5;220m∘\u001b[39m \u001b[38;5;220m∘\u001b[38;5;106m◇\u001b[38;5;220m∘\u001b[39m \u001b[38;5;226m∘\u001b[39m \u001b[38;5;226m∘\u001b[39m \u001b[38;5;226m∘\u001b[39m \u001b[38;5;226m∘\u001b[39m \u001b[38;5;226m∘\u001b[39m \u001b[38;5;226m∘\u001b[39m           \u001b[38;5;117m\u001b[1m│\u001b[35;159H\u001b(B\u001b[m      \u001b[38;5;19m·\u001b[39m                                  \u001b[38;5;117m\u001b[1m│\u001b[36;159H\u001b(B\u001b[m \u001b[38;5;190m∘\u001b[39m \u001b[38;5;190m∘\u001b[39m \u001b[38;5;190m∘\u001b[39m \u001b[38;5;190m∘\u001b[39m \u001b[38;5;154m∘\u001b[39m \u001b[38;5;154m∘\u001b[39m \u001b[38;5;154m∘\u001b[39m \u001b[38;5;118m∘\u001b[39m \u001b[38;5;118m∘\u001b[39m \u001b[38;5;37m·\u001b[39m \u001b[38;5;118m∘\u001b[39m \u001b[38;5;82m∘\u001b[39m \u001b[38;5;82m∘\u001b[39m \u001b[38;5;82m∘\u001b[39m \u001b[38;5;82m∘\u001b[39m           \u001b[38;5;117m\u001b[1m│\u001b[37;159H\u001b(B\u001b[m             \u001b[38;5