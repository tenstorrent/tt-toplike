[17.339481, "o", "\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m○\u001b[32;11H\u001b[38;5;196m∘\u001b[15C\u001b[38;5;202m○\u001b[13C\u001b[38;5;214m∘\u001b[38C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[38C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[24C\u001b[38;5;196m∘\u001b[34;17H\u001b[38;5;220m∘\u001b[4C\u001b[38;5;25m◇\u001b[38;5;220m∘\u001b[C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[30C\u001b[38;5;220m∘\u001b[38;5;25m◇\u001b[38;5;220m∘\u001b[5C\u001b[38;5;226m∘\u001b[32C\u001b[38;5;214m∘\u001b[8C\u001b[38;5;25m◇\u001b[38;5;220m∘\u001b[3C\u001b[38;5;226m○\u001b[13C\u001b[38;5;190m∘\u001b[18C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[21C\u001b[38;5;190m∘\u001b[36;15H\u001b[38;5;154m∘\u001b[4C\u001b[38;5;130m·\u001b[8C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[22C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[38;5;130m·\u001b[12C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[24C\u001b[38;5;154m∘\u001b[2C\u001b[38;5;130m·\u001b[4C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[28C\u001b[38;5;130m·\u001b[3C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[38;19H\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[44C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[32C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[32C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b(B\u001b[m"]
