[16.005766, "o", "\u001b[12;33H\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[30C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[32C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[32C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[13C\u001b[38;5;50m∘\u001b[13;179H\u001b[39m \u001b[14;37H\u001b[38;5;39m∘\u001b[24C\u001b[38;5;50m∘\u001b[21C\u001b[38;5;45m∘\u001b[24C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[32C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[38;5;70m·\u001b[6C\u001b[38;5;39m∘\u001b[15;28H\u001b[39m \u001b[38;5;70m◇\u001b[47C\u001b[39m \u001b[38;5;70m◇\u001b[47C\u001b[39m \u001b[38;5;70m◇\u001b[42C\u001b[39m \u001b[38;5;136m◇\u001b[16;13H\u001b[38;5;33m∘\u001b[52C∘\u001b[7C\u001b[38;5;27m∘\u001b[38C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[32C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[18;11H\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[5C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[22C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m∘\u001b[24C\u001b[38;5;57m∘\u001b(B\u001b[m"]
