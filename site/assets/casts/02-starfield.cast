[2.538371, "o", "\u001b[38;5;118m∘\u001b[32C\u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[32C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[32;11H\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[21C\u001b[38;5;48m∘\u001b[24C\u001b[38;5;82m∘\u001b[21C\u001b[38;5;47m∘\u001b[24C\u001b[38;5;82m∘\u001b[21C\u001b[38;5;47m∘\u001b[24C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[34;17H\u001b[38;5;49m∘\u001b[46C\u001b[38;5;48m∘\u001b[5C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[24C\u001b[38;5;48m∘\u001b[13C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[24C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[36;21H\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[30C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[24C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[32C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[37;21H\u001b[38;5;127m·\u001b[39m \u001b[5C\u001b[38;5;91m·\u001b[41C\u001b[38;5;127m·\u001b[39m \u001b[5C\u001b[38;5;91m·\u001b[41C\u001b[38;5;127m·\u001b[39m \u001b[5C\u001b[38;5;91m·\u001b[41C\u001b[38;5;127m·\u001b[39m \u001b[5C\u001b[38;5;91m·\u001b[38;27H\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[30C\u001b[38;5;21m∘\u001b[13C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[24C\u001b[38;5;21m∘\u001b[21C\u001b[38;5;93m∘\u001b[40C\u001b[38;5;57m∘\u001b(B\u001b[m"]
[2.555207, "o", "\u001b[12;19H\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[24C\u001b[38;5;214m∘\u001b[13C\u001b[38;5;226m∘\u001b[32C\u001b[38;5;214m∘\u001b[46C∘\u001b[7C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[14;17H\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[30C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[38C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[24C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[15;26H\u001b[39m \u001b[38;5;55m◇\u001b[47C\u001b[39m \u001b[38;5;55m◇\u001b[47C\u001b[39m \u001b[38;5;55m◇\u001b[47C\u001b[39m \u001b[38;5;55m◇\u001b[16;27H\u001b[38;5;47m○\u001b[C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[22C\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m○\u001b[13C\u001b[38;5;49m∘\u001b[32C\u001b[38;5;47m∘\u001b[C○\u001b[5C\u001b[38;5;48m∘\u001b[38C\u001b[38;5;47m∘\u001b[3C○\u001b[3C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[18;13H\u001b[38;5;50m∘\u001b[27C\u001b[38;5;39m∘\u001b[24C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[24C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[32C\u001b[38;5;51m∘\u001b[19;27H\u001b[39m \u001b[38;5;91m◆\u001b[47C\u001b[39m \u001b[38;5;91m◆\u001b[47C\u001b[39m \u001b[38;5;91m◆\u001b[47C\u001b[39m \u001b[38;5;91m◆\u001b[20;17H\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m○\u001b[38C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[38C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[24C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[22;15H\u001b[38;5;57m∘\u001b[4C\u001b[38;5;31m◆\u001b[2C\u001b[38;5;93m∘\u001b[5C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[30C\u001b[38;5;57m∘\u001b[38;5;31m◆\u001b[6C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[33C\u001b[38;5;31m◆\u001b[4C\u001b[38;5;93m○\u001b[7C\u001b[38;5;129m∘\u001b[32C\u001b[38;5;57m∘\u001b[2C\u001b