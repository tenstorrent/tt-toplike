[17.93358, "o", "\u001b[12;17H\u001b[38;5;196m∘\u001b[15C\u001b[38;5;202m∘\u001b[30C\u001b[38;5;197m∘\u001b[21C\u001b[38;5;202m∘\u001b[24C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[13C\u001b[38;5;202m∘\u001b[24C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[C\u001b[38;5;37m·\u001b[19C\u001b[38;5;208m∘\u001b[13;19H\u001b[39m \u001b[38;5;37m·\u001b[47C\u001b[39m \u001b[38;5;37m·\u001b[47C\u001b[39m \u001b[38;5;37m·\u001b[48C\u001b[39m \u001b[14;15H\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[8C\u001b[39m \u001b[38;5;19m·\u001b[28C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[4C\u001b[39m \u001b[38;5;19m·\u001b[C\u001b[38;5;226m∘\u001b[24C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[6C\u001b[39m \u001b[38;5;19m·\u001b[32C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[38;5;19m·\u001b[15;22H\u001b[39m \u001b[38;5;125m◇\u001b[47C\u001b[39m \u001b[38;5;125m◇\u001b[47C\u001b[39m \u001b[38;5;125m◇\u001b[16;13H\u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[C○\u001b[5C\u001b[38;5;82m∘\u001b[30C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[3C○\u001b[9C\u001b[38;5;82m∘\u001b[24C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[5C○\u001b[C\u001b[38;5;118m∘\u001b[32C\u001b[38;5;36m·\u001b[5C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[17;15H\u001b[38;5;36m·\u001b[48C·\u001b[48C·\u001b[48C\u001b[39m \u001b[18;11H\u001b[38;5;46m∘\u001b[3C∘\u001b[9C\u001b[38;5;47m∘\u001b[3C∘\u001b[3C\u001b[38;5;48m∘\u001b[3C∘\u001b[26C\u001b[38;5;46m∘\u001b[13C∘\u001b[7C\u001b[38;5;48m∘\u001b[24C\u001b[38;5;46m∘\u001b[C∘\u001b[13C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[38C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[5C\u001b[38;5;49m∘\u001b[19;26H\u001b[38;5;36m◆\u001b[10C\u001b[38;5;91m·\u001b[37C\u001b[38;5;36m◆\u001b[10C\u001b[38;5;91m·\u001b[37C\u001b[38;5;36m◆\u001b[10C\u001b[38;5;91m·\u001b[37C\u001b[38;5;36m◆\u001b[10C\u001b[39m \u001b[20;15H\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[13