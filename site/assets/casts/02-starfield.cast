[3.140423, "o", "\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[29;16H\u001b[38;5;34m◇\u001b[39m \u001b[47C\u001b[38;5;34m◇\u001b[39m \u001b[47C\u001b[38;5;34m◇\u001b[39m \u001b[47C\u001b[38;5;34m◇\u001b[39m \u001b[30;15H\u001b[38;5;47m∘\u001b[5C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[30C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[3C∘\u001b[3C\u001b[38;5;50m∘\u001b[24C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[11C\u001b[38;5;49m∘\u001b[C\u001b[38;5;50m∘\u001b[40C\u001b[38;5;49m∘\u001b[5C∘\u001b[31;14H\u001b[38;5;130m·\u001b[22C\u001b[38;5;55m·\u001b[25C\u001b[38;5;130m·\u001b[22C\u001b[38;5;55m·\u001b[25C\u001b[38;5;130m·\u001b[22C\u001b[38;5;55m·\u001b[25C\u001b[38;5;130m·\u001b[22C\u001b[38;5;55m·\u001b[32;13H\u001b[38;5;51m∘\u001b[C∘\u001b[11C\u001b[38;5;45m○\u001b[5C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[22C\u001b[38;5;50m∘\u001b[C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[32C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[24C\u001b[38;5;51m∘\u001b[C∘\u001b[19C\u001b[38;5;39m∘\u001b[33;30H\u001b[39m \u001b[48C \u001b[48C \u001b[48C \u001b[34;17H\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[4C\u001b[38;5;130m◇\u001b[8C\u001b[38;5;57m∘\u001b[22C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[38;5;130m◇\u001b[37C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[2C\u001b[38;5;130m◇\u001b[29C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[4C\u001b[38;5;130m◇\u001b[10C\u001b[38;5;57m∘\u001b[35;33H\u001b[39m \u001b[48C \u001b[48C \u001b[48C \u001b[36;15H\u001b[38;5;93m∘\u001b[3C\u001b[38;5;124m·\u001b[39m \u001b[8C\u001b[38;5;165m∘\u001b[2C\u001b[38;5;127m·\u001b[4C\u001b[38;5;201m∘\u001b[22C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;124m·\u001b[39m \u001b[6C\u001b[38;5;129m∘\u001b[4C\u001b[38;5;127m·\u001b[8C\u001b[38;5;201m∘\u001b[24C\u001b[38;5;93m∘\u001b[C\u001b[38;5;124m·\u001b[39m \u001b[4C\u001b[38;5;129m∘\u001b[6C\u001b[38;5;127m·\