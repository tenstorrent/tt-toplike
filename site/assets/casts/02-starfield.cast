[10.645938, "o", "\u001b[48C \u001b[24;17H\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[30C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[C∘\u001b[22C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[3C∘\u001b[20C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[C○\u001b[5C\u001b[38;5;50m∘\u001b[26;21H\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[39m \u001b[43C\u001b[38;5;39m∘\u001b[4C\u001b[39m \u001b[2C\u001b[38;5;33m∘\u001b[32C\u001b[38;5;45m∘\u001b[12C\u001b[39m \u001b[38;5;33m∘\u001b[32C\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[27;38H\u001b[38;5;34m·\u001b[48C·\u001b[48C·\u001b[28;19H\u001b[38;5;21m∘\u001b[15C\u001b[38;5;57m∘\u001b[30C\u001b[38;5;27m∘\u001b[21C\u001b[38;5;57m∘\u001b[24C\u001b[38;5;27m∘\u001b[21C\u001b[38;5;57m∘\u001b[32C\u001b[38;5;21m\u001b[48;5;16m○\u001b[13C\u001b[38;5;57m∘\u001b[30;17H\u001b[49m\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[38C\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[24C\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[24C\u001b[38;5;93m∘\u001b[32;15H\u001b[38;5;200m∘\u001b[13C\u001b[38;5;198m○\u001b[6C\u001b[39m \u001b[38;5;197m∘\u001b[30C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[8C\u001b[39m \u001b[4C\u001b[38;5;197m∘\u001b[24C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[2C\u001b[39m \u001b[2C\u001b[38;5;197m∘\u001b[33;36H\u001b[38;5;35m·\u001b[48C·\u001b[48C·\u001b[34;13H\u001b[38;5;196m∘\u001b[21C\u001b[38;5;208m∘\u001b[30C\u001b[38;5;196m∘\u001b[21C\u001b[38;5;208m∘\u001b[24C\u001b[38;5;196m∘\u001b[21C\u001b[38;5;208m∘\u001b[46C\u001b[48;5;16m∘\u001b[35;17H\u001b[49m\u001b[38;5;19m·\u001b[39m \u001b[47C\u001b[38;5;19m·\u001b[39m \u001b[47C\u001b[38;5;19m·\u001b[39m \u001b[36;17H\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[24C\u001b[38;5;214m∘\u001b[13C\u001b[38;5;226m∘\u001b[32