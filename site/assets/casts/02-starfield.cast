[14.019791, "o", "\u001b[38;5;55m◆\u001b[39m \u001b[10C\u001b[38;5;199m∘\u001b[24C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[3C\u001b[38;5;55m◆\u001b[39m \u001b[8C\u001b[38;5;200m∘\u001b[24C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[5C\u001b[38;5;55m◆\u001b[39m \u001b[6C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[32;13H\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[44C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[38C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[32C\u001b[38;5;35m\u001b[48;5;16m·\u001b[13C\u001b[38;5;196m∘\u001b[34;11H\u001b[49m\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[22C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[38C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[35;180H\u001b[38;5;136m\u001b[48;5;16m·\u001b[39m \u001b[36;23H\u001b[49m\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[30C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m○\u001b[7C\u001b[38;5;154m∘\u001b[24C\u001b[38;5;226m∘\u001b[21C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[38;11H∘\u001b[C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[38C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m∘\u001b[18C\u001b[38;5;118m∘\u001b[11C\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m∘\u001b(B\u001b[m"]
