[15.546689, "o", "\u001b[12;23H\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[22C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[24C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[5C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[24C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[39m \u001b[38;5;130m·\u001b[11C\u001b[38;5;46m∘\u001b[14;21H\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[30C\u001b[38;5;46m∘\u001b[21C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[38C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[32C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[15;21H\u001b[39m \u001b[38;5;142m◇\u001b[47C\u001b[39m \u001b[38;5;142m◇\u001b[47C\u001b[39m \u001b[38;5;142m◇\u001b[16;11H\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[30C\u001b[38;5;51m∘\u001b[40C\u001b[38;5;50m∘\u001b[46C∘\u001b[7C\u001b[38;5;51m∘\u001b[9C∘\u001b[3C\u001b[38;5;45m∘\u001b[17;179H\u001b[38;5;34m◇\u001b[18;17H\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[30C\u001b[38;5;39m∘\u001b[7C\u001b(B\u001b[m\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[38C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[32C\u001b[38;5;39m∘\u001b[6C\u001b[38;5;130m◇\u001b[6C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[19;164H\u001b[39m \u001b[20;15H\u001b[38;5;57m∘\u001b[13C\u001b[38;5;129m∘\u001b[5C∘\u001b[C\u001b[38;5;165m∘\u001b[30C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[5C\u001b[38;5;129m∘\u001b[C∘\u001b[5C\u001b[38;5;165m∘\u001b[24C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[9C\u001b[38;5;129m∘\u001b[3C\u001b[38;5;165m∘\u001b[24C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[21;35H\u001b[38;5;36m◇\u001b[48C◇\u001b[48C◇\u001b[22;27H\u001b[38;5;200m∘\u001b[3C∘\u001b[9C\u001b[38;5;198m∘\u001b[24C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[24C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[C∘\u001b[5C\