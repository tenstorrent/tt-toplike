[21.26322, "o", "\u001b[12;15H\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[4C\u001b[39m \u001b[38;5;34m·\u001b[7C\u001b[38;5;220m∘\u001b[30C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[39m \u001b[38;5;34m·\u001b[44C\u001b[38;5;208m∘\u001b[2C\u001b[39m \u001b[38;5;34m·\u001b[3C\u001b[38;5;214m∘\u001b[32C\u001b[38;5;202m∘\u001b[13C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[14;13H\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[30C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[46C∘\u001b[26C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[15;175H\u001b[39m \u001b[38;5;25m◇\u001b[16;17H\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[38C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[32C\u001b[38;5;118m∘\u001b[46C∘\u001b[7C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[18;15H\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[38C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m○\u001b[7C\u001b[38;5;50m∘\u001b[24C\u001b[38;5;47m∘\u001b[21C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[24C\u001b[38;5;48m∘\u001b(B\u001b[m\u001b[7C\u001b[38;5;49m∘\u001b[5C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[20;27H\u001b[38;5;39m○\u001b[7C\u001b[38;5;33m∘\u001b[38C\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[32C\u001b[38;5;45m∘\u001b[46C∘\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[21;13H\u001b[38;5;136m·\u001b[48C·\u001b[48C·\u001b[51C\u001b[38;5;34m◇\u001b[22;13H\u001b[38;5;27m∘\u001b[19C\u001b[38;5;57m∘\u001b[28C\u001b[38;5;33m∘\u001b[C\u001b[38;5;27m∘\u001b[21C\u001b[38;5;57m∘\u001b[24C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[38C\u001b[38;5;27m∘\u001b[4C\u001b[39m \u001b[2C\u001b[38;5;21m∘\u001b[15C\u001b[38;5;57m∘\u001b[5C\u001b[38;5;93m∘\u001b[24;15H\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[30C\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m∘\u001b[32C\u001b[38;5;93m∘\u001b[21C\u001b[38;5;201m∘\u001b[32C\u001b[38;5;129m∘\u001b[7C\u