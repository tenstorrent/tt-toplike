[11.783371, "o", "\u001b[12;19H\u001b[38;5;202m∘\u001b[3C∘\u001b[38;5;70m·\u001b[2C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[30C\u001b[38;5;196m∘\u001b[38;5;70m·\u001b[6C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[32C\u001b[38;5;202m∘\u001b[38;5;70m·\u001b[4C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[32C\u001b[38;5;202m∘\u001b[13C\u001b[38;5;214m∘\u001b[14;17H\u001b[38;5;142m·\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[24C\u001b[38;5;220m∘\u001b[C\u001b[38;5;142m·\u001b[48C·\u001b[C\u001b[38;5;226m∘\u001b[21C\u001b[38;5;154m∘\u001b[18C\u001b[38;5;220m∘\u001b[21C\u001b[38;5;190m∘\u001b[15;17H\u001b[39m \u001b[48C \u001b[48C \u001b[52C\u001b[38;5;31m◇\u001b[16;15H\u001b[38;5;118m∘\u001b[4C\u001b[38;5;25m◇\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[5C∘\u001b[38;5;35m·\u001b[23C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[38;5;25m◇\u001b[6C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[38;5;35m·\u001b[29C\u001b[38;5;118m∘\u001b[2C\u001b[38;5;25m◇\u001b[4C\u001b[38;5;82m∘\u001b[9C\u001b[38;5;46m∘\u001b[38;5;35m·\u001b[27C\u001b[38;5;118m∘\u001b[5C∘\u001b[C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[17;19H\u001b[39m \u001b[48C \u001b[48C \u001b[18;19H\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[5C∘\u001b[C\u001b[38;5;50m∘\u001b[30C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[5C\u001b[38;5;49m∘\u001b[C∘\u001b[5C\u001b[38;5;50m∘\u001b[24C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[5C\u001b[38;5;49m∘\u001b[3C∘\u001b[3C\u001b[38;5;50m∘\u001b[24C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[13C\u001b[38;5;50m∘\u001b[19;25H\u001b[38;5;55m◆\u001b[8C\u001b[38;5;127m◇\u001b[39C\u001b[38;5;55m◆\u001b[8C\u001b[38;5;127m◇\u001b[39C\u001b[38;5;55m◆\u001b[8C\u001b[38;5;127m◇\u001b[39C\u001b[38;5;55m◆\u001b[20;25H\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[24C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[38C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[24C\u001b[38;5;51m∘\u001b[13C\u001b[3