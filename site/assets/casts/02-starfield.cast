[1.85969, "o", "\u001b[12;13H\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[13C\u001b[38;5;197m∘\u001b[30C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[5C\u001b[38;5;197m∘\u001b[32C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[24C\u001b[38;5;200m∘\u001b[13C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[13;19H\u001b[39m \u001b[38;5;130m·\u001b[11C\u001b[39m \u001b[35C \u001b[38;5;130m·\u001b[11C\u001b[39m \u001b[35C \u001b[38;5;130m·\u001b[11C\u001b[39m \u001b[35C \u001b[38;5;130m·\u001b[11C\u001b[39m \u001b[14;11H\u001b[38;5;196m∘\u001b[21C\u001b[38;5;106m·\u001b[7C\u001b[38;5;214m∘\u001b[22C\u001b[38;5;196m∘\u001b[17C\u001b[38;5;106m·\u001b[3C\u001b[38;5;208m∘\u001b[40C\u001b[38;5;202m∘\u001b[3C\u001b[38;5;106m·\u001b[3C\u001b[38;5;208m∘\u001b[24C\u001b[38;5;196m∘\u001b[13C\u001b[38;5;202m∘\u001b[5C\u001b[38;5;106m·\u001b[C\u001b[38;5;208m∘\u001b[15;30H\u001b[39m \u001b[48C \u001b[48C \u001b[48C \u001b[16;23H\u001b[38;5;226m∘\u001b[6C\u001b[38;5;126m◇\u001b[31C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[8C\u001b[38;5;126m◇\u001b[37C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[2C\u001b[38;5;126m◇\u001b[10C\u001b[38;5;190m∘\u001b[24C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[4C\u001b[38;5;126m◇\u001b[8C\u001b[38;5;190m∘\u001b[17;15H\u001b[38;5;124m·\u001b[48C·\u001b[48C·\u001b[48C·\u001b[18;13H\u001b[38;5;154m∘\u001b[39m \u001b[6C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[C∘\u001b[25C\u001b[39m \u001b[2C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[3C∘\u001b[25C\u001b[39m \u001b[2C\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[5C∘\u001b[C\u001b[38;5;46m∘\u001b[23C\u001b[39m \u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[19;24H\u001b[39m \u001b[38;5;127m◆\u001b[11C\u001b[38;5;34m·\u001b[35C\u001b[39m \u001b[38;5;127m◆\u001b[11C\u001b[38;5;34m·\u001b[35C\u001b[39m \u001b[38;5;127m◆\u001b[11C\u001b[38;5;34m·\u001b[35C\u0