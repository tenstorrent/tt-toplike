[26.48733, "o", "\u001b[12;19H\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m∘\u001b[38C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[38C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[32C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[5C\u001b[38;5;129m∘\u001b[14;17H\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[24C\u001b[38;5;165m∘\u001b[46C∘\u001b[27C\u001b[38;5;199m∘\u001b[18C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[16;15H\u001b[38;5;198m∘\u001b[4C\u001b[38;5;125m◇\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[30C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[38;5;125m◇\u001b[6C\u001b[38;5;197m∘\u001b[38C\u001b[38;5;198m∘\u001b[2C\u001b[38;5;125m◇\u001b[4C\u001b[38;5;197m∘\u001b[46C∘\u001b[7C\u001b[38;5;196m∘\n\u001b[38;5;124m◇\u001b[18;19H\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[30C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[5C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[24C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[24C\u001b[38;5;202m∘\u001b[4C\u001b[38;5;91m◇\u001b[2C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[19;22H\u001b[39m \u001b[38;5;36m◆\u001b[47C\u001b[39m \u001b[38;5;36m◆\u001b[47C\u001b[39m \u001b[38;5;36m◆\u001b[42C\u001b[39m \u001b[4C \u001b[38;5;36m◆\u001b[20;25H\u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[24C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[24C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[24C\u001b[38;5;226m∘\u001b[21C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[21;31H\u001b[39m \u001b[48C \u001b[48C \u001b[48C \u001b[22;15H\u001b[38;5;82m∘\u001b[15C\u001b[38;5;55m◆\u001b[5C\u001b[38;5;47m∘\u001b[30C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[3C\u001b[38;5;55m◆\u001b[34C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[5C\u001b[38;5;55m◆\u001b[40C\u001b[38