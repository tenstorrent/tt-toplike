[7.237624, "o", "\u001b[12;13H\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[5C○\u001b[C\u001b[38;5;21m∘\u001b[36C\u001b[38;5;33m∘\u001b[9C\u001b[38;5;27m○\u001b[5C\u001b[38;5;21m∘\u001b[38C\u001b[38;5;27m∘\u001b[3C○\u001b[3C\u001b[38;5;21m∘\u001b[32C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[13;19H\u001b[38;5;106m·\u001b[11C\u001b[39m \u001b[38;5;35m·\u001b[35C\u001b[38;5;106m·\u001b[11C\u001b[39m \u001b[38;5;35m·\u001b[35C\u001b[38;5;106m·\u001b[11C\u001b[39m \u001b[38;5;35m·\u001b[14;11H\u001b[38;5;57m∘\u001b[6C\u001b[39m \u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[22C\u001b[38;5;57m∘\u001b[2C\u001b[39m \u001b[4C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[35C\u001b[39m \u001b[2C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[32C\u001b[38;5;57m∘\u001b[13C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[15;21H\u001b[38;5;136m◇\u001b[48C◇\u001b[48C◇\u001b[56C\u001b[39m \u001b[38;5;106m◇\u001b[16;21H\u001b[38;5;201m∘\u001b[C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[22C\u001b[38;5;201m∘\u001b[7C∘\u001b[5C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[24C\u001b[38;5;201m∘\u001b[9C∘\u001b[11C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[18C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[13C\u001b[38;5;198m∘\u001b[17;36H\u001b[39m \u001b[48C \u001b[48C \u001b[18;14H\u001b[38;5;136m·\u001b[6C\u001b[38;5;196m∘\u001b[15C\u001b[38;5;36m·\u001b[22C\u001b[38;5;198m∘\u001b[2C\u001b[38;5;136m·\u001b[10C\u001b[38;5;196m∘\u001b[11C\u001b[38;5;36m·\u001b[3C\u001b[38;5;202m∘\u001b[21C\u001b[38;5;136m·\u001b[8C\u001b[38;5;196m∘\u001b[13C\u001b[38;5;36m·\u001b[C\u001b[38;5;202m∘\u001b[23C\u001b[38;5;142m·\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[13C\u001b[38;5;37m·\u001b[19;14H\u001b[39m \u001b[48C \u001b[48C \u001b[20;19H\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[6C\u001b[39m \u001b[38;5;34m◇\u001b[36C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[2C\u001b[39m \u001b[38;5;34m◇\