[5.817329, "o", "\u001b[12;11H\u001b[38;5;220m∘\u001b[18C\u001b[39m \u001b[8C\u001b[38;5;154m∘\u001b[24C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[6C\u001b[39m \u001b[6C\u001b[38;5;190m∘\u001b[24C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[8C\u001b[39m \u001b[4C\u001b[38;5;190m∘\u001b[32C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[13;31H\u001b[38;5;130m·\u001b[48C·\u001b[48C·\u001b[14;15H\u001b[38;5;118m∘\u001b[C∘\u001b[38;5;126m·\u001b[4C\u001b[38;5;82m∘\u001b[42C\u001b[38;5;154m∘\u001b[38;5;126m·\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[24C\u001b[38;5;154m∘\u001b[5C\u001b[38;5;118m∘\u001b[38;5;126m·\u001b[6C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[32C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[15;27H\u001b[39m \u001b[38;5;35m◇\u001b[47C\u001b[39m \u001b[38;5;35m◇\u001b[47C\u001b[39m \u001b[38;5;35m◇\u001b[16;13H\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[5C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[39m \u001b[29C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[10C\u001b[39m \u001b[2C\u001b[38;5;50m∘\u001b[24C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[4C\u001b[39m \u001b[27C\u001b[38;5;47m∘\u001b[4C\u001b[39m \u001b[38;5;70m◇\u001b[7C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[17;36H\u001b[38;5;142m·\u001b[48C·\u001b[48C·\u001b[48C·\u001b[18;11H\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[30C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[24C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m○\u001b[7C\u001b[38;5;39m∘\u001b[40C\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[19;14H\u001b[38;5;127m·\u001b[48C·\u001b[48C·\u001b[48C·\u001b[19C\u001b[39m \u001b[20;13H\u001b[38;5;33m∘\u001b[C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[38C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[32C\u001b[38;5;33m∘\u001b[C∘\u001b[11C\u001b[38;5;21m○\u001b[15C\u001b[38;5;57m∘\u001b[24C\u001b[38;5;27m∘\