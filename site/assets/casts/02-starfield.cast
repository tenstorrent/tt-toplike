[26.950521, "o", "\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[C\u001b[38;5;136m◇\u001b[5C\u001b[38;5;21m∘\u001b[25;163H\u001b[38;5;25m◇\u001b[26;19H\u001b[38;5;21m∘\u001b[9C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[22C\u001b[38;5;21m∘\u001b[7C∘\u001b[7C\u001b[38;5;57m∘\u001b[13C\u001b[38;5;129m∘\u001b[26C\u001b[38;5;21m∘\u001b[5C\u001b[38;5;57m∘\u001b[13C\u001b[38;5;129m∘\u001b[25C\u001b[39m \u001b[6C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[28;13H\u001b[38;5;165m∘\u001b[21C\u001b[38;5;200m∘\u001b[30C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[24C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[24C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[5C○\u001b[7C\u001b[38;5;200m∘\u001b[30;25H\u001b[38;5;197m∘\u001b[9C\u001b[38;5;196m○\u001b[28C\u001b[38;5;199m∘\u001b[13C\u001b[38;5;197m∘\u001b[5C○\u001b[32C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m○\u001b[24C\u001b[38;5;199m∘\u001b[2C\u001b[38;5;142m·\u001b[4C\u001b[38;5;198m∘\u001b[5C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[31;161H\u001b[39m \u001b[22C \u001b[32;23H\u001b[38;5;208m∘\u001b[13C\u001b[38;5;220m∘\u001b[30C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[30C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[46C∘\u001b[7C\u001b[38;5;214m∘\u001b[4C\u001b[38;5;127m·\u001b[2C\u001b[38;5;220m∘\u001b[34;13H\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[30C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[24C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[37C\u001b[38;5;34m◇\u001b[38;5;226m∘\u001b[C\u001b[38;5;190m∘\u001b[35;165H\u001b[38;5;136m·\u001b[36;17H\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[38C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[32C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[32C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[11C\u00