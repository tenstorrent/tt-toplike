[2.198403, "o", "\u001b[7C\u001b[38;5;27m∘\u001b[24;21H\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[30C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m○\u001b[5C\u001b[38;5;129m○\u001b[7C\u001b[38;5;165m∘\u001b[24C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m○\u001b[30C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[5C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[26;13H\u001b[38;5;124m·\u001b[19C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[20C\u001b[38;5;124m·\u001b[3C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[22C\u001b[38;5;124m·\u001b[C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[24C\u001b[38;5;124m·\u001b[13C\u001b[38;5;200m○\u001b[7C\u001b[38;5;199m∘\u001b[28;17H\u001b[38;5;197m∘\u001b[3C\u001b[38;5;36m◆\u001b[17C\u001b[38;5;202m∘\u001b[30C\u001b[38;5;36m◆\u001b[7C\u001b[38;5;196m∘\u001b[32C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;36m◆\u001b[5C\u001b[38;5;196m∘\u001b[38C\u001b[38;5;197m∘\u001b[3C\u001b[38;5;36m◆\u001b[3C\u001b[38;5;196m○\u001b[29;17H\u001b[38;5;36m◇\u001b[3C\u001b[39m \u001b[7C\u001b[38;5;142m◆\u001b[39m \u001b[35C\u001b[38;5;36m◇\u001b[3C\u001b[39m \u001b[7C\u001b[38;5;142m◆\u001b[39m \u001b[35C\u001b[38;5;36m◇\u001b[3C\u001b[39m \u001b[7C\u001b[38;5;142m◆\u001b[39m \u001b[35C\u001b[38;5;36m◇\u001b[3C\u001b[39m \u001b[7C\u001b[38;5;142m◆\u001b[39m \u001b[30;15H\u001b[38;5;208m∘\u001b[C∘\u001b[3C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[36C\u001b[38;5;202m∘\u001b[C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[13C\u001b[38;5;226m∘\u001b[18C\u001b[38;5;202m∘\u001b[5C∘\u001b[7C\u001b[38;5;214m○\u001b[7C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[22C\u001b[38;5;208m∘\u001b[C∘\u001b[5C\u001b[38;5;214m∘\u001b[32;19H\u001b[38;5;190m∘\u001b[3C○\u001b[3C\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[30C\u001b[38;5;226m○\u001b[7C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[32C\u001b[38;5;190m○\u001b[13C\u001b[38;5;11