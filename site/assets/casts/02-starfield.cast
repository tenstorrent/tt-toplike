[24.736014, "o", "\u001b[12;19H\u001b[38;5;226m∘\u001b[21C\u001b[38;5;154m∘\u001b[24C\u001b[38;5;220m∘\u001b[21C\u001b[38;5;190m∘\u001b[24C\u001b[38;5;220m∘\u001b[21C\u001b[38;5;190m∘\u001b[24C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[14;17H\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[44C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[30C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m○\u001b[7C\u001b[38;5;46m∘\u001b[24C\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[15;21H\u001b[39m \u001b[38;5;136m◇\u001b[47C\u001b[39m \u001b[38;5;136m◇\u001b[47C\u001b[39m \u001b[38;5;136m◇\u001b[51C\u001b[39m \u001b[38;5;136m◇\u001b[16;15H\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[5C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[30C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[13C\u001b[38;5;50m∘\u001b[24C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[13C\u001b[38;5;50m∘\u001b[32C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[17;165H\u001b[38;5;124m◇\u001b[13C\u001b[39m \u001b[38;5;70m◇\u001b[18;13H\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[30C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[24C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[32C\u001b[38;5;51m∘\u001b[4C\u001b[39m \u001b[16C\u001b[38;5;39m∘\u001b[20;17H\u001b[38;5;27m∘\u001b[3C\u001b[38;5;91m◆\u001b[3C\u001b[38;5;21m∘\u001b[3C∘\u001b[38;5;130m◆\u001b[4C\u001b[38;5;21m∘\u001b[3C\u001b[38;5;57m∘\u001b[24C\u001b[38;5;33m∘\u001b[5C\u001b[38;5;91m◆\u001b[7C\u001b[38;5;21m∘\u001b[38;5;130m◆\u001b[4C\u001b[38;5;21m∘\u001b[26C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;91m◆\u001b[5C\u001b[38;5;21m∘\u001b[C∘\u001b[38;5;130m◆\u001b[4C\u001b[38;5;21m∘\u001b[24C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[C\u001b[38;5;91m◆\u001b[7C\u001b[38;5;21m∘\u001b[38;5;130m◆\u001b[10C\u001b[38;5;57m∘\u001b[21;21H\u001b[39m \u001b[13C\u001b[38;5;35m◇\u001b[34C\u001b[39m \u001b[13C\u001b[38;5;35m◇\u001b[34C\u001b[39m 