[2.19813, "o", "\u001b[12;13H\u001b[38;5;196m∘\u001b[21C\u001b[38;5;208m∘\u001b[24C\u001b[38;5;197m∘\u001b[21C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[24C\u001b[38;5;196m∘\u001b[21C\u001b[38;5;208m∘\u001b[38C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[13;31H\u001b[38;5;34m·\u001b[48C·\u001b[48C·\u001b[48C·\u001b[14;11H\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[21C\u001b[38;5;190m∘\u001b[30C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[32C\u001b[38;5;214m∘\u001b[13C\u001b[38;5;226m∘\u001b[38C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[15;28H\u001b[38;5;127m◇\u001b[48C◇\u001b[48C◇\u001b[48C◇\u001b[16;20H\u001b[39m \u001b[38;5;19m◇\u001b[C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[30C\u001b[38;5;190m∘\u001b[6C\u001b[39m \u001b[38;5;19m◇\u001b[13C\u001b[38;5;82m∘\u001b[32C\u001b[38;5;154m∘\u001b[39m \u001b[38;5;19m◇\u001b[5C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[24C\u001b[38;5;154m∘\u001b[2C\u001b[39m \u001b[38;5;19m◇\u001b[9C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[18;21H\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[30C\u001b[38;5;46m∘\u001b[21C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[32C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[38C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[19;34H\u001b[39m \u001b[48C \u001b[48C \u001b[48C \u001b[20;11H\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[C∘\u001b[38;5;19m◆\u001b[7C\u001b[39m \u001b[2C\u001b[38;5;45m∘\u001b[38;5;125m◇\u001b[6C\u001b[38;5;39m∘\u001b[24C\u001b[38;5;50m∘\u001b[3C∘\u001b[38;5;19m◆\u001b[7C\u001b[39m \u001b[3C\u001b[38;5;125m◇\u001b[29C\u001b[38;5;50m∘\u001b[5C∘\u001b[38;5;19m◆\u001b[38;5;51m∘\u001b[6C\u001b[39m \u001b[3C\u001b[38;5;125m◇\u001b[2C\u001b[38;5;45m∘\u001b[24C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[38;5;19m◆\u001b[7C\u001b[39m \u001b[3C\u001b[38;5;125m◇\u001b[6C\u001b[38;5;39m∘\u001b[21;30H\u001b[38;5;125m◆\u001b[48C◆\u001b[48C◆\u001b[48C◆\u001b[22;23H\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21