[1.859874, "o", "\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[33C\u001b[39m \u001b[38;5;19m◇\u001b[11C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[27C\u001b[39m \u001b[38;5;19m◇\u001b[17C\u001b[38;5;49m∘\u001b[22;17H\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[22C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[32C\u001b[38;5;51m∘\u001b[21C\u001b[38;5;39m∘\u001b[18C\u001b[38;5;50m∘\u001b[21C\u001b[38;5;45m∘\u001b[23;31H\u001b[39m \u001b[48C \u001b[48C \u001b[48C \u001b[24;21H\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[C\u001b[38;5;136m◆\u001b[5C\u001b[38;5;21m∘\u001b[22C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[5C\u001b[38;5;136m◆\u001b[C\u001b[38;5;21m∘\u001b[3C∘\u001b[28C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[5C\u001b[38;5;136m◆\u001b[5C\u001b[38;5;21m∘\u001b[26C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;136m◆\u001b[5C\u001b[38;5;21m∘\u001b[25;20H\u001b[38;5;25m◆\u001b[48C◆\u001b[48C◆\u001b[48C◆\u001b[26;11H\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[39m \u001b[6C\u001b[38;5;129m∘\u001b[13C\u001b[38;5;201m∘\u001b[27C\u001b[39m \u001b[2C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[32C\u001b[38;5;57m∘\u001b[4C\u001b[39m \u001b[2C\u001b[38;5;93m∘\u001b[5C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[24C\u001b[38;5;57m∘\u001b[6C\u001b[39m \u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m○\u001b[28;23H\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[22C\u001b[38;5;201m∘\u001b[21C\u001b[38;5;199m○\u001b[26C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m○\u001b[24C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[29;34H\u001b[38;5;136m◇\u001b[39m \u001b[47C\u001b[38;5;136m◇\u001b[39m \u001b[47C\u001b[38;5;136m◇\u001b[39m \u001b[47C\u001b[38;5;136m◇\u001b[39m \u001b[30;14H\u001b[38;5;127m·\u001b[6C\u001b[38;5;196m∘\u001b[4C\u001b[38;5;34m◆\u001b[38;5;196m∘\u001b[9C\u001b[38;5;202m∘\u001b[22C\u00