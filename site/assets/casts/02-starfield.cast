[15.733521, "o", "\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[38C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[26;13H\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m○\u001b[13C\u001b[38;5;190m∘\u001b[30C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[26C\u001b[38;5;220m∘\u001b[46C∘\u001b[7C\u001b[38;5;226m○\u001b[11C∘\u001b[27;160H\u001b[38;5;127m·\u001b[21C\u001b[38;5;36m◇\u001b[28;11H\u001b[38;5;154m∘\u001b[C\u001b[38;5;127m·\u001b[5C\u001b[38;5;118m∘\u001b[5C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[28C\u001b[38;5;127m·\u001b[C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[24C\u001b[38;5;127m·\u001b[7C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[30C\u001b[38;5;154m∘\u001b[C∘\u001b[5C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[29;13H\u001b[39m \u001b[48C \u001b[48C \u001b[30;23H\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[30C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[32C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[13C\u001b[38;5;50m∘\u001b[32;29H\u001b[38;5;45m∘\u001b[30C\u001b[38;5;50m∘\u001b[21C\u001b[38;5;45m∘\u001b[32C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[24C\u001b[38;5;51m\u001b[48;5;16m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[34;11H\u001b[49m\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[21C\u001b[38;5;57m∘\u001b[22C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[46C∘\u001b[7C\u001b[38;5;21m∘\u001b[36;17H\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[22C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m∘\u001b[32C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[13C\u001b[38;5;201m∘\u001b[37;29H\u001b[38;5;25m·\u001b[39m \u001b[47C\u001b[38;5;25m·\u001b[39m \u001b[47C\u001b[38;5;25m·\u001b[39m \u001b[38;21H\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[30C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[46C∘\u001b[7C\