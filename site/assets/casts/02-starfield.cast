[23.986721, "o", "\u001b[13C\u001b[38;5;57m∘\u001b[26;11H\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[36C\u001b[38;5;129m∘\u001b[11C\u001b[38;5;165m∘\u001b[3C\u001b[38;5;201m∘\u001b[24C\u001b[38;5;93m∘\u001b[13C\u001b[38;5;165m○\u001b[5C∘\u001b[C\u001b[38;5;201m∘\u001b[24C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[5C\u001b[38;5;201m∘\u001b[27;182H\u001b[39m \u001b[28;13H\u001b[38;5;25m·\u001b[3C\u001b[38;5;200m∘\u001b[13C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[22C\u001b[38;5;25m·\u001b[7C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[32C\u001b[38;5;25m·\u001b[5C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m○\u001b[7C\u001b[38;5;198m∘\u001b[5C\u001b[38;5;197m∘\u001b[24C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[C\u001b[38;5;37m◇\u001b[29;13H\u001b[39m \u001b[48C \u001b[48C \u001b[30;29H\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[22C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[13C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[24C\u001b[38;5;196m∘\u001b[21C\u001b[38;5;208m∘\u001b[24C\u001b[38;5;196m∘\u001b[15C\u001b[38;5;202m∘\u001b[32;25H\u001b[38;5;220m○\u001b[C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[24C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m○\u001b[5C\u001b[38;5;226m∘\u001b[32C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[C○\u001b[36C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[34;31H\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[22C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[38C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[24C\u001b[38;5;190m∘\u001b[10C\u001b[38;5;91m◇\u001b[38;5;154m∘\u001b[C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[36;29H\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[22C\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[32C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u