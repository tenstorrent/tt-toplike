[16.141934, "o", "\u001b[12;13H\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[24C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[32C\u001b[38;5;48m∘\u001b[13C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[24C\u001b[38;5;48m∘\u001b[5C\u001b[38;5;142m·\u001b[7C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[13;20H\u001b[38;5;142m·\u001b[48C·\u001b[48C·\u001b[14;17H\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[46C\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[32C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[38C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[5C\u001b[38;5;27m∘\u001b[15;23H\u001b[38;5;142m◇\u001b[48C◇\u001b[48C◇\u001b[51C◇\u001b[16;15H\u001b[38;5;21m∘\u001b[46C\u001b[38;5;27m∘\u001b[21C\u001b[38;5;57m∘\u001b[24C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[21C\u001b[38;5;93m∘\u001b[24C\u001b[38;5;21m∘\u001b[21C\u001b[38;5;93m∘\u001b[18;13H\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[38C\u001b[38;5;93m∘\u001b[9C\u001b[38;5;129m∘\u001b[3C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[32C\u001b[38;5;129m∘\u001b[3C∘\u001b[9C\u001b[38;5;201m∘\u001b[32C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[C∘\u001b[20;11H\u001b[38;5;200m∘\u001b[13C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[22C\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[5C\u001b[38;5;197m∘\u001b[32C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[32C\u001b[38;5;200m∘\u001b[13C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[22;23H\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[30C\u001b[38;5;196m∘\u001b[62C\u001b[38;5;202m∘\u001b[13C\u001b[38;5;214m∘\u001b[32C\u001b[38;5;202m∘\u001b[7C\u001b[38;5;208m∘\u001b[24;13H\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[24C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[46C∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[24C\u001b[38;5;220m∘\u001b[7C\u001