[15.136079, "o", "\u001b[7C\u001b[38;5;154m∘\u001b[24C\u001b[38;5;226m∘\u001b[21C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[31;36H\u001b[38;5;34m·\u001b[39m \u001b[47C\u001b[38;5;34m·\u001b[39m \u001b[47C\u001b[38;5;34m·\u001b[39m \u001b[32;13H\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[24C\u001b[38;5;118m∘\u001b[13C\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m∘\u001b[22C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[44C\u001b[38;5;126m\u001b[48;5;16m◇\u001b[17C\u001b[38;5;47m∘\u001b[33;21H\u001b[49m\u001b[38;5;126m◇\u001b[48C◇\u001b[48C◇\u001b[34;11H\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[C∘\u001b[11C\u001b[38;5;51m∘\u001b[36C\u001b[38;5;48m∘\u001b[C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[30C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[35;19H\u001b[38;5;25m·\u001b[48C·\u001b[48C·\u001b[36;15H\u001b[38;5;45m∘\u001b[3C∘\u001b[3C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[36C\u001b[38;5;51m∘\u001b[C\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[32C\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[38;13H\u001b[38;5;21m∘\u001b[15C\u001b[38;5;57m∘\u001b[30C\u001b[38;5;27m∘\u001b[21C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[38C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b(B\u001b[m"]
