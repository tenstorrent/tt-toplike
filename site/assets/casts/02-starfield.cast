[15.597459, "o", "\u001b[12;11H\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[44C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[24C\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[24C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;124m·\u001b[13C\u001b[38;5;46m∘\u001b[13;19H\u001b[39m \u001b[38;5;124m·\u001b[11C\u001b[39m \u001b[35C \u001b[38;5;124m·\u001b[11C\u001b[39m \u001b[35C \u001b[38;5;124m·\u001b[11C\u001b[39m \u001b[36C \u001b[14;17H\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;106m·\u001b[5C\u001b[38;5;50m∘\u001b[30C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[3C\u001b[38;5;106m·\u001b[3C\u001b[38;5;49m∘\u001b[30C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[5C\u001b[38;5;106m·\u001b[C\u001b[38;5;49m∘\u001b[32C\u001b[38;5;47m∘\u001b[13C\u001b[38;5;49m∘\u001b[38;5;106m·\u001b[6C\u001b[38;5;50m∘\u001b[15;22H\u001b[39m \u001b[38;5;142m◇\u001b[47C\u001b[39m \u001b[38;5;142m◇\u001b[47C\u001b[39m \u001b[38;5;142m◇\u001b[16;15H\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[30C\u001b(B\u001b[m"]
