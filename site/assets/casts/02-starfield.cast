[27.791206, "o", "\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[C○\u001b[C∘\u001b[3C\u001b[38;5;118m∘\u001b[31;18H\u001b[39m \u001b[48C \u001b[48C \u001b[32;17H\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[39m \u001b[6C\u001b[38;5;48m∘\u001b[22C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[10C\u001b[39m \u001b[27C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[12C\u001b[39m \u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[24C\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m∘\u001b[33;15H\u001b[38;5;34m·\u001b[39m \u001b[14C\u001b[38;5;70m◇\u001b[32C\u001b[38;5;34m·\u001b[39m \u001b[14C\u001b[38;5;70m◇\u001b[32C\u001b[38;5;34m·\u001b[39m \u001b[14C\u001b[38;5;70m◇\u001b[34;15H\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[4C\u001b[39m \u001b[25C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[39m \u001b[31C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[2C\u001b[39m \u001b[29C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[3C\u001b[38;5;70m◇\u001b[3C\u001b[38;5;51m∘\u001b[35;34H\u001b[38;5;136m·\u001b[48C·\u001b[48C·\u001b[36;11H\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[30C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[22C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[32C\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[37;28H\u001b[38;5;106m·\u001b[48C·\u001b[48C·\u001b[38;25H\u001b[38;5;57m∘\u001b[13C\u001b[38;5;129m∘\u001b[38C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[22C\u001b[38;5;21m∘\u001b[15C\u001b[38;5;57m∘\u001b[13C\u001b[38;5;129m∘\u001b[18C\u001b[38;5;21m∘\u001b[13C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b(B\u001b[m"]
