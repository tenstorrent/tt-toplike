[3.140248, "o", "\u001b[12;13H\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[30C\u001b[38;5;82m∘\u001b[54C\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m∘\u001b[24C\u001b[38;5;82m∘\u001b[21C\u001b[38;5;47m∘\u001b[13;19H\u001b[38;5;34m·\u001b[11C\u001b[39m \u001b[38;5;37m·\u001b[35C\u001b[38;5;34m·\u001b[11C\u001b[39m \u001b[38;5;37m·\u001b[35C\u001b[38;5;34m·\u001b[11C\u001b[39m \u001b[38;5;37m·\u001b[35C\u001b[38;5;34m·\u001b[11C\u001b[39m \u001b[38;5;37m·\u001b[14;11H\u001b[38;5;48m∘\u001b[6C\u001b[39m \u001b[38;5;49m∘\u001b[5C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[30C\u001b[38;5;48m∘\u001b[2C\u001b[39m \u001b[4C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[29C\u001b[39m \u001b[2C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[32C\u001b[38;5;48m∘\u001b[4C\u001b[39m \u001b[8C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[15;21H\u001b[38;5;25m◇\u001b[48C◇\u001b[48C◇\u001b[48C◇\u001b[16;15H\u001b[38;5;45m∘\u001b[5C∘\u001b[C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[38C\u001b[38;5;45m∘\u001b[5C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[32C\u001b[38;5;45m∘\u001b[C∘\u001b[11C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[24C\u001b[38;5;45m∘\u001b[3C∘\u001b[3C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[17;36H\u001b[39m \u001b[48C \u001b[48C \u001b[48C \u001b[18;13H\u001b[38;5;21m∘\u001b[38;5;70m·\u001b[14C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;25m·\u001b[22C\u001b[38;5;27m∘\u001b[2C\u001b[38;5;70m·\u001b[18C\u001b[38;5;57m∘\u001b[3C\u001b[38;5;25m·\u001b[3C\u001b[38;5;93m∘\u001b[21C\u001b[38;5;70m·\u001b[2C\u001b[38;5;21m∘\u001b[13C\u001b[38;5;57m∘\u001b[5C\u001b[38;5;25m·\u001b[C\u001b[38;5;93m∘\u001b[23C\u001b[38;5;70m·\u001b[38;5;21m∘\u001b[21C\u001b[38;5;25m·\u001b[19;14H\u001b[39m \u001b[48C \u001b[48C \u001b[48C \u001b[20;11H\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[6C\u001b[39m \u001b[38;5;127m◇\u001b[5C\u001b[38;5;200m∘\u001b[22C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[7C\u