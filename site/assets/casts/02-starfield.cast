[3.987284, "o", "\u001b[12;11H\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[22C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[24C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[32C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘\u001b[14;17H∘\u001b[38;5;37m·\u001b[4C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[22C\u001b[38;5;21m∘\u001b[3C∘\u001b[38;5;37m·\u001b[8C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[24C\u001b[38;5;21m∘\u001b[5C∘\u001b[38;5;37m·\u001b[6C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[7C\u001b[38;5;129m∘\u001b[24C\u001b[38;5;21m∘\u001b[38;5;37m·\u001b[6C\u001b[38;5;57m∘\u001b[13C\u001b[38;5;129m∘\u001b[15;27H\u001b[39m \u001b[38;5;25m◇\u001b[47C\u001b[39m \u001b[38;5;25m◇\u001b[47C\u001b[39m \u001b[38;5;25m◇\u001b[47C\u001b[39m \u001b[38;5;25m◇\u001b[16;21H\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[39m \u001b[23C\u001b[38;5;129m∘\u001b[13C\u001b[38;5;201m∘\u001b[10C\u001b[39m \u001b[2C\u001b[38;5;200m∘\u001b[32C\u001b[38;5;201m∘\u001b[12C\u001b[39m \u001b[38;5;200m∘\u001b[26C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[12C\u001b[39m \u001b[38;5;200m∘\u001b[17;36H\u001b[38;5;55m·\u001b[48C·\u001b[48C·\u001b[48C·\u001b[18;11H\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[13C\u001b[38;5;196m∘\u001b[30C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[13C\u001b[38;5;196m∘\u001b[24C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[13C\u001b[38;5;196m∘\u001b[32C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[19;23H\u001b[39m \u001b[38;5;34m◆\u001b[47C\u001b[39m \u001b[38;5;34m◆\u001b[47C\u001b[39m \u001b[38;5;34m◆\u001b[47C\u001b[39m \u001b[38;5;34m◆\u001b[20;17H\u001b[38;5;202m∘\u001b[13C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[30C\u001b[38;5;202m∘\u001b[13C\u001b[38;5;214m∘\u001b[32C\u001b[38;5;202m∘\u001b[13C\u001b[38;5;214m∘\u001b[7C\u001b