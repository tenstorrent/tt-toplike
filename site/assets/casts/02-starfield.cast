[26.95032, "o", "\u001b[12;23H\u001b[38;5;200m∘\u001b[7C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[44C\u001b[38;5;199m∘\u001b[24C\u001b[38;5;201m∘\u001b[21C\u001b[38;5;199m∘\u001b[7C\u001b[38;5;198m∘\u001b[18C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[13C\u001b[38;5;198m∘\u001b[13;166H\u001b[39m \u001b[38;5;36m·\u001b[11C\u001b[39m \u001b[14;21H\u001b[38;5;196m∘\u001b[15C\u001b[38;5;202m∘\u001b[22C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[21C\u001b[38;5;202m∘\u001b[24C\u001b[38;5;197m∘\u001b[21C\u001b[38;5;202m∘\u001b[24C\u001b[38;5;197m∘\u001b[7C\u001b[38;5;196m∘\u001b[9C\u001b[38;5;25m·\u001b[3C\u001b[38;5;202m∘\u001b[15;171H\u001b[39m \u001b[38;5;127m◇\u001b[16;19H\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[38C\u001b[38;5;208m∘\u001b[5C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[24C\u001b[38;5;208m∘\u001b[5C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[24C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[13C\u001b[38;5;226m∘\u001b[17;162H\u001b[38;5;34m·\u001b[18;17H\u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[30C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[38C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[13C\u001b[38;5;82m∘\u001b[21C\u001b[39m \u001b[2C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[3C∘\u001b[19;184H\u001b[38;5;19m·\u001b[20;15H\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[22C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[21C\u001b[38;5;48m∘\u001b[24C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[24C\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m∘\u001b[22;19H\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[13C\u001b[38;5;45m∘\u001b[24C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[32C\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[32C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[23;182H\u001b[39m \u001b[24;17H\u001b[38;5;39m∘\u001b[7C\