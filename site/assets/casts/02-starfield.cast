[12.634258, "o", "\u001b[12;11H\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[3C\u001b[38;5;36m·\u001b[5C\u001b[38;5;46m∘\u001b[38;5;37m·\u001b[10C\u001b[38;5;48m∘\u001b[24C\u001b[38;5;82m∘\u001b[5C\u001b[38;5;36m·\u001b[5C\u001b[38;5;46m∘\u001b[38;5;37m·\u001b[8C\u001b[38;5;47m∘\u001b[30C\u001b[38;5;46m∘\u001b[C\u001b[38;5;36m·\u001b[5C\u001b[38;5;46m∘\u001b[38;5;37m·\u001b[6C\u001b[38;5;47m∘\u001b[24C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[2C\u001b[38;5;36m·\u001b[5C\u001b[39m \n\u001b[38;5;37m·\u001b[14;17H\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[38C\u001b[38;5;48m∘\u001b[5C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[30C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[24C\u001b[38;5;48m∘\u001b[5C∘\u001b[38;5;34m·\u001b[38;5;49m∘\u001b[13C\u001b[38;5;51m∘\u001b[15;175H\u001b[39m \u001b[38;5;25m◇\u001b[16;21H\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[30C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[13C\u001b[38;5;27m∘\u001b[24C\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[32C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[4C\u001b[39m \u001b[2C\u001b[38;5;27m∘\u001b[17;183H\u001b[38;5;25m·\u001b[18;27H\u001b[38;5;57m∘\u001b[5C\u001b[38;5;55m◇\u001b[C\u001b[38;5;93m∘\u001b[30C\u001b[38;5;21m∘\u001b[13C\u001b[38;5;57m∘\u001b[C\u001b[38;5;55m◇\u001b[5C\u001b[38;5;93m∘\u001b[24C\u001b[38;5;21m∘\u001b[13C\u001b[38;5;57m∘\u001b[3C\u001b[38;5;55m◇\u001b[3C\u001b[38;5;93m∘\u001b[40C\u001b[38;5;57m∘\u001b[19;161H\u001b[38;5;70m·\u001b[20;13H·\u001b[3C\u001b[38;5;165m∘\u001b[5C∘\u001b[C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[22C\u001b[38;5;70m·\u001b[C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m∘\u001b[5C\u001b[38;5;201m∘\u001b[32C\u001b[38;5;70m·\u001b[5C\u001b[38;5;165m∘\u001b[3C∘\u001b[3C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[18C\u001b[38;5;129m∘\u001b[C∘\u001b[5C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m○\u001b[6C\u001b[38;