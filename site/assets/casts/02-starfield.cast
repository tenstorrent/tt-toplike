[13.518092, "o", "\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[6C\u001b[38;5;126m·\u001b[38;5;118m∘\u001b[25C\u001b[39m \u001b[12C\u001b[38;5;154m○\u001b[7C\u001b[38;5;118m∘\u001b[39m \u001b[23;185H\u001b[38;5;126m·\u001b[24;11H\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[13C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[22C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[46C∘\u001b[15C\u001b[38;5;47m∘\u001b[24C\u001b[38;5;82m∘\u001b[21C\u001b[38;5;47m∘\u001b[26;62H\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[38C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[32C\u001b[38;5;48m∘\u001b[C\u001b[38;5;34m·\u001b[3C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[27;13H\u001b[38;5;34m·\u001b[48C·\u001b[48C·\u001b[48C\u001b[39m \u001b[21C \u001b[28;13H\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[32C\u001b[38;5;51m∘\u001b[5C\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[20C\u001b[38;5;51m∘\u001b[3C\u001b[38;5;45m∘\u001b[13C\u001b[38;5;33m∘\u001b[7C\u001b[38;5;27m∘\u001b[24C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[3C∘\u001b[7C\u001b[38;5;55m◇\u001b[C\u001b[38;5;27m∘\u001b[30;11H\u001b[38;5;21m∘\u001b[15C\u001b[38;5;57m∘\u001b[13C\u001b[38;5;129m∘\u001b[38C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[24C\u001b[38;5;21m∘\u001b[13C\u001b[38;5;57m∘\u001b[7C\u001b[38;5;93m∘\u001b[32;17H\u001b[38;5;165m∘\u001b[21C\u001b[38;5;200m∘\u001b[30C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[38C\u001b[38;5;165m∘\u001b[7C\u001b[38;5;201m∘\u001b[13C\u001b[38;5;200m∘\u001b[18C\u001b[38;5;129m∘\u001b[7C\u001b[38;5;165m\u001b[48;5;16m∘\u001b[5C\u001b[38;5;201m∘\u001b[33;16H\u001b[49m\u001b[38;5;70m·\u001b[48C·\u001b[48C·\u001b[34;16H\u001b[39m \u001b[4C\u001b[38;5;198m∘\u001b[7C\u001b[38;5;197m∘\u001b[4C\u001b[38;5;124m·\u001b[38;5;197m∘\u001b[24C\u001b[38;5;200m∘\u001b[4C\u001b[39m \u001b[2C\u001b[38;5;199m∘\u001b[13C\u001b[38;5;197m∘\u001b[38;5;124m·\u001b[38;5;1