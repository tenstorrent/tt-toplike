[26.674991, "o", "\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m○\u001b[30C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[38C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[13C\u001b[38;5;190m∘\u001b[19;25H\u001b[39m \u001b[38;5;37m◆\u001b[47C\u001b[39m \u001b[38;5;37m◆\u001b[47C\u001b[39m \u001b[38;5;37m◆\u001b[47C\u001b[39m \u001b[38;5;37m◆\u001b[20;23H\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[30C\u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[24C\u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[7C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[24C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[5C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[21;160H\u001b[38;5;70m·\u001b[22;21H\u001b[38;5;47m∘\u001b[C○\u001b[5C\u001b[38;5;48m○\u001b[30C\u001b[38;5;46m∘\u001b[11C○\u001b[C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[30C\u001b[38;5;47m○\u001b[7C\u001b[38;5;48m∘\u001b[30C\u001b[38;5;46m∘\u001b[2C\u001b[38;5;19m◇\u001b[12C\u001b[38;5;48m∘\u001b[7C\u001b[38;5;49m∘\u001b[23;13H\u001b[38;5;70m·\u001b[48C·\u001b[48C·\u001b[51C\u001b[39m \u001b[24;11H\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[38;5;70m◆\u001b[10C\u001b[38;5;51m∘\u001b[C\u001b[38;5;45m∘\u001b[7C\u001b[38;5;39m∘\u001b[27C\u001b[38;5;70m◆\u001b[2C\u001b[38;5;51m○\u001b[7C∘\u001b[5C\u001b[38;5;45m∘\u001b[24C\u001b[38;5;50m∘\u001b[6C\u001b[38;5;70m◆\u001b[38;5;51m∘\u001b[9C∘\u001b[3C\u001b[38;5;45m∘\u001b[26C\u001b[38;5;50m∘\u001b[6C\u001b[38;5;70m◆\u001b[10C\u001b[38;5;51m∘\u001b[9C\u001b[38;5;39m∘\u001b[25;20H\u001b[39m \u001b[10C\u001b[38;5;91m◆\u001b[37C\u001b[39m \u001b[10C\u001b[38;5;91m◆\u001b[37C\u001b[39m \u001b[10C\u001b[38;5;91m◆\u001b[37C\u001b[39m \u001b[10C\u001b[38;5;91m◆\u001b[26;17H\u001b[38;5;33m∘\u001b[5C\u001b[38;5;27m∘\u001b[7C\u001b[38;5;21m∘\u001b[30C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m○\u001b[13C\u001b[38;5;21m∘\u001b[24C\u001b[38;5;39m∘\u001b[7C\u001b[38;5;33m∘\u001b[13C\u001b[38;5;21m∘