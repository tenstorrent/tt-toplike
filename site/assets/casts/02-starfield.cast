[18.223218, "o", "\u001b[12;15H\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[6C\u001b[39m \u001b[6C\u001b[38;5;226m∘\u001b[30C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[2C\u001b[39m \u001b[10C\u001b[38;5;226m∘\u001b[24C\u001b[38;5;208m∘\u001b[7C\u001b[38;5;214m∘\u001b[4C\u001b[39m \u001b[2C\u001b[38;5;220m∘\u001b[32C\u001b[38;5;208m∘\u001b[5C\u001b[38;5;214m∘\u001b[7C\u001b[38;5;220m∘\u001b[7C\u001b[38;5;226m∘\u001b[13;31H\u001b[38;5;55m·\u001b[48C·\u001b[48C·\u001b[36C\u001b[38;5;31m·\u001b[11C\u001b[39m \u001b[38;5;55m·\u001b[14;17H\u001b[38;5;226m∘\u001b[38;5;31m·\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m○\u001b[7C\u001b[38;5;118m∘\u001b[30C\u001b[38;5;226m∘\u001b[38;5;31m·\u001b[12C\u001b[38;5;154m∘\u001b[7C\u001b[38;5;118m∘\u001b[26C\u001b[38;5;226m∘\u001b[38;5;31m·\u001b[4C\u001b[38;5;190m∘\u001b[13C\u001b[38;5;118m∘\u001b[29C\u001b[39m \u001b[2C\u001b[38;5;190m∘\u001b[7C\u001b[38;5;154m∘\u001b[15;27H\u001b[39m \u001b[38;5;124m◇\u001b[47C\u001b[39m \u001b[38;5;124m◇\u001b[47C\u001b[39m \u001b[38;5;124m◇\u001b[50C\u001b[39m \u001b[16;17H\u001b[38;5;46m∘\u001b[15C\u001b[38;5;47m∘\u001b[2C\u001b[39m \u001b[33C\u001b[38;5;46m∘\u001b[14C\u001b[39m \u001b[38;5;47m∘\u001b[24C\u001b[38;5;82m∘\u001b[21C\u001b[38;5;47m∘\u001b[39m \u001b[23C\u001b[38;5;82m∘\u001b[7C\u001b[38;5;46m∘\u001b[10C\u001b[38;5;124m◇\u001b[2C\u001b[38;5;47m∘\u001b[7C\u001b[38;5;48m∘\u001b[17;36H\u001b[38;5;91m·\u001b[48C·\u001b[48C·\u001b[48C\u001b[39m \u001b[18;15H\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[44C\u001b[38;5;49m∘\u001b[7C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[24C\u001b[38;5;48m∘\u001b[13C\u001b[38;5;50m∘\u001b[7C\u001b[38;5;51m∘\u001b[29C\u001b[38;5;36m·\u001b[2C\u001b[38;5;49m∘\u001b[11C\u001b[38;5;50m∘\u001b[C\u001b[38;5;51m∘\u001b[5C\u001b[38;5;91m·\u001b[19;14H\u001b[38;5;36m·\u001b[7C\u001b[38;5;70m◆\u001b[40C\u001b[38;5;36m·\u001b[7C\u001b[38;5;70m◆\u001b[40C\u001b[38;5;36m·\u001b[7C\u001b[38;5;70m◆\u001b[40C\u001b[39m \u001b[7C\u001b[38;5;70m◆\u001b[2