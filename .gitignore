# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Cargo lock for libraries (keep for binaries)
# Cargo.lock is kept for this project since it's a binary

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Local configuration
.claude/settings.local.json

# Debian packaging build artifacts (generated by dpkg-buildpackage)
debian/.cargo/
debian/.debhelper/
debian/target/
debian/tmp/
debian/debhelper-build-stamp
debian/files
debian/*.debhelper.log
debian/*.substvars
debian/tt-toplike/
debian/tt-toplike-app/
debian/tt-toplike-egui/

# Generated by build-deb.sh — do not commit
# vendor/ is NOT committed (it was until v0.7.18 — 1.1 GB / 35k files made
# clones hostile). build-deb.sh regenerates it via `cargo vendor` for offline
# .deb builds; --quick reuses a locally-present copy.
/vendor/
# .cargo/config.toml is written fresh each build to point at vendor/
.cargo/config.toml
.cargo/*.bak

# Stray local git worktrees / build outputs left under .claude/ by prior
# sessions — never repo content, easy to catch in a `git add -A`.
.claude/worktrees/

# Debug and log files
*.log
/debug/
tmp/

# System files
Thumbs.db
.Spotlight-V100
.Trashes

# Superpowers scratch (SDD ledgers, brainstorm sessions, review diffs) — local only
.superpowers/
